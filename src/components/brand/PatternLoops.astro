---
interface Props {
  color?: string;
  opacity?: number;
  class?: string;
}

const { color = 'var(--color-cyan)', opacity = 0.08, class: className = '' } = Astro.props;
---

<div class={`pattern-loops-wrapper ${className}`} aria-hidden="true">
  <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id="brandLoops" x="0" y="0" width="60" height="40" patternUnits="userSpaceOnUse">
        <!-- Bucles continuos entrelazados tipo cinta -->
        <path 
          d="M0 20 C10 5, 20 5, 30 20 C40 35, 50 35, 60 20" 
          stroke={color} 
          stroke-width="3.5" 
          fill="none" 
          stroke-linecap="round"
        />
        <path 
          d="M0 35 C10 20, 20 20, 30 35 C40 50, 50 50, 60 35" 
          stroke={color} 
          stroke-width="2.5" 
          fill="none" 
          stroke-linecap="round"
        />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#brandLoops)" opacity={opacity} />
  </svg>
</div>

<style>
  .pattern-loops-wrapper {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
</style>
