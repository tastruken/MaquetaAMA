---
// src/components/features/BentoOfferings.astro
// Grilla Bento de atributos y servicios estilo Aurvix (What we offer)
---

<section class="section bento-offerings-section">
  <div class="container">
    <div class="section-header text-center">
      <span class="pill-tag pill-tag-white">El Estándar AMA</span>
      <h2 class="section-title">Diseñado para elevar tu calidad de vida</h2>
      <p class="section-desc">
        Más que metros cuadrados: una propuesta integral de diseño, respaldo financiero y plusvalía garantizada.
      </p>
    </div>

    <div class="bento-offerings-grid">
      <!-- Card 1 -->
      <div class="offering-card bento-card">
        <div class="offering-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
        </div>
        <h3 class="offering-title">Tu Nuevo Hogar</h3>
        <p class="offering-desc">
          Tipologías 1D, 2D y 3D pensadas para optimizar el espacio con luz natural y terminaciones nobles.
        </p>
        <span class="offering-badge">Desde 2.390 UF</span>
      </div>

      <!-- Card 2 -->
      <div class="offering-card bento-card">
        <div class="offering-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="5" width="20" height="14" rx="2"></rect>
            <line x1="2" y1="10" x2="22" y2="10"></line>
          </svg>
        </div>
        <h3 class="offering-title">Bono Pie 10%</h3>
        <p class="offering-desc">
          Paga tu pie en hasta 36 cuotas sin interés durante la etapa de construcción en blanco.
        </p>
        <span class="offering-badge highlight">36 Cuotas</span>
      </div>

      <!-- Card 3 -->
      <div class="offering-card bento-card">
        <div class="offering-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
        </div>
        <h3 class="offering-title">Gestión Bancaria 100%</h3>
        <p class="offering-desc">
          Evaluamos y tramitamos tu crédito hipotecario con tasas preferenciales en los principales bancos.
        </p>
        <span class="offering-badge">Sin Costo</span>
      </div>

      <!-- Card 4 -->
      <div class="offering-card bento-card">
        <div class="offering-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
            <path d="M2 12h20"></path>
          </svg>
        </div>
        <h3 class="offering-title">Eficiencia y Termopanel</h3>
        <p class="offering-desc">
          Ventanas de doble vidriado hermético que aíslan ruidos urbanos y reducen hasta un 40% el gasto térmico.
        </p>
        <span class="offering-badge">Aislamiento Acústico</span>
      </div>

      <!-- Card 5 -->
      <div class="offering-card bento-card">
        <div class="offering-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="20" x2="18" y2="10"></line>
            <line x1="12" y1="20" x2="12" y2="4"></line>
            <line x1="6" y1="20" x2="6" y2="14"></line>
          </svg>
        </div>
        <h3 class="offering-title">Plusvalía & Rentabilidad</h3>
        <p class="offering-desc">
          Ubicaciones con alta demanda de arriendo y plusvalía sostenida a pasos del Metro Los Quillayes.
        </p>
        <span class="offering-badge highlight">+15% Plusvalía Proyectada</span>
      </div>

      <!-- Card 6 -->
      <div class="offering-card bento-card">
        <div class="offering-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <h3 class="offering-title">Postventa Digital y Garantía</h3>
        <p class="offering-desc">
          Plataforma web con trazabilidad en vivo de requerimientos y respaldo legal de hasta 10 años.
        </p>
        <span class="offering-badge">Garantía Ley</span>
      </div>
    </div>
  </div>
</section>

<style>
  .bento-offerings-section {
    background: #FFFFFF;
    padding: 6rem 0;
  }

  .bento-offerings-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.8rem;
  }

  .offering-card {
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    position: relative;
    background: #FAFAFA;
    border: 1px solid rgba(var(--rgb-petrol), 0.06);
    transition: all var(--transition-elastic);
  }

  .offering-card:hover {
    background: #FFFFFF;
    transform: translateY(-6px);
    box-shadow: 0 20px 40px -10px rgba(0, 45, 64, 0.12);
    border-color: rgba(var(--rgb-cyan), 0.35);
  }

  .offering-icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #FFFFFF;
    color: var(--color-cyan);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(var(--rgb-petrol), 0.06);
    transition: all var(--transition-fast);
  }

  .offering-card:hover .offering-icon {
    background: var(--color-petrol);
    color: #FFFFFF;
    transform: scale(1.05);
  }

  .offering-title {
    font-size: 1.3rem;
    font-weight: var(--font-weight-heavy);
    color: var(--color-petrol);
    margin-top: 0.2rem;
  }

  .offering-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
    flex-grow: 1;
  }

  .offering-badge {
    font-size: 0.76rem;
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
    background: rgba(var(--rgb-petrol), 0.06);
    color: var(--color-petrol);
    margin-top: 0.5rem;
  }

  .offering-badge.highlight {
    background: rgba(var(--rgb-coral), 0.12);
    color: var(--color-coral);
  }

  @media (max-width: 992px) {
    .bento-offerings-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .bento-offerings-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
