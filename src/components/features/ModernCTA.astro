---
// src/components/features/ModernCTA.astro
// Banner de cierre de alta conversión con estética arquitectónica y ambientación nocturna estilo Aurvix
---

<section class="modern-cta-section">
  <div class="container">
    <div class="cta-banner-card">
      <div class="cta-backdrop-img"></div>
      <div class="cta-overlay"></div>
      
      <div class="cta-content">
        <span class="pill-tag pill-tag-white">Showroom & Asesoría</span>
        <h2 class="cta-title">¿Listo para dar el paso hacia tu nuevo departamento?</h2>
        <p class="cta-text">
          Visita nuestra sala de ventas en La Florida, conoce el departamento piloto o simula tu crédito hipotecario con asesoría personalizada sin costo.
        </p>
        
        <div class="cta-actions">
          <button 
            type="button" 
            class="btn btn-pill-white"
            onclick="window.openCotizadorModal && window.openCotizadorModal()"
          >
            Simular y Cotizar Online
            <span class="arrow-icon">↗</span>
          </button>
          
          <a 
            href="https://wa.me/56912345678?text=Hola%20AMA%20Inmobiliaria,%20deseo%20información%20sobre%20AMA%20Quillayes" 
            target="_blank" 
            rel="noopener noreferrer"
            class="btn btn-pill-outline-white"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"></path>
            </svg>
            Escribir por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .modern-cta-section {
    padding: 6rem 0 7rem;
    background: var(--bg-canvas);
  }

  .cta-banner-card {
    position: relative;
    border-radius: var(--radius-bento-lg, 32px);
    overflow: hidden;
    padding: 5.5rem 4rem;
    background-color: var(--color-petrol);
    box-shadow: 0 24px 60px -15px rgba(0, 45, 64, 0.35);
  }

  .cta-backdrop-img {
    position: absolute;
    inset: 0;
    background-image: url('../../../public/images/ama_quillayes_facade.jpg');
    background-size: cover;
    background-position: center 35%;
    opacity: 0.28;
    filter: saturate(1.2);
  }

  .cta-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top right, rgba(var(--rgb-cyan), 0.35) 0%, transparent 60%),
                linear-gradient(135deg, rgba(var(--rgb-petrol), 0.96) 0%, rgba(var(--rgb-petrol), 0.85) 100%);
  }

  .cta-content {
    position: relative;
    z-index: 2;
    max-width: 680px;
  }

  .cta-title {
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    color: var(--color-cream);
    line-height: 1.12;
    font-weight: var(--font-weight-heavy);
    margin: 1.4rem 0 1.2rem;
    letter-spacing: -0.03em;
  }

  .cta-text {
    font-size: 1.1rem;
    color: var(--text-on-dark-muted);
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .btn-pill-white {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.95rem 2rem;
    border-radius: var(--radius-full);
    background: #FFFFFF;
    color: var(--color-petrol);
    font-size: 1rem;
    font-weight: var(--font-weight-heavy);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    transition: all var(--transition-fast);
  }

  .btn-pill-white:hover {
    background: var(--color-cyan);
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(var(--rgb-cyan), 0.4);
  }

  .arrow-icon {
    font-size: 1.2rem;
    line-height: 1;
    transition: transform var(--transition-fast);
  }

  .btn-pill-white:hover .arrow-icon {
    transform: translate(2px, -2px);
  }

  .btn-pill-outline-white {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.95rem 1.8rem;
    border-radius: var(--radius-full);
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(8px);
    color: #FFFFFF;
    font-size: 0.98rem;
    font-weight: var(--font-weight-semibold);
    transition: all var(--transition-fast);
  }

  .btn-pill-outline-white:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: #FFFFFF;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .cta-banner-card {
      padding: 3.5rem 1.75rem;
    }
  }
</style>
