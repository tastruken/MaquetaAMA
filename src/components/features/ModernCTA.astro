---
// src/components/features/ModernCTA.astro
// Banner CTA de alta conversión para Showroom & Asesoría (ama-quillayes)
import { u } from '../../utils/url';

interface Props {
  badge?: string;
  title?: string;
  subtitle?: string;
  primaryBtnText?: string;
  whatsappBtnText?: string;
  whatsappMessage?: string;
  phone?: string;
}

const {
  badge = 'Showroom & Asesoría',
  title = '¿Listo para dar el paso hacia tu nuevo departamento?',
  subtitle = 'Visita nuestra sala de ventas en La Florida, conoce el departamento piloto o simula tu crédito hipotecario con asesoría personalizada sin costo.',
  primaryBtnText = 'Simular y Cotizar Online',
  whatsappBtnText = 'Escribir por WhatsApp',
  whatsappMessage = 'Hola, me gustaría agendar una visita al Showroom y conocer el departamento piloto de AMA Quillayes.',
  phone = '56987654321'
} = Astro.props;

const whatsappUrl = `https://wa.me/${phone}?text=${encodeURIComponent(whatsappMessage)}`;
---

<section class="modern-cta-section" id="showroom-asesoria">
  <div class="container">
    <div class="cta-banner-card">
      <img 
        src={u('/images/ama_quillayes_facade.jpg')} 
        alt="Edificio AMA Quillayes - Showroom y Asesoría" 
        class="cta-backdrop-img" 
        loading="lazy" 
      />
      <div class="cta-dark-overlay"></div>
      
      <div class="cta-content-col">
        <h2 class="cta-title">
          ¿Listo para dar el paso<br class="title-break-desktop" />
          hacia tu nuevo<br class="title-break-desktop" />
          departamento?
        </h2>
        
        <p class="cta-subtitle">
          {subtitle}
        </p>

        <div class="cta-buttons-row">
          <button 
            type="button" 
            class="btn-cta-primary"
            onclick="if (window.openCotizadorModal) { window.openCotizadorModal(); } else { const el = document.getElementById('cotizador-quillayes'); if (el) el.scrollIntoView({ behavior: 'smooth' }); }"
            aria-label="Simular y cotizar departamento online"
          >
            <span>{primaryBtnText}</span>
            <span class="cta-arrow-icon" aria-hidden="true">↗</span>
          </button>

          <a 
            href={whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-cta-whatsapp"
            aria-label="Escribir por WhatsApp a asesor de ventas"
          >
            <span class="whatsapp-circle-icon" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.947.814 2.8.814 3.181 0 5.767-2.586 5.768-5.766 0-3.18-2.586-5.766-5.772-5.766zm3.376 8.21c-.14.394-.805.748-1.127.794-.306.044-.707.067-2.038-.484-1.603-.665-2.617-2.316-2.696-2.423-.079-.107-.649-.864-.649-1.647 0-.783.41-1.168.556-1.328.146-.16.321-.2.428-.2.107 0 .214.002.308.006.1.005.234-.038.366.279.136.328.465 1.135.505 1.218.041.082.068.179.014.288-.055.107-.082.175-.164.27-.082.096-.173.214-.247.288-.082.083-.168.172-.072.337.096.164.428.706.918 1.142.631.562 1.164.737 1.328.819.164.082.261.069.358-.041.097-.11.41-.479.52-.644.11-.164.22-.137.369-.082.15.055.952.449 1.116.531.164.082.273.123.314.192.041.069.041.401-.099.795zM12 2C6.477 2 2 6.477 2 12c0 1.891.526 3.66 1.439 5.174L2 22l4.98-1.306C8.423 21.523 10.15 22 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
              </svg>
            </span>
            <span>{whatsappBtnText}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .modern-cta-section {
    padding: 3rem 0 5.5rem;
    background: #FFFFFF;
  }

  .cta-banner-card {
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    padding: 4.8rem 4.5rem;
    background-color: #081622;
    box-shadow: 0 20px 50px -15px rgba(0, 0, 0, 0.35);
    min-height: 420px;
    display: flex;
    align-items: center;
  }

  .cta-backdrop-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 75% 70%;
    z-index: 1;
    filter: brightness(0.6) contrast(1.1) saturate(0.9);
  }

  .cta-dark-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg, 
      rgba(8, 22, 32, 0.98) 0%, 
      rgba(8, 22, 32, 0.94) 48%, 
      rgba(8, 22, 32, 0.60) 80%,
      rgba(8, 22, 32, 0.35) 100%
    );
    z-index: 2;
  }

  .cta-content-col {
    position: relative;
    z-index: 3;
    max-width: 650px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .cta-glass-pill {
    display: inline-block;
    padding: 0.45rem 1.25rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.28);
    color: #FFFFFF;
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 1.75rem;
  }

  .cta-title {
    font-size: clamp(2.2rem, 4.2vw, 3.6rem);
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.14;
    letter-spacing: -0.03em;
    margin: 0 0 1.35rem;
  }

  .title-break-desktop {
    display: inline;
  }

  .cta-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.6;
    margin: 0 0 2.2rem;
    max-width: 580px;
  }

  .cta-buttons-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.1rem;
  }

  /* BOTÓN 1: BLANCO PILL */
  .btn-cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.9rem 1.85rem;
    border-radius: 9999px;
    background: #FFFFFF;
    color: #0F172A;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    border: none;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
    transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    text-decoration: none;
  }

  .btn-cta-primary:hover {
    background: #F3F4F6;
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.35);
  }

  .cta-arrow-icon {
    font-size: 1.05rem;
    line-height: 1;
    font-weight: 700;
    transition: transform 0.2s ease;
  }

  .btn-cta-primary:hover .cta-arrow-icon {
    transform: translate(2px, -2px);
  }

  /* BOTÓN 2: GLASS OSCURO CON WHATSAPP */
  .btn-cta-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 1.75rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.24);
    color: #FFFFFF;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }

  .btn-cta-whatsapp:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-2px);
    color: #FFFFFF;
  }

  .whatsapp-circle-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    color: #FFFFFF;
    transition: background 0.2s ease;
  }

  .btn-cta-whatsapp:hover .whatsapp-circle-icon {
    background: #25D366;
    color: #FFFFFF;
  }

  @media (max-width: 900px) {
    .cta-banner-card {
      padding: 3.5rem 2.2rem;
    }

    .cta-title {
      font-size: clamp(1.9rem, 6vw, 2.6rem);
    }

    .title-break-desktop {
      display: none;
    }

    .cta-buttons-row {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      gap: 0.85rem;
    }

    .btn-cta-primary,
    .btn-cta-whatsapp {
      justify-content: center;
      width: 100%;
    }
  }
</style>

