---
// src/components/features/HeroFilterBar.astro
// Barra de búsqueda y filtrado interactivo flotante estilo Aurvix Framer
---

<div class="hero-filter-bar glass-card">
  <!-- Pestañas de propósito -->
  <div class="filter-tabs">
    <button type="button" class="tab-btn active" data-purpose="vivir">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        <polyline points="9 22 9 12 15 12 15 22"></polyline>
      </svg>
      Para Vivir
    </button>
    <button type="button" class="tab-btn" data-purpose="invertir">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="1" x2="12" y2="23"></line>
        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
      </svg>
      Para Invertir
    </button>
    <button type="button" class="tab-btn" data-purpose="blanco">
      <span class="pulse-indicator"></span>
      Compra en Blanco
    </button>
  </div>

  <!-- Formulario de Campos de Filtrado -->
  <form class="filter-inputs-grid" id="hero-quick-filter" onsubmit="event.preventDefault(); window.location.href='/proyectos/ama-quillayes';">
    <div class="filter-field">
      <label for="filter-location">Ubicación</label>
      <div class="select-wrapper">
        <svg class="field-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <select id="filter-location" name="location">
          <option value="la-florida">La Florida (Metro Los Quillayes)</option>
          <option value="santiago">Santiago Centro</option>
          <option value="todos">Todas las comunas</option>
        </select>
      </div>
    </div>

    <div class="filter-divider"></div>

    <div class="filter-field">
      <label for="filter-typology">Tipología</label>
      <div class="select-wrapper">
        <svg class="field-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 7h18M3 12h18M3 17h18"></path>
        </svg>
        <select id="filter-typology" name="typology">
          <option value="todos">1, 2 y 3 Dormitorios</option>
          <option value="1d">1 Dormitorio (Inversión)</option>
          <option value="2d">2 Dormitorios (Familiar)</option>
          <option value="3d">3 Dormitorios (Espacio)</option>
        </select>
      </div>
    </div>

    <div class="filter-divider"></div>

    <div class="filter-field">
      <label for="filter-price">Rango Precio UF</label>
      <div class="select-wrapper">
        <svg class="field-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 6v12M15 9.5a3.5 3.5 0 0 0-7 0c0 2 2 3 7 4s7 2 7 4a3.5 3.5 0 0 1-7 0"></path>
        </svg>
        <select id="filter-price" name="price">
          <option value="desde-2390">Desde 2.390 UF</option>
          <option value="2390-3000">2.390 - 3.000 UF</option>
          <option value="3000-mas">Más de 3.000 UF</option>
        </select>
      </div>
    </div>

    <!-- Botón de Búsqueda -->
    <div class="filter-action">
      <button type="submit" class="btn-search" aria-label="Buscar departamentos">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span>Explorar</span>
      </button>
    </div>
  </form>
</div>

<style>
  .hero-filter-bar {
    width: 100%;
    max-width: 980px;
    margin: 2.2rem auto 0;
    padding: 0.8rem 1rem 1rem;
    border-radius: var(--radius-bento);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    box-shadow: 0 20px 48px -10px rgba(0, 45, 64, 0.22);
    position: relative;
    z-index: 10;
  }

  .filter-tabs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.75rem;
    margin-bottom: 0.6rem;
    border-bottom: 1px solid rgba(var(--rgb-petrol), 0.08);
  }

  .tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-full);
    font-size: 0.84rem;
    font-weight: var(--font-weight-semibold);
    color: var(--text-muted);
    background: transparent;
    transition: all var(--transition-fast);
  }

  .tab-btn:hover {
    color: var(--color-petrol);
    background: rgba(var(--rgb-petrol), 0.05);
  }

  .tab-btn.active {
    background: var(--color-petrol);
    color: #FFFFFF;
    box-shadow: 0 2px 8px rgba(var(--rgb-petrol), 0.25);
  }

  .pulse-indicator {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-coral);
    box-shadow: 0 0 0 0 rgba(var(--rgb-coral), 0.7);
    animation: pulse 1.8s infinite;
  }

  @keyframes pulse {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(var(--rgb-coral), 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 6px rgba(var(--rgb-coral), 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(var(--rgb-coral), 0);
    }
  }

  .filter-inputs-grid {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .filter-field {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .filter-field label {
    font-size: 0.72rem;
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-soft);
  }

  .select-wrapper {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .field-icon {
    color: var(--color-cyan);
    flex-shrink: 0;
  }

  .select-wrapper select {
    width: 100%;
    border: none;
    background: transparent;
    font-family: inherit;
    font-size: 0.92rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-petrol);
    cursor: pointer;
    outline: none;
  }

  .filter-divider {
    width: 1px;
    height: 38px;
    background: rgba(var(--rgb-petrol), 0.1);
  }

  .filter-action {
    flex-shrink: 0;
  }

  .btn-search {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.6rem;
    border-radius: var(--radius-full);
    background: var(--color-cyan);
    color: #FFFFFF;
    font-weight: var(--font-weight-semibold);
    font-size: 0.95rem;
    box-shadow: 0 4px 16px rgba(var(--rgb-cyan), 0.35);
    transition: all var(--transition-fast);
  }

  .btn-search:hover {
    background: #148d9c;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(var(--rgb-cyan), 0.45);
  }

  @media (max-width: 900px) {
    .filter-inputs-grid {
      flex-direction: column;
      align-items: stretch;
      gap: 0.8rem;
    }

    .filter-divider {
      display: none;
    }

    .btn-search {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  const tabs = document.querySelectorAll('.hero-filter-bar .tab-btn');
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
    });
  });
</script>
