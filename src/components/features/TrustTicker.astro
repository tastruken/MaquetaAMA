---
// src/components/features/TrustTicker.astro
// Cinta institucional de confianza y alianzas bancarias estilo Framer
---

<div class="trust-ticker-section">
  <div class="container">
    <div class="trust-inner">
      <span class="trust-label">Alianzas crediticias y respaldo legal</span>
      <div class="trust-logos">
        <div class="trust-badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 21h18M3 10h18M5 10v11M19 10v11M9 10v11M15 10v11M12 2L2 7h20L12 2z"></path>
          </svg>
          <span>Banco de Chile</span>
        </div>
        <div class="trust-badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="5" width="20" height="14" rx="2"></rect>
            <line x1="2" y1="10" x2="22" y2="10"></line>
          </svg>
          <span>Santander</span>
        </div>
        <div class="trust-badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <span>BCI Hipotecario</span>
        </div>
        <div class="trust-badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 21h18M3 10h18M5 10v11M19 10v11M9 10v11M15 10v11M12 2L2 7h20L12 2z"></path>
          </svg>
          <span>BancoEstado</span>
        </div>
        <div class="trust-badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01"></path>
          </svg>
          <span>Socio CChC</span>
        </div>
        <div class="trust-badge highlight">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <path d="M9 12l2 2 4-4"></path>
          </svg>
          <span>Garantía Ley 10 Años</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .trust-ticker-section {
    padding: 1.75rem 0;
    background: #FFFFFF;
    border-bottom: 1px solid rgba(var(--rgb-petrol), 0.06);
  }

  .trust-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .trust-label {
    font-size: 0.78rem;
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-soft);
    white-space: nowrap;
  }

  .trust-logos {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .trust-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    font-weight: var(--font-weight-semibold);
    color: var(--text-muted);
    transition: all var(--transition-fast);
  }

  .trust-badge svg {
    color: var(--color-cyan);
    opacity: 0.8;
  }

  .trust-badge:hover {
    color: var(--color-petrol);
    transform: translateY(-1px);
  }

  .trust-badge.highlight {
    color: var(--color-petrol);
    background: rgba(var(--rgb-cyan), 0.08);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
  }

  @media (max-width: 992px) {
    .trust-inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1rem;
    }
    .trust-logos {
      justify-content: center;
      gap: 1.25rem;
    }
  }
</style>
