---
// src/components/features/AdvisorQuoteCTA.astro
// Sección de Cotización con Formulario a la izquierda y Fotografía de la Ejecutiva unificada a la derecha
import { u } from '../../utils/url';

interface Props {
  phone?: string;
}

const { phone = '56987654321' } = Astro.props;
const whatsappUrl = `https://wa.me/${phone}?text=${encodeURIComponent('Hola Camila, me gustaría cotizar un departamento en AMA Quillayes y recibir asesoría sobre el financiamiento.')}`;
---

<section class="advisor-cta-section" id="cotizar-asesor">
  <div class="container">
    <div class="advisor-split-card">
      
      <!-- COLUMNA IZQUIERDA: FORMULARIO DE COTIZACIÓN -->
      <div class="advisor-form-col">
        <div class="form-header">
          <span class="advisor-kicker">Atención Personalizada · AMA Quillayes</span>
          <h2 class="form-title">Cotiza tu departamento con un asesor</h2>
          <p class="form-subtitle">
            Recibe la cotización formal con lista de precios oficial, opciones de pie en cuotas sin interés y beneficios comerciales vigentes.
          </p>
        </div>

        <form class="advisor-form" id="advisor-quote-form">
          <div class="form-field">
            <label class="form-label" for="aq-name">Nombre y Apellido *</label>
            <input 
              type="text" 
              id="aq-name" 
              name="name" 
              required 
              placeholder="Ej: Ignacio Morales" 
              class="form-input" 
            />
          </div>

          <div class="form-row-two">
            <div class="form-field">
              <label class="form-label" for="aq-email">Correo Electrónico *</label>
              <input 
                type="email" 
                id="aq-email" 
                name="email" 
                required 
                placeholder="tu@correo.cl" 
                class="form-input" 
              />
            </div>
            <div class="form-field">
              <label class="form-label" for="aq-phone">Teléfono / WhatsApp *</label>
              <input 
                type="tel" 
                id="aq-phone" 
                name="phone" 
                required 
                placeholder="+56 9 1234 5678" 
                class="form-input" 
              />
            </div>
          </div>

          <div class="form-field">
            <label class="form-label" for="aq-tipologia">Tipología de Interés</label>
            <select id="aq-tipologia" name="tipologia" class="form-select">
              <option value="Modelo 1D + 1B (Desde 2.540 UF)">Modelo 1D + 1B · Desde 2.540 UF (Ideal Renta)</option>
              <option value="Modelo 2D + 1B (Desde 3.190 UF)">Modelo 2D + 1B · Desde 3.190 UF (Home Office)</option>
              <option value="Modelo 2D + 2B Mariposa (Desde 3.750 UF)">Modelo 2D + 2B Mariposa · Desde 3.750 UF (Doble Suite)</option>
              <option value="Cualquiera / Asesoría Integral">No estoy seguro / Busco asesoría para elegir</option>
            </select>
          </div>

          <!-- BOTONES LADO A LADO -->
          <div class="form-actions-wrap">
            <button type="submit" class="btn-submit-quote">
              <span>Solicitar Cotización Oficial</span>
              <span class="btn-arrow" aria-hidden="true">↗</span>
            </button>

            <a 
              href={whatsappUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn-whatsapp-quote"
              aria-label="Hablar directo por WhatsApp con Camila"
            >
              <span class="wa-icon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.947.814 2.8.814 3.181 0 5.767-2.586 5.768-5.766 0-3.18-2.586-5.766-5.772-5.766zm3.376 8.21c-.14.394-.805.748-1.127.794-.306.044-.707.067-2.038-.484-1.603-.665-2.617-2.316-2.696-2.423-.079-.107-.649-.864-.649-1.647 0-.783.41-1.168.556-1.328.146-.16.321-.2.428-.2.107 0 .214.002.308.006.1.005.234-.038.366.279.136.328.465 1.135.505 1.218.041.082.068.179.014.288-.055.107-.082.175-.164.27-.082.096-.173.214-.247.288-.082.083-.168.172-.072.337.096.164.428.706.918 1.142.631.562 1.164.737 1.328.819.164.082.261.069.358-.041.097-.11.41-.479.52-.644.11-.164.22-.137.369-.082.15.055.952.449 1.116.531.164.082.273.123.314.192.041.069.041.401-.099.795zM12 2C6.477 2 2 6.477 2 12c0 1.891.526 3.66 1.439 5.174L2 22l4.98-1.306C8.423 21.523 10.15 22 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
                </svg>
              </span>
              <span>Chatear por WhatsApp</span>
            </a>
          </div>

          <div id="aq-success" class="quote-success-banner" style="display: none;">
            <strong>✓ ¡Solicitud recibida con éxito!</strong>
            <p>Camila Morales se comunicará contigo al teléfono y correo ingresados para entregarte la cotización formal y asesorarte en tu financiamiento.</p>
          </div>
        </form>
      </div>

      <!-- COLUMNA DERECHA: FOTOGRAFÍA DE LA EJECUTIVA UNIFICADA A LOS BORDES -->
      <div class="advisor-visual-col">
        <img 
          src={u('/images/asesor_comercial_quillayes.jpg')} 
          alt="Camila Morales - Asesora Comercial AMA Quillayes" 
          class="advisor-cover-img" 
          loading="lazy" 
        />
        <div class="advisor-overlay-gradient"></div>

        <!-- Barra inferior unificada a los bordes de la tarjeta -->
        <div class="advisor-unified-footer">
          <p class="advisor-quote-text">
            “Te acompaño a revisar las opciones de financiamiento, simular tu crédito y ordenar tus cuotas de pie con total transparencia.”
          </p>
          <div class="advisor-meta-row">
            <div>
              <h3 class="advisor-full-name">Camila Morales</h3>
              <span class="advisor-job-title">Asesora Comercial · AMA Quillayes</span>
            </div>
            <a 
              href={whatsappUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="advisor-wa-pill"
              title="Abrir WhatsApp directo con Camila"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.947.814 2.8.814 3.181 0 5.767-2.586 5.768-5.766 0-3.18-2.586-5.766-5.772-5.766zm3.376 8.21c-.14.394-.805.748-1.127.794-.306.044-.707.067-2.038-.484-1.603-.665-2.617-2.316-2.696-2.423-.079-.107-.649-.864-.649-1.647 0-.783.41-1.168.556-1.328.146-.16.321-.2.428-.2.107 0 .214.002.308.006.1.005.234-.038.366.279.136.328.465 1.135.505 1.218.041.082.068.179.014.288-.055.107-.082.175-.164.27-.082.096-.173.214-.247.288-.082.083-.168.172-.072.337.096.164.428.706.918 1.142.631.562 1.164.737 1.328.819.164.082.261.069.358-.041.097-.11.41-.479.52-.644.11-.164.22-.137.369-.082.15.055.952.449 1.116.531.164.082.273.123.314.192.041.069.041.401-.099.795zM12 2C6.477 2 2 6.477 2 12c0 1.891.526 3.66 1.439 5.174L2 22l4.98-1.306C8.423 21.523 10.15 22 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const quoteForm = document.getElementById('advisor-quote-form') as HTMLFormElement | null;
  const quoteSuccess = document.getElementById('aq-success');

  if (quoteForm && quoteSuccess) {
    quoteForm.addEventListener('submit', (e) => {
      e.preventDefault();
      quoteSuccess.style.display = 'block';
      quoteForm.reset();
      quoteSuccess.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  }
</script>

<style>
  .advisor-cta-section {
    padding: 5rem 0 6rem;
    background: #FFFFFF;
  }

  .advisor-split-card {
    display: grid;
    grid-template-columns: 1.22fr 1fr;
    background: #FFFFFF;
    border-radius: 28px;
    border: 1px solid rgba(15, 23, 42, 0.09);
    box-shadow: 0 24px 54px -12px rgba(15, 23, 42, 0.1);
    overflow: hidden;
    align-items: stretch;
  }

  /* COLUMNA FORMULARIO */
  .advisor-form-col {
    padding: 3.8rem 3.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #FFFFFF;
  }

  .form-header {
    margin-bottom: 2rem;
  }

  .advisor-kicker {
    display: inline-block;
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #1AA6B7;
    margin-bottom: 0.65rem;
  }

  .form-title {
    font-size: clamp(1.9rem, 2.7vw, 2.5rem);
    font-weight: 800;
    color: #0F172A;
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin: 0 0 0.85rem;
  }

  .form-subtitle {
    font-size: 0.96rem;
    color: #64748B;
    line-height: 1.6;
    margin: 0;
  }

  .advisor-form {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .form-row-two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.15rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-label {
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #475569;
  }

  .form-input,
  .form-select {
    width: 100%;
    font-family: inherit;
    font-size: 0.95rem;
    color: #0F172A;
    background: #F8FAFC;
    border: 1px solid rgba(15, 23, 42, 0.12);
    border-radius: 14px;
    padding: 0.88rem 1.1rem;
    transition: all 0.2s ease;
  }

  .form-input:focus,
  .form-select:focus {
    outline: none;
    background: #FFFFFF;
    border-color: #1AA6B7;
    box-shadow: 0 0 0 4px rgba(26, 166, 183, 0.12);
  }

  /* BOTONES LADO A LADO */
  .form-actions-wrap {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.85rem;
    margin-top: 0.85rem;
  }

  .btn-submit-quote {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.9rem 1.55rem;
    border-radius: 9999px;
    background: #0F172A;
    color: #FFFFFF;
    font-weight: 700;
    font-size: 0.92rem;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.2);
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .btn-submit-quote:hover {
    background: #1AA6B7;
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(26, 166, 183, 0.28);
  }

  .btn-arrow {
    font-size: 1.05rem;
    font-weight: 700;
    transition: transform 0.2s ease;
  }

  .btn-submit-quote:hover .btn-arrow {
    transform: translate(2px, -2px);
  }

  .btn-whatsapp-quote {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.88rem 1.45rem;
    border-radius: 9999px;
    background: #FFFFFF;
    color: #0F172A !important;
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
    border: 1px solid rgba(15, 23, 42, 0.18);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-whatsapp-quote:hover {
    border-color: #25D366;
    color: #128C7E !important;
    background: #F8FAFC;
    transform: translateY(-2px);
  }

  .wa-icon {
    color: #25D366;
    display: flex;
    align-items: center;
  }

  .quote-success-banner {
    padding: 1.25rem 1.5rem;
    border-radius: 14px;
    background: rgba(26, 166, 183, 0.1);
    border: 1px solid rgba(26, 166, 183, 0.35);
    color: #0F172A;
    font-size: 0.92rem;
    line-height: 1.55;
    margin-top: 0.5rem;
  }

  .quote-success-banner strong {
    display: block;
    color: #0F172A;
    font-size: 0.98rem;
    margin-bottom: 0.35rem;
  }

  .quote-success-banner p {
    margin: 0;
    color: #334155;
  }

  /* COLUMNA VISUAL DE LA EJECUTIVA */
  .advisor-visual-col {
    position: relative;
    width: 100%;
    min-height: 580px;
    background: #081622;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0;
  }

  .advisor-cover-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 15%;
    display: block;
    transition: transform 0.6s ease;
  }

  .advisor-split-card:hover .advisor-cover-img {
    transform: scale(1.02);
  }

  .advisor-overlay-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg, 
      rgba(8, 22, 32, 0) 0%, 
      rgba(8, 22, 32, 0.05) 30%, 
      rgba(8, 22, 32, 0.62) 58%, 
      rgba(8, 22, 32, 0.92) 78%,
      #081622 100%
    );
    z-index: 1;
  }

  /* BARRA INFERIOR UNIFICADA A LOS BORDES (NO FLOTANTE) */
  .advisor-unified-footer {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 2.25rem 2.5rem 2.5rem;
    color: #FFFFFF;
    background: transparent;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .advisor-quote-text {
    font-size: 0.92rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.92);
    margin: 0 0 1.15rem;
    font-style: italic;
  }

  .advisor-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.9rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .advisor-full-name {
    font-size: 1.18rem;
    font-weight: 800;
    color: #FFFFFF;
    margin: 0 0 0.15rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .advisor-job-title {
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #1AA6B7;
  }

  .advisor-wa-pill {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #25D366;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.35);
    transition: transform 0.2s ease, background 0.2s ease;
    flex-shrink: 0;
  }

  .advisor-wa-pill:hover {
    transform: scale(1.08);
    background: #20BA5A;
  }

  @media (max-width: 992px) {
    .advisor-split-card {
      grid-template-columns: 1fr;
    }

    .advisor-form-col {
      padding: 3rem 2rem;
    }

    .form-actions-wrap {
      flex-wrap: wrap;
    }

    .advisor-visual-col {
      min-height: 460px;
    }
  }

  @media (max-width: 580px) {
    .advisor-cta-section {
      padding: 3.5rem 0;
    }

    .form-row-two {
      grid-template-columns: 1fr;
    }

    .advisor-form-col {
      padding: 2.25rem 1.35rem;
    }

    .form-actions-wrap {
      flex-direction: column;
      align-items: stretch;
    }

    .btn-submit-quote,
    .btn-whatsapp-quote {
      justify-content: center;
      width: 100%;
    }
  }
</style>
