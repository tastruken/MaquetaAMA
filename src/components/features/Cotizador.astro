---
interface Props {
  isModal?: boolean;
  idPrefix?: string;
  showHeader?: boolean;
}

const { isModal = false, idPrefix = 'cotizador', showHeader = isModal } = Astro.props;
---

<div class={`cotizador-card ${isModal ? 'is-modal-style' : ''}`} id={`${idPrefix}-root`}>
  {showHeader && (
    <div class="cotizador-header">
      <div class="cotizador-header-info">
        <h3 class="cotizador-title">Simula tu dividendo en Quillayes de AMA INMOBILIARIA</h3>
        <p class="cotizador-subtitle">
          Calcula el valor de tu pie en hasta 60 cuotas y la cuota mensual de tu crédito hipotecario.
        </p>
      </div>
    </div>
  )}

  <div class="cotizador-body">
    <div class="cotizador-grid">
      <!-- Columna Izquierda: Parámetros -->
      <div class="cotizador-controls">
        <!-- Selector de Tipología -->
        <div class="form-group">
          <label class="form-label" for={`${idPrefix}-tipologia`}>1. Modelo / tipología</label>
          <select id={`${idPrefix}-tipologia`} class="form-select">
            <option value="2540" data-name="Modelo 1D + 1B (Desde 34,5 m²)">Modelo 1D + 1B · Desde 2.540 UF</option>
            <option value="3750" data-name="Modelo 2D + 2B Mariposa (Desde 58,0 m²)" selected>Modelo 2D + 2B Mariposa · Desde 3.750 UF</option>
          </select>
        </div>

        <!-- Porcentaje de Pie -->
        <div class="form-group">
          <div class="label-with-val">
            <label class="form-label" for={`${idPrefix}-pie-range`}>2. Porcentaje de Pie</label>
            <span id={`${idPrefix}-pie-val`} class="val-pill">15%</span>
          </div>
          <div class="pie-options-btns">
            <button type="button" class="pie-btn" data-percent="10">10% de Pie</button>
            <button type="button" class="pie-btn active" data-percent="15">15% de Pie</button>
            <button type="button" class="pie-btn" data-percent="20">20% de Pie</button>
          </div>
          <input 
            type="range" 
            id={`${idPrefix}-pie-range`} 
            min="10" 
            max="30" 
            step="1" 
            value="15" 
            class="range-slider"
          />
        </div>

        <!-- Plazo de Cuotas del Pie -->
        <div class="form-group">
          <div class="label-with-val">
            <label class="form-label" for={`${idPrefix}-cuotas-range`}>3. Cuotas para el Pie <span class="label-muted">(0% interés)</span></label>
            <span id={`${idPrefix}-cuotas-val`} class="val-pill">60 cuotas</span>
          </div>
          <div class="pie-options-btns">
            <button type="button" class="cuotas-btn" data-cuotas="30">30 cuotas</button>
            <button type="button" class="cuotas-btn active" data-cuotas="60">60 cuotas</button>
          </div>
          <input 
            type="range" 
            id={`${idPrefix}-cuotas-range`} 
            min="1" 
            max="60" 
            step="1" 
            value="60" 
            class="range-slider"
          />
          <div class="range-scale-labels">
            <span>1 cuota</span>
            <span>30 cuotas</span>
            <span>60 cuotas</span>
          </div>
        </div>

        <!-- Plazo de Crédito -->
        <div class="form-group is-last">
          <label class="form-label">4. Plazo de Crédito Hipotecario</label>
          <div class="plazo-radio-group">
            <label class="radio-label">
              <input type="radio" name={`${idPrefix}-plazo`} value="20" class="sr-radio" />
              <span>20 años</span>
            </label>
            <label class="radio-label active-radio">
              <input type="radio" name={`${idPrefix}-plazo`} value="25" checked class="sr-radio" />
              <span>25 años</span>
            </label>
            <label class="radio-label">
              <input type="radio" name={`${idPrefix}-plazo`} value="30" class="sr-radio" />
              <span>30 años</span>
            </label>
          </div>
          <p class="controls-footnote">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="16" x2="12" y2="12"/>
              <line x1="12" y1="8" x2="12.01" y2="8"/>
            </svg>
            <span>Paga tu pie en hasta 60 cuotas sin interés en etapa en verde.</span>
          </p>
        </div>
      </div>

      <!-- Columna Derecha: Resumen Compacto de Simulación -->
      <div class="cotizador-summary">
        <div class="summary-box">
          <div class="summary-top">
            <div class="kpi-dual-grid">
              <div class="kpi-card">
                <span class="summary-caption">Dividendo estimado</span>
                <span class="dividendo-uf" id={`${idPrefix}-dividendo-uf`}>16.13 UF</span>
                <span class="dividendo-clp" id={`${idPrefix}-dividendo-clp`}>~$629.000 / mes</span>
              </div>

              <div class="kpi-card is-accent">
                <span class="summary-caption" id={`${idPrefix}-pie-cuotas-kicker`}>Cuota Pie (60 cuotas s/i)</span>
                <span class="dividendo-uf" id={`${idPrefix}-pie-cuota-uf`}>9.38 UF</span>
                <span class="dividendo-clp is-dark" id={`${idPrefix}-pie-cuota-clp`}>~$365.625 / mes</span>
              </div>
            </div>

            <div class="summary-meta-line">
              <span class="uf-reference-chip">
                <span>UF ref.:</span>
                <strong id={`${idPrefix}-uf-chip-val`}>$39.000 CLP</strong>
              </span>
              <span class="dividendo-disclaimer">*Tasa anual ref. 3,6%</span>
            </div>
          </div>

          <div class="summary-breakdown-grid">
            <div class="metric-cell">
              <span class="metric-cell-label">Valor Propiedad</span>
              <strong id={`${idPrefix}-precio-total`}>3.750 UF</strong>
            </div>
            <div class="metric-cell">
              <span class="metric-cell-label" id={`${idPrefix}-pie-label`}>Monto de Pie (15%)</span>
              <strong id={`${idPrefix}-pie-monto`}>562.5 UF (~$21.9M)</strong>
            </div>
            <div class="metric-cell">
              <span class="metric-cell-label">Crédito a financiar</span>
              <strong id={`${idPrefix}-credito-monto`}>3.187.5 UF</strong>
            </div>
            <div class="metric-cell">
              <span class="metric-cell-label" id={`${idPrefix}-pie-cuota-row-label`}>Cuota Pie (60 cuotas)</span>
              <strong id={`${idPrefix}-pie-cuota-row-val`}>9.38 UF (~$365.625)</strong>
            </div>
            <div class="breakdown-row highlight-row">
              <span>Renta mínima sugerida:</span>
              <strong id={`${idPrefix}-renta-sugerida`}>~$2.516.000</strong>
            </div>
          </div>

          <!-- Formulario compacto para agendar y enviar cotización -->
          <form class="quote-lead-form" id={`${idPrefix}-lead-form`}>
            <p class="form-instructions">Recibe esta cotización en tu correo:</p>
            <div class="form-inputs-grid">
              <input 
                type="text" 
                id={`${idPrefix}-lead-name`} 
                name="name"
                placeholder="Tu Nombre completo" 
                required 
                class="form-input is-full" 
              />
              <input 
                type="email" 
                id={`${idPrefix}-lead-email`} 
                name="email"
                placeholder="Correo electrónico" 
                required 
                class="form-input" 
              />
              <input 
                type="tel" 
                id={`${idPrefix}-lead-phone`} 
                name="phone"
                placeholder="Teléfono (+569)" 
                required 
                class="form-input" 
              />
            </div>
            <button type="submit" id={`${idPrefix}-submit-btn`} class="btn-simulador-submit">
              <span>Solicitar Asesoría</span>
              <span aria-hidden="true">↗</span>
            </button>
            <div id={`${idPrefix}-success-msg`} class="success-message" style="display: none;">
              ✅ ¡Solicitud enviada a nuestro equipo! Un ejecutivo de AMA Inmobiliaria se comunicará contigo pronto.
            </div>
            <div id={`${idPrefix}-error-msg`} class="error-message" style="display: none;"></div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .cotizador-card {
    background: #FFFFFF;
    border-radius: 28px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    box-shadow: 0 22px 54px -14px rgba(15, 23, 42, 0.1);
    overflow: hidden;
  }

  .cotizador-header {
    background: var(--color-petrol);
    color: var(--color-cream);
    padding: 1.75rem 2.25rem;
    position: relative;
    border-bottom: 3px solid var(--color-cyan);
  }

  .cotizador-title {
    color: var(--color-cream);
    margin: 0 0 0.35rem;
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .cotizador-subtitle {
    color: var(--text-on-dark-muted);
    font-size: 0.94rem;
    margin: 0;
  }

  .cotizador-body {
    padding: 2.15rem 2.35rem;
  }

  .cotizador-grid {
    display: grid;
    grid-template-columns: 0.95fr 1.12fr;
    gap: 2.25rem;
    align-items: stretch;
  }

  .cotizador-controls {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-group.is-last {
    margin-bottom: 0;
  }

  .form-label {
    display: block;
    font-weight: 700;
    color: #0F172A;
    font-size: 0.92rem;
    margin-bottom: 0.5rem;
  }

  .label-muted {
    font-weight: 500;
    font-size: 0.84rem;
    color: #64748B;
  }

  .label-with-val {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .label-with-val .form-label {
    margin-bottom: 0;
  }

  .val-pill {
    background: rgba(26, 166, 183, 0.14);
    color: var(--color-cyan, #1AA6B7);
    font-weight: 800;
    padding: 0.2rem 0.72rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    letter-spacing: 0.01em;
  }

  .form-select,
  .form-input {
    width: 100%;
    padding: 0.78rem 1rem;
    border: 1px solid rgba(15, 23, 42, 0.14);
    border-radius: 14px;
    font-size: 0.92rem;
    font-family: inherit;
    color: #0F172A;
    background-color: #F8FAFC;
    transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-select:focus,
  .form-input:focus {
    outline: none;
    border-color: var(--color-cyan, #1AA6B7);
    background-color: #FFFFFF;
    box-shadow: 0 0 0 3px rgba(26, 166, 183, 0.14);
  }

  .pie-options-btns,
  .plazo-radio-group {
    display: flex;
    gap: 0.35rem;
    padding: 0.3rem;
    background: #F1F5F9;
    border-radius: 9999px;
  }

  .pie-options-btns {
    margin-bottom: 0.65rem;
  }

  .pie-btn,
  .cuotas-btn,
  .radio-label {
    flex: 1;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.52rem 0.65rem;
    background: transparent;
    border: none;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #64748B;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .sr-radio {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .pie-btn:hover,
  .cuotas-btn:hover,
  .radio-label:hover {
    color: #0F172A;
  }

  .pie-btn.active,
  .cuotas-btn.active,
  .radio-label.active-radio {
    background: #0F172A;
    color: #FFFFFF;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.18);
  }

  .range-scale-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: #64748B;
    margin-top: 0.25rem;
  }

  .range-slider {
    width: 100%;
    height: 6px;
    border-radius: 999px;
    background: #E2E8F0;
    outline: none;
    accent-color: var(--color-cyan, #1AA6B7);
    cursor: pointer;
  }

  .controls-footnote {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0.9rem 0 0;
    font-size: 0.8rem;
    color: #64748B;
    line-height: 1.4;
  }

  .controls-footnote svg {
    color: var(--color-cyan, #1AA6B7);
    flex-shrink: 0;
  }

  /* Summary Box */
  .summary-box {
    background: #F8FAFC;
    border-radius: 22px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    padding: 1.5rem 1.65rem;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .summary-top {
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    margin-bottom: 1rem;
  }

  .kpi-dual-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .kpi-card {
    background: #FFFFFF;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 16px;
    padding: 0.9rem 1rem;
    text-align: center;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
  }

  .kpi-card.is-accent {
    border-color: rgba(26, 166, 183, 0.4);
  }

  .summary-caption {
    display: block;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
    color: #64748B;
    margin-bottom: 0.25rem;
  }

  .kpi-card.is-accent .summary-caption {
    color: var(--color-cyan, #1AA6B7);
  }

  .dividendo-uf {
    display: block;
    font-size: clamp(1.45rem, 2.2vw, 1.85rem);
    font-weight: 800;
    color: #0F172A;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .dividendo-clp {
    display: block;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-cyan, #1AA6B7);
    margin-top: 0.15rem;
  }

  .dividendo-clp.is-dark {
    color: #475569;
  }

  .summary-meta-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
  }

  .dividendo-disclaimer {
    font-size: 0.75rem;
    color: #64748B;
    margin: 0;
  }

  .uf-reference-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #FFFFFF;
    border: 1px solid rgba(15, 23, 42, 0.1);
    padding: 0.24rem 0.72rem;
    border-radius: 9999px;
    font-size: 0.76rem;
    color: #475569;
  }

  .uf-reference-chip strong {
    color: var(--color-cyan, #1AA6B7);
    font-weight: 700;
  }

  .summary-breakdown-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.55rem;
    margin-bottom: 1.1rem;
  }

  .metric-cell {
    background: #FFFFFF;
    border: 1px solid rgba(15, 23, 42, 0.06);
    border-radius: 12px;
    padding: 0.58rem 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
  }

  .metric-cell-label {
    font-size: 0.74rem;
    color: #64748B;
    font-weight: 500;
  }

  .metric-cell strong {
    font-size: 0.9rem;
    color: #0F172A;
    font-weight: 700;
  }

  .breakdown-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.86rem;
    color: #475569;
  }

  .breakdown-row strong {
    color: #0F172A;
    font-weight: 700;
  }

  .highlight-row {
    grid-column: span 2;
    background: #FFFFFF;
    padding: 0.58rem 0.85rem;
    border-radius: 12px;
    border: 1px dashed rgba(26, 166, 183, 0.55);
  }

  .quote-lead-form {
    border-top: 1px solid rgba(15, 23, 42, 0.08);
    padding-top: 1rem;
    margin-top: auto;
  }

  .form-instructions {
    font-size: 0.84rem;
    font-weight: 700;
    color: #0F172A;
    margin: 0 0 0.65rem;
  }

  .form-inputs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.55rem;
    margin-bottom: 0.75rem;
  }

  .form-input.is-full {
    grid-column: span 2;
  }

  .btn-simulador-submit {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: #FF6B35;
    color: #FFFFFF;
    border: none;
    border-radius: 9999px;
    padding: 0.88rem 1.4rem;
    font-size: 0.94rem;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(255, 107, 53, 0.25);
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-simulador-submit:hover:not(:disabled) {
    background: #e85a26;
    transform: translateY(-2px);
    box-shadow: 0 12px 24px rgba(255, 107, 53, 0.35);
  }

  .btn-simulador-submit:disabled {
    opacity: 0.7;
    cursor: wait;
  }

  .success-message {
    margin-top: 0.85rem;
    padding: 0.75rem;
    background: rgba(37, 211, 102, 0.14);
    border: 1px solid #25D366;
    border-radius: 12px;
    color: #0F172A;
    font-size: 0.85rem;
    font-weight: 600;
    text-align: center;
  }

  .error-message {
    margin-top: 0.85rem;
    padding: 0.75rem;
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.4);
    border-radius: 12px;
    color: #991B1B;
    font-size: 0.84rem;
    font-weight: 600;
    text-align: center;
  }

  .error-message a {
    color: #991B1B;
    text-decoration: underline;
  }

  @media (max-width: 860px) {
    .cotizador-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .cotizador-body {
      padding: 1.4rem;
    }
  }

  @media (max-width: 520px) {
    .kpi-dual-grid,
    .summary-breakdown-grid,
    .form-inputs-grid {
      grid-template-columns: 1fr;
    }
    .highlight-row,
    .form-input.is-full {
      grid-column: span 1;
    }
  }
</style>

<script define:vars={{ idPrefix }}>
  (function initCotizador() {
    let ufValue = 39000; // Valor referencial de respaldo de la UF en CLP
    const ANNUAL_RATE = 0.036; // Tasa anual referencial 3.6%
    const MONTHLY_RATE = Math.pow(1 + ANNUAL_RATE, 1 / 12) - 1;
    const TARGET_EMAIL = 'quillayes@iama.cl';

    const selectTipologia = document.getElementById(`${idPrefix}-tipologia`);
    const rangePie = document.getElementById(`${idPrefix}-pie-range`);
    const valPie = document.getElementById(`${idPrefix}-pie-val`);
    const pieButtons = document.querySelectorAll(`#${idPrefix}-root .pie-btn`);
    const rangeCuotas = document.getElementById(`${idPrefix}-cuotas-range`);
    const valCuotas = document.getElementById(`${idPrefix}-cuotas-val`);
    const cuotasButtons = document.querySelectorAll(`#${idPrefix}-root .cuotas-btn`);
    const radioPlazos = document.querySelectorAll(`input[name="${idPrefix}-plazo"]`);

    const elDividendoUf = document.getElementById(`${idPrefix}-dividendo-uf`);
    const elDividendoClp = document.getElementById(`${idPrefix}-dividendo-clp`);
    const elPieCuotasKicker = document.getElementById(`${idPrefix}-pie-cuotas-kicker`);
    const elPieCuotaUf = document.getElementById(`${idPrefix}-pie-cuota-uf`);
    const elPieCuotaClp = document.getElementById(`${idPrefix}-pie-cuota-clp`);
    const elPieCuotaRowLabel = document.getElementById(`${idPrefix}-pie-cuota-row-label`);
    const elPieCuotaRowVal = document.getElementById(`${idPrefix}-pie-cuota-row-val`);
    const elUfChipVal = document.getElementById(`${idPrefix}-uf-chip-val`);
    const elUfRowVal = document.getElementById(`${idPrefix}-uf-row-val`);
    const elPrecioTotal = document.getElementById(`${idPrefix}-precio-total`);
    const elPieLabel = document.getElementById(`${idPrefix}-pie-label`);
    const elPieMonto = document.getElementById(`${idPrefix}-pie-monto`);
    const elCreditoMonto = document.getElementById(`${idPrefix}-credito-monto`);
    const elRentaSugerida = document.getElementById(`${idPrefix}-renta-sugerida`);
    const formLead = document.getElementById(`${idPrefix}-lead-form`);
    const submitBtn = document.getElementById(`${idPrefix}-submit-btn`);
    const successMsg = document.getElementById(`${idPrefix}-success-msg`);
    const errorMsg = document.getElementById(`${idPrefix}-error-msg`);

    function getSelectedPlazo() {
      let plazoYears = 25;
      radioPlazos.forEach((radio) => {
        if (radio.checked) {
          plazoYears = parseInt(radio.value, 10);
        }
      });
      return plazoYears;
    }

    function formatCuotasText(count) {
      return `${count} ${count === 1 ? 'cuota' : 'cuotas'}`;
    }

    function syncPresetButtons(buttons, attrName, valueStr) {
      buttons.forEach((btn) => {
        btn.classList.toggle('active', btn.getAttribute(attrName) === valueStr);
      });
    }

    function calculate() {
      if (!selectTipologia || !rangePie) return;
      const ufPrice = parseFloat(selectTipologia.value);
      const piePercent = parseInt(rangePie.value, 10);
      const pieCuotas = Math.max(1, parseInt(rangeCuotas?.value || '60', 10) || 60);
      const plazoYears = getSelectedPlazo();

      const pieUf = (ufPrice * piePercent) / 100;
      const pieCuotaUf = pieUf / pieCuotas;
      const pieCuotaClp = Math.round(pieCuotaUf * ufValue);
      const loanUf = ufPrice - pieUf;
      const totalMonths = plazoYears * 12;

      // Fórmula de cuota dividendo hipotecario: C = P * [r(1+r)^n] / [(1+r)^n - 1]
      const r = MONTHLY_RATE;
      const n = totalMonths;
      const factor = (r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
      const monthlyPaymentUf = loanUf * factor;
      const monthlyPaymentClp = Math.round(monthlyPaymentUf * ufValue);
      const pieClp = Math.round(pieUf * ufValue);
      const minIncomeClp = Math.round(monthlyPaymentClp * 4);
      const cuotasText = formatCuotasText(pieCuotas);

      if (valPie) valPie.textContent = `${piePercent}%`;
      if (valCuotas) valCuotas.textContent = cuotasText;
      if (elDividendoUf) elDividendoUf.textContent = `${monthlyPaymentUf.toFixed(2)} UF`;
      if (elDividendoClp) elDividendoClp.textContent = `~$${monthlyPaymentClp.toLocaleString('es-CL')} / mes`;
      if (elPieCuotasKicker) elPieCuotasKicker.textContent = `Cuota Pie (${cuotasText} s/i)`;
      if (elPieCuotaUf) elPieCuotaUf.textContent = `${pieCuotaUf.toFixed(2)} UF`;
      if (elPieCuotaClp) elPieCuotaClp.textContent = `~$${pieCuotaClp.toLocaleString('es-CL')} / mes`;
      if (elPieCuotaRowLabel) elPieCuotaRowLabel.textContent = `Cuota Pie (${cuotasText})`;
      if (elPieCuotaRowVal) elPieCuotaRowVal.textContent = `${pieCuotaUf.toFixed(2)} UF (~$${pieCuotaClp.toLocaleString('es-CL')})`;
      if (elPrecioTotal) elPrecioTotal.textContent = `${ufPrice.toLocaleString('es-CL')} UF`;
      if (elPieLabel) elPieLabel.textContent = `Monto de Pie (${piePercent}%)`;
      if (elPieMonto) elPieMonto.textContent = `${pieUf.toFixed(1)} UF (~$${(pieClp / 1000000).toFixed(1)}M)`;
      if (elCreditoMonto) elCreditoMonto.textContent = `${loanUf.toFixed(1)} UF`;
      if (elRentaSugerida) elRentaSugerida.textContent = `~$${minIncomeClp.toLocaleString('es-CL')}`;
    }

    // Actualiza automáticamente la UF del día desde mindicador.cl (datos Banco Central de Chile)
    function syncLiveUf() {
      if (!window.__amaUfPromise) {
        window.__amaUfPromise = fetch('https://mindicador.cl/api/uf')
          .then((res) => (res.ok ? res.json() : null))
          .then((data) => {
            const latest = data?.serie?.[0]?.valor;
            return typeof latest === 'number' && latest > 30000 ? Math.round(latest) : null;
          })
          .catch(() => null);
      }

      window.__amaUfPromise.then((liveUf) => {
        if (!liveUf) return;
        ufValue = liveUf;
        const formattedUf = `$${ufValue.toLocaleString('es-CL')} CLP`;
        if (elUfChipVal) elUfChipVal.textContent = `${formattedUf} (hoy)`;
        if (elUfRowVal) elUfRowVal.textContent = formattedUf;
        calculate();
      });
    }

    if (selectTipologia) selectTipologia.addEventListener('change', calculate);
    if (rangePie) {
      rangePie.addEventListener('input', () => {
        syncPresetButtons(pieButtons, 'data-percent', rangePie.value);
        calculate();
      });
    }

    pieButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const percent = btn.getAttribute('data-percent');
        if (rangePie && percent) rangePie.value = percent;
        syncPresetButtons(pieButtons, 'data-percent', percent || '');
        calculate();
      });
    });

    if (rangeCuotas) {
      rangeCuotas.addEventListener('input', () => {
        syncPresetButtons(cuotasButtons, 'data-cuotas', rangeCuotas.value);
        calculate();
      });
    }

    cuotasButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cuotas = btn.getAttribute('data-cuotas');
        if (rangeCuotas && cuotas) rangeCuotas.value = cuotas;
        syncPresetButtons(cuotasButtons, 'data-cuotas', cuotas || '');
        calculate();
      });
    });

    radioPlazos.forEach((radio) => {
      radio.addEventListener('change', () => {
        radioPlazos.forEach((r) => {
          const parent = r.closest('.radio-label');
          if (parent) parent.classList.toggle('active-radio', r.checked);
        });
        calculate();
      });
    });

    if (formLead) {
      formLead.addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = document.getElementById(`${idPrefix}-lead-name`)?.value.trim() || '';
        const phone = document.getElementById(`${idPrefix}-lead-phone`)?.value.trim() || '';
        const email = document.getElementById(`${idPrefix}-lead-email`)?.value.trim() || '';
        const tipologiaText = selectTipologia?.options[selectTipologia.selectedIndex]?.text || '';
        const piePercent = rangePie?.value || '15';
        const pieCuotas = Math.max(1, parseInt(rangeCuotas?.value || '60', 10) || 60);
        const plazoYears = getSelectedPlazo();
        const precioTotal = elPrecioTotal?.textContent || '';
        const pieMonto = elPieMonto?.textContent || '';
        const pieCuotaRes = elPieCuotaRowVal?.textContent || '';
        const creditoMonto = elCreditoMonto?.textContent || '';
        const divUf = elDividendoUf?.textContent || '';
        const divClp = elDividendoClp?.textContent || '';
        const ufText = `$${ufValue.toLocaleString('es-CL')} CLP`;

        if (successMsg) successMsg.style.display = 'none';
        if (errorMsg) errorMsg.style.display = 'none';
        if (submitBtn) {
          submitBtn.disabled = true;
          const labelSpan = submitBtn.querySelector('span');
          if (labelSpan) labelSpan.textContent = 'Enviando solicitud...';
        }

        const payload = {
          _subject: `Nueva simulación y asesoría AMA Quillayes · ${name}`,
          _replyto: email,
          _template: 'table',
          Nombre: name,
          Correo: email,
          Teléfono: phone,
          Modelo: tipologiaText,
          'Valor Propiedad': precioTotal,
          Pie: `${piePercent}% (${pieMonto})`,
          'Cuotas del Pie': `${formatCuotasText(pieCuotas)} · ${pieCuotaRes}`,
          'Crédito a Financiar': creditoMonto,
          Plazo: `${plazoYears} años`,
          'Dividendo Estimado': `${divUf} (${divClp})`,
          'Valor UF Referencial': ufText
        };

        try {
          const res = await fetch(`https://formsubmit.co/ajax/${TARGET_EMAIL}`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json'
            },
            body: JSON.stringify(payload)
          });

          if (!res.ok) throw new Error('Error al enviar formulario');

          if (successMsg) successMsg.style.display = 'block';
          formLead.reset();
        } catch (_err) {
          const mailtoBody = `Hola AMA Inmobiliaria,\n\nSolicito asesoría con mi simulación:\n- Nombre: ${name}\n- Correo: ${email}\n- Teléfono: ${phone}\n- Modelo: ${tipologiaText}\n- Pie: ${piePercent}% (${pieMonto})\n- Cuotas del Pie: ${formatCuotasText(pieCuotas)} (${pieCuotaRes})\n- Plazo: ${plazoYears} años\n- Dividendo estimado: ${divUf} (${divClp})\n- UF usada: ${ufText}`;
          const mailtoHref = `mailto:${TARGET_EMAIL}?subject=${encodeURIComponent(`Solicitud de asesoría AMA Quillayes - ${name}`)}&body=${encodeURIComponent(mailtoBody)}`;
          if (errorMsg) {
            errorMsg.innerHTML = `No se pudo enviar automáticamente desde el navegador. Escríbenos directo a <a href="${mailtoHref}">${TARGET_EMAIL}</a>.`;
            errorMsg.style.display = 'block';
          }
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            const labelSpan = submitBtn.querySelector('span');
            if (labelSpan) labelSpan.textContent = 'Solicitar Asesoría';
          }
        }
      });
    }

    calculate();
    syncLiveUf();
  })();
</script>
