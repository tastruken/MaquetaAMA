---
// src/components/features/AmitaTip.astro
// Pequeña cápsula decorativa con Amita para acompañar guías y artículos del Blog
import { u } from '../../utils/url';

interface Props {
  image: string;
  alt: string;
  label?: string;
  title?: string;
  variant?: 'soft' | 'dark';
}

const {
  image,
  alt,
  label = 'Consejo de Amita',
  title,
  variant = 'soft',
} = Astro.props;
---

<aside class={`amita-tip-box is-${variant}`} aria-label={label}>
  <div class="amita-tip-figure">
    <img
      src={u(image)}
      alt={alt}
      class="amita-tip-img"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="amita-tip-body">
    <span class="amita-tip-kicker">{label}</span>
    {title && <strong class="amita-tip-title">{title}</strong>}
    <div class="amita-tip-copy">
      <slot />
    </div>
  </div>
</aside>

<style>
  .amita-tip-box {
    display: flex;
    align-items: center;
    gap: 1.35rem;
    padding: 1.25rem 1.5rem;
    border-radius: 18px;
    margin: 1.75rem 0;
  }

  .amita-tip-box.is-soft {
    background: linear-gradient(135deg, #F0FBFD 0%, #F8FAFC 100%);
    border: 1px solid rgba(26, 166, 183, 0.24);
    border-left: 4px solid var(--color-cyan, #1AA6B7);
  }

  .amita-tip-box.is-dark {
    background: var(--color-petrol, #0F172A);
    border: 1px solid rgba(26, 166, 183, 0.3);
    color: #FFFFFF;
  }

  .amita-tip-figure {
    flex-shrink: 0;
    width: 88px;
    height: 88px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #FFFFFF;
    border-radius: 16px;
    padding: 0.45rem;
    box-shadow: 0 6px 18px -6px rgba(15, 23, 42, 0.12);
    border: 1px solid rgba(15, 23, 42, 0.06);
  }

  .amita-tip-box.is-dark .amita-tip-figure {
    background: rgba(255, 255, 255, 0.96);
  }

  .amita-tip-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .amita-tip-body {
    flex: 1;
    min-width: 0;
  }

  .amita-tip-kicker {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-cyan, #1AA6B7);
    margin-bottom: 0.2rem;
  }

  .amita-tip-title {
    display: block;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-petrol, #0F172A);
    margin-bottom: 0.3rem;
    line-height: 1.35;
  }

  .amita-tip-box.is-dark .amita-tip-title {
    color: #FFFFFF;
  }

  .amita-tip-copy :global(p) {
    margin: 0;
    font-size: 0.93rem;
    line-height: 1.6;
    color: #334155;
  }

  .amita-tip-box.is-dark .amita-tip-copy :global(p) {
    color: rgba(255, 255, 255, 0.85);
  }

  @media (max-width: 600px) {
    .amita-tip-box {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.9rem;
      padding: 1.15rem 1.2rem;
    }

    .amita-tip-figure {
      width: 76px;
      height: 76px;
    }
  }
</style>
