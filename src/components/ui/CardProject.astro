---
// src/components/ui/CardProject.astro
// Tarjeta de proyecto inmobiliario estilo Luxury Listing Card de Aurvix
import { u } from '../../utils/url';

interface Props {
  title: string;
  slug: string;
  location: string;
  priceFrom: string;
  typology: string;
  status: 'En Blanco' | 'En Verde' | 'Entrega Inmediata';
  badgePromo?: string;
  image?: string;
}

const {
  title,
  slug,
  location,
  priceFrom,
  typology,
  status,
  badgePromo = 'Bono Pie 10% + 36 cuotas',
  image = '/images/ama_quillayes_facade.jpg'
} = Astro.props;
---

<article class="luxury-project-card bento-card">
  <!-- Imagen Panorámica con Badges Flotantes -->
  <div class="card-media-wrapper">
    <a href={u(`/proyectos/${slug}`)} class="card-image-link" aria-label={`Ver detalles de ${title}`}>
      <img 
        src={u(image)} 
        alt={title} 
        class="card-img" 
        loading="lazy" 
      />
    </a>

    <!-- Badges Flotantes Superiores -->
    <div class="card-floating-tags">
      <span class="pill-tag-dark">{status}</span>
      {badgePromo && <span class="pill-tag-coral">{badgePromo}</span>}
    </div>

    <!-- Botón Favorito / Guardar -->
    <button type="button" class="btn-fav-circle" aria-label="Guardar proyecto">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
      </svg>
    </button>
  </div>

  <!-- Franja de Especificaciones (Specs Strip estilo Aurvix) -->
  <div class="specs-strip">
    <div class="spec-item">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M2 4v16M2 8h18a2 2 0 0 1 2 2v10M2 17h20M6 8v9"></path>
      </svg>
      <span>1 a 3 Dorms</span>
    </div>
    <span class="spec-sep">|</span>
    <div class="spec-item">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M9 6v14M15 6v14M4 10h16M4 14h16"></path>
      </svg>
      <span>1 a 2 Baños</span>
    </div>
    <span class="spec-sep">|</span>
    <div class="spec-item">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="18" height="18" rx="2"></rect>
        <path d="M3 9h18M9 21V9"></path>
      </svg>
      <span>34 a 72 m²</span>
    </div>
  </div>

  <!-- Contenido y Precios -->
  <div class="card-details">
    <div class="title-row">
      <h3 class="card-project-title">
        <a href={u(`/proyectos/${slug}`)}>{title}</a>
      </h3>
      <span class="delivery-year">Entrega 2026</span>
    </div>

    <div class="location-row">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
        <circle cx="12" cy="10" r="3"></circle>
      </svg>
      <span>{location}</span>
    </div>

    <!-- Pie con Precio y CTA circular -->
    <div class="card-action-footer">
      <div class="price-container">
        <span class="price-prefix">Desde</span>
        <strong class="price-number">{priceFrom}</strong>
        <span class="price-subtitle">Pie en 36 cuotas</span>
      </div>

      <div class="action-buttons-group">
        <button 
          type="button" 
          class="btn-cotizar-mini"
          onclick="window.openCotizadorModal && window.openCotizadorModal()"
        >
          Cotizar
        </button>
        <a href={u(`/proyectos/${slug}`)} class="arrow-circle-btn" aria-label={`Ver ficha de ${title}`}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</article>

<style>
  .luxury-project-card {
    padding: 0.85rem;
    border-radius: var(--radius-bento);
    background: #FFFFFF;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: all var(--transition-elastic);
  }

  .card-media-wrapper {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    height: 270px;
    background-color: var(--color-petrol);
  }

  .card-image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .luxury-project-card:hover .card-img {
    transform: scale(1.05);
  }

  .card-floating-tags {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    z-index: 2;
    pointer-events: none;
  }

  .pill-tag-dark {
    background: rgba(0, 20, 30, 0.8);
    backdrop-filter: blur(8px);
    color: #FFFFFF;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .pill-tag-coral {
    background: var(--color-coral);
    color: #FFFFFF;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
    font-size: 0.76rem;
    font-weight: 700;
    box-shadow: 0 4px 12px rgba(var(--rgb-coral), 0.35);
  }

  .btn-fav-circle {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-petrol);
    z-index: 2;
    transition: all var(--transition-fast);
  }

  .btn-fav-circle:hover {
    background: #FFFFFF;
    color: var(--color-coral);
    transform: scale(1.08);
  }

  /* Specs Strip */
  .specs-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0.6rem 0.75rem;
    font-size: 0.84rem;
    color: var(--text-muted);
    font-weight: 500;
    border-bottom: 1px solid rgba(var(--rgb-petrol), 0.06);
  }

  .spec-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .spec-item svg {
    color: var(--color-cyan);
  }

  .spec-sep {
    color: rgba(var(--rgb-petrol), 0.15);
  }

  /* Details */
  .card-details {
    padding: 1rem 0.6rem 0.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.8rem;
    margin-bottom: 0.3rem;
  }

  .card-project-title {
    font-size: 1.35rem;
    font-weight: var(--font-weight-heavy);
    color: var(--color-petrol);
    line-height: 1.2;
  }

  .card-project-title a {
    color: inherit;
  }

  .card-project-title a:hover {
    color: var(--color-cyan);
  }

  .delivery-year {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-petrol);
    background: rgba(var(--rgb-petrol), 0.05);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .location-row {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.86rem;
    color: var(--text-soft);
    margin-bottom: 1.25rem;
  }

  .location-row svg {
    color: var(--color-cyan);
  }

  /* Action Footer */
  .card-action-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(var(--rgb-petrol), 0.06);
  }

  .price-container {
    display: flex;
    flex-direction: column;
  }

  .price-prefix {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-soft);
  }

  .price-number {
    font-size: 1.45rem;
    font-weight: var(--font-weight-heavy);
    color: var(--color-petrol);
    line-height: 1.1;
  }

  .price-subtitle {
    font-size: 0.76rem;
    color: var(--color-cyan);
    font-weight: 600;
  }

  .action-buttons-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-cotizar-mini {
    padding: 0.55rem 1rem;
    border-radius: var(--radius-full);
    background: rgba(var(--rgb-petrol), 0.05);
    color: var(--color-petrol);
    font-size: 0.84rem;
    font-weight: 700;
    transition: all var(--transition-fast);
  }

  .btn-cotizar-mini:hover {
    background: var(--color-petrol);
    color: #FFFFFF;
  }
</style>
