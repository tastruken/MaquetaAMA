---
// src/components/ui/CardProject.astro
// Tarjeta de proyecto inmobiliario con carrusel de fotos e información lateral
import { u } from '../../utils/url';

interface Props {
  title: string;
  slug: string;
  location: string;
  priceFrom: string;
  typology: string;
  status: 'En Blanco' | 'En Verde' | 'Entrega Inmediata';
  badgePromo?: string;
  image?: string;
  images?: string[];
  dorms?: string;
  baths?: string;
  surface?: string;
  delivery?: string;
  priceSubtitle?: string;
}

const {
  title,
  slug,
  location,
  priceFrom,
  typology,
  status,
  badgePromo,
  image = '/images/ama_quillayes_facade.jpg',
  images = [
    '/images/ama_quillayes_facade.jpg',
    '/images/ama_interior_living.jpg',
    '/images/ama_piloto_cocina_quillayes.jpg',
    '/images/ama_amenity_rooftop.jpg',
    '/images/ama_quinchos_rooftop_quillayes.jpg'
  ],
  dorms = '1 a 3 Dorms',
  baths = '1 a 2 Baños',
  surface = '34 a 72 m²',
  delivery = 'Entrega 2026',
  priceSubtitle = 'Pie en 36 cuotas'
} = Astro.props;

const slideImages = images.length > 0 ? images : [image];
---

<article class="luxury-project-card" data-project-carousel>
  <!-- Columna Izquierda: Carrusel de Imágenes Edge-to-Edge (Sin enlace ni zoom) -->
  <div class="card-media-wrapper">
    <div class="carousel-track">
      {slideImages.map((imgSrc, idx) => (
        <div class={`carousel-slide ${idx === 0 ? 'active' : ''}`} data-slide-index={idx}>
          <img 
            src={u(imgSrc)} 
            alt={`${title} - Vista ${idx + 1}`} 
            class="card-img" 
            loading={idx === 0 ? 'eager' : 'lazy'} 
          />
        </div>
      ))}
    </div>

    {slideImages.length > 1 && (
      <>
        <button type="button" class="carousel-arrow prev" data-carousel-prev aria-label="Imagen anterior">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button type="button" class="carousel-arrow next" data-carousel-next aria-label="Siguiente imagen">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>

        <div class="carousel-dots" role="tablist" aria-label="Selector de imagen">
          {slideImages.map((_, idx) => (
            <button
              type="button"
              class={`carousel-dot ${idx === 0 ? 'active' : ''}`}
              data-carousel-dot={idx}
              aria-label={`Ir a imagen ${idx + 1}`}
            />
          ))}
        </div>
      </>
    )}
  </div>

  <!-- Columna Derecha: Barra Lateral de Información y Precios -->
  <div class="card-details">
    <div class="card-details-top">
      <!-- Etiquetas de Estado y Entrega en la Barra Lateral -->
      <div class="sidebar-badges-row">
        <span class="pill-tag-dark">{status}</span>
        {badgePromo && <span class="pill-tag-coral">{badgePromo}</span>}
        <span class="delivery-year">{delivery}</span>
      </div>

      <h3 class="card-project-title">{title}</h3>

      <div class="location-row">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>{location}</span>
      </div>

      <p class="card-project-summary">
        Departamentos de 1 y 2 dormitorios con terrazas continuas a lo ancho. Espacios comunes para vivir tu día a día y a pasos de Metro Los Quillayes (L4).
      </p>

      <!-- Franja de Especificaciones (Specs Strip) -->
      <div class="specs-strip">
        <div class="spec-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M2 4v16M2 8h18a2 2 0 0 1 2 2v10M2 17h20M6 8v9"></path>
          </svg>
          <span>{dorms}</span>
        </div>
        <div class="spec-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 6v14M15 6v14M4 10h16M4 14h16"></path>
          </svg>
          <span>{baths}</span>
        </div>
        <div class="spec-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            <path d="M3 9h18M9 21V9"></path>
          </svg>
          <span>{surface}</span>
        </div>
      </div>
    </div>

    <!-- Pie con Precio y Único Botón de Navegación al Proyecto -->
    <div class="card-action-footer">
      <div class="price-container">
        <span class="price-prefix">Desde</span>
        <strong class="price-number">{priceFrom}</strong>
        <span class="price-subtitle">{priceSubtitle}</span>
      </div>

      <div class="action-buttons-group">
        <button 
          type="button" 
          class="btn-cotizar-mini"
          onclick="window.openCotizadorModal && window.openCotizadorModal()"
        >
          Cotizar
        </button>
        <a href={u(`/proyectos/${slug}`)} class="btn-ver-proyecto">
          <span>Ver Proyecto</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</article>

<script>
  function initProjectCarousels() {
    const cards = document.querySelectorAll<HTMLElement>('[data-project-carousel]');
    cards.forEach((card) => {
      if (card.dataset.bound === 'true') return;
      card.dataset.bound = 'true';

      const slides = card.querySelectorAll<HTMLElement>('.carousel-slide');
      const dots = card.querySelectorAll<HTMLElement>('.carousel-dot');
      const prevBtn = card.querySelector<HTMLElement>('[data-carousel-prev]');
      const nextBtn = card.querySelector<HTMLElement>('[data-carousel-next]');
      if (slides.length <= 1) return;

      let current = 0;

      function showSlide(index: number) {
        slides[current]?.classList.remove('active');
        dots[current]?.classList.remove('active');
        current = (index + slides.length) % slides.length;
        slides[current]?.classList.add('active');
        dots[current]?.classList.add('active');
      }

      prevBtn?.addEventListener('click', () => showSlide(current - 1));
      nextBtn?.addEventListener('click', () => showSlide(current + 1));
      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const idx = parseInt(dot.getAttribute('data-carousel-dot') || '0', 10);
          showSlide(idx);
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectCarousels);
  } else {
    initProjectCarousels();
  }
  document.addEventListener('astro:page-load', initProjectCarousels);
</script>

<style>
  .luxury-project-card {
    padding: 0;
    border-radius: 28px;
    background: #FFFFFF;
    border: 1px solid rgba(var(--rgb-petrol), 0.08);
    box-shadow: var(--shadow-card);
    display: grid;
    grid-template-columns: 1.75fr 1fr;
    gap: 0;
    align-items: stretch;
    width: 100%;
    overflow: hidden;
  }

  .card-media-wrapper {
    position: relative;
    border-radius: 0;
    overflow: hidden;
    min-height: 620px;
    height: 100%;
    background-color: var(--color-petrol);
    user-select: none;
  }

  .carousel-track {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 620px;
  }

  .carousel-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s ease;
  }

  .carousel-slide.active {
    opacity: 1;
    pointer-events: auto;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Controles del Carrusel */
  .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .carousel-arrow:hover {
    background: rgba(15, 23, 42, 0.9);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .carousel-arrow.prev {
    left: 1.25rem;
  }

  .carousel-arrow.next {
    right: 1.25rem;
  }

  .carousel-dots {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .carousel-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.45);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: width 0.25s ease, background 0.25s ease;
  }

  .carousel-dot.active {
    width: 24px;
    background: #FFFFFF;
  }

  /* Details (Barra Lateral al Costado de la Imagen) */
  .card-details {
    padding: 2.75rem 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: #FFFFFF;
  }

  .sidebar-badges-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.15rem;
  }

  .pill-tag-dark {
    background: var(--color-petrol);
    color: #FFFFFF;
    padding: 0.34rem 0.9rem;
    border-radius: var(--radius-full);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .pill-tag-coral {
    background: var(--color-coral);
    color: #FFFFFF;
    padding: 0.34rem 0.9rem;
    border-radius: var(--radius-full);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .delivery-year {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-petrol);
    background: rgba(var(--rgb-petrol), 0.06);
    padding: 0.34rem 0.85rem;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .card-project-title {
    font-size: clamp(1.85rem, 2.5vw, 2.35rem);
    font-weight: var(--font-weight-heavy);
    color: var(--color-petrol);
    line-height: 1.15;
    margin: 0 0 0.75rem;
  }

  .location-row {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--text-soft);
    margin-bottom: 1.25rem;
  }

  .location-row svg {
    color: var(--color-cyan);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .card-project-summary {
    font-size: 0.96rem;
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0 0 1.65rem;
  }

  /* Specs Strip */
  .specs-strip {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1.35rem 0;
    font-size: 0.95rem;
    color: var(--color-petrol);
    font-weight: 600;
    border-top: 1px solid rgba(var(--rgb-petrol), 0.08);
    border-bottom: 1px solid rgba(var(--rgb-petrol), 0.08);
    margin-bottom: 1.65rem;
  }

  .spec-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .spec-item svg {
    color: var(--color-cyan);
    flex-shrink: 0;
  }

  /* Action Footer */
  .card-action-footer {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    margin-top: auto;
    padding-top: 0.75rem;
    gap: 1.25rem;
  }

  .price-container {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .price-prefix {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-soft);
    margin-bottom: 0.15rem;
  }

  .price-number {
    font-size: clamp(2.45rem, 3.4vw, 3.1rem);
    font-weight: var(--font-weight-heavy);
    color: var(--color-petrol);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .price-subtitle {
    font-size: 1.05rem;
    color: var(--color-cyan);
    font-weight: 700;
    margin-top: 0.25rem;
  }

  .action-buttons-group {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 0.85rem;
    width: 100%;
  }

  .btn-cotizar-mini {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.95rem 1.4rem;
    border-radius: var(--radius-full);
    background: rgba(var(--rgb-petrol), 0.06);
    color: var(--color-petrol);
    font-size: 1rem;
    font-weight: 700;
    transition: background var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
  }

  .btn-cotizar-mini:hover {
    background: rgba(var(--rgb-petrol), 0.12);
    transform: translateY(-2px);
  }

  .btn-ver-proyecto {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: 100%;
    padding: 0.95rem 1.6rem;
    border-radius: var(--radius-full);
    background: var(--color-petrol);
    color: #FFFFFF !important;
    font-size: 1rem;
    font-weight: 700;
    transition: background var(--transition-fast), transform var(--transition-fast);
  }

  .btn-ver-proyecto:hover {
    background: var(--color-cyan);
    transform: translateY(-2px);
  }

  @media (max-width: 1024px) {
    .luxury-project-card {
      grid-template-columns: 1fr;
    }

    .card-media-wrapper,
    .carousel-track {
      min-height: 400px;
    }

    .card-details {
      padding: 2rem 1.5rem;
    }
  }
</style>
