---
// src/components/layout/Header.astro
// Floating frosted white glass pill navbar estilo Aurvix (Light Mode)

import LogoAMA from '../brand/LogoAMA.astro';
import { u, base } from '../../utils/url';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const rawLinks = [
  { name: 'Inicio', path: '/' },
  { name: 'Proyectos', path: '/proyectos' },
  { name: 'Amenities', path: '/amenities' },
  { name: 'Ofertas', path: '/ofertas' },
  { name: 'Nosotros', path: '/nosotros' },
  { name: 'Postventa', path: '/postventa' },
  { name: 'Blog', path: '/blog' },
  { name: 'Contacto', path: '/contacto' },
];

const navLinks = rawLinks.map((link) => ({
  name: link.name,
  href: u(link.path),
  rawPath: link.path,
}));

const isActive = (rawPath: string) => {
  const normCurrent = currentPath.replace(base, '') || '/';
  if (rawPath === '/' && (normCurrent === '/' || normCurrent === '')) return true;
  if (rawPath !== '/' && normCurrent.startsWith(rawPath)) return true;
  return false;
};
---

<header class="header-floating-wrapper">
  <div class="container header-container">
    <div class="header-floating-bar">
      <!-- Logo de la marca (Variante Oscura para Fondo Claro) -->
      <a href={u('/')} class="brand-link" aria-label="Ir a Inicio - AMA Inmobiliaria">
        <LogoAMA variant="petrol" height={36} />
      </a>

      <!-- Navegación de escritorio (Píldora Centrada) -->
      <nav class="desktop-nav" aria-label="Navegación principal">
        <ul class="nav-list">
          {navLinks.map((link) => (
            <li>
              <a 
                href={link.href} 
                class={`nav-item ${isActive(link.href) ? 'active' : ''}`}
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Acciones directas: Botón Píldora Negro estilo Aurvix -->
      <div class="header-actions">
        <button 
          type="button" 
          class="btn-header-cotizar"
          onclick="window.openCotizadorModal && window.openCotizadorModal()"
          aria-haspopup="dialog"
        >
          <span>Cotizar Online</span>
          <span class="btn-arrow">↗</span>
        </button>

        <!-- Botón menú móvil -->
        <button 
          id="mobile-menu-toggle" 
          class="mobile-toggle" 
          aria-label="Abrir menú" 
          aria-expanded="false"
        >
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Menú móvil desplegable Claro -->
  <div id="mobile-menu-drawer" class="mobile-drawer">
    <div class="mobile-drawer-content">
      <ul class="mobile-nav-list">
        {navLinks.map((link) => (
          <li>
            <a 
              href={link.href} 
              class={`mobile-nav-item ${isActive(link.href) ? 'active' : ''}`}
            >
              {link.name}
            </a>
          </li>
        ))}
      </ul>
      <div class="mobile-drawer-cta">
        <button 
          type="button" 
          class="btn btn-petrol btn-block"
          onclick="window.openCotizadorModal && window.openCotizadorModal(); document.getElementById('mobile-menu-drawer').classList.remove('is-open');"
        >
          Simular y Cotizar Online ↗
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .header-floating-wrapper {
    position: sticky;
    top: 1rem;
    z-index: 500;
    width: 100%;
    pointer-events: none;
  }

  .header-container {
    pointer-events: auto;
  }

  .header-floating-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    padding: 0 1rem 0 1.5rem;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: var(--radius-full);
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.08), 0 2px 6px -1px rgba(0, 0, 0, 0.03);
    transition: all var(--transition-normal);
  }

  .brand-link {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-item {
    font-size: 0.9rem;
    font-weight: 500;
    color: #4B5563;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
    letter-spacing: -0.01em;
  }

  .nav-item:hover {
    color: #111827;
    background: rgba(0, 0, 0, 0.05);
  }

  .nav-item.active {
    color: #0F172A;
    background: rgba(0, 0, 0, 0.06);
    font-weight: 600;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  /* Botón Píldora Negro idéntico a Aurvix "Contact us ↗" */
  .btn-header-cotizar {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1.3rem;
    border-radius: var(--radius-full);
    background: #0F172A;
    color: #FFFFFF;
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.2);
    transition: all var(--transition-fast);
  }

  .btn-header-cotizar:hover {
    background: var(--color-cyan);
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(26, 166, 183, 0.35);
  }

  .btn-arrow {
    font-size: 1.05rem;
    line-height: 1;
    transition: transform var(--transition-fast);
  }

  .btn-header-cotizar:hover .btn-arrow {
    transform: translate(2px, -2px);
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 24px;
    height: 17px;
    background: transparent;
    cursor: pointer;
    margin-left: 0.4rem;
  }

  .hamburger-bar {
    width: 100%;
    height: 2px;
    background-color: #0F172A;
    border-radius: 2px;
    transition: all var(--transition-fast);
  }

  .mobile-drawer {
    display: none;
    position: fixed;
    top: 5.2rem;
    left: 1.5rem;
    right: 1.5rem;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(24px);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: var(--radius-bento);
    padding: 2rem;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.15);
    pointer-events: auto;
  }

  .mobile-drawer.is-open {
    display: block;
    animation: drawerFade 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes drawerFade {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .mobile-nav-item {
    font-size: 1.15rem;
    font-weight: 600;
    color: #111827;
    display: block;
  }

  .mobile-nav-item.active,
  .mobile-nav-item:hover {
    color: var(--color-cyan);
  }

  @media (max-width: 1100px) {
    .desktop-nav {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-menu-drawer');

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = drawer.classList.toggle('is-open');
      toggleBtn.setAttribute('aria-expanded', String(isOpen));
    });
  }
</script>
