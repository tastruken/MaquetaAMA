---
// src/pages/index.astro
// Rediseño 100% fiel a las capturas maestras de Aurvix (Framer Real Estate Template)

import BaseLayout from '../layouts/BaseLayout.astro';
import CardProject from '../components/ui/CardProject.astro';
import HeroFilterBar from '../components/features/HeroFilterBar.astro';
import TrustTicker from '../components/features/TrustTicker.astro';
import BentoOfferings from '../components/features/BentoOfferings.astro';
import JournalCards from '../components/features/JournalCards.astro';
import { u } from '../utils/url';
import '../styles/home.css';
---

<BaseLayout 
  title="AMA Inmobiliaria | Departamentos Nuevos en Santiago"
  description="Desarrollamos proyectos residenciales de vanguardia con alta plusvalía, diseño inteligente y respaldo de postventa. Conoce nuestro proyecto AMA Quillayes."
>
  <!-- 1. HERO LUMINOSO ARQUITECTÓNICO (Full Width Edge-to-Edge AMA Quillayes) -->
  <section class="aurvix-hero">
    <div class="hero-card-banner">
      <!-- Slideshow de fondo (SS) con transición suave entre fotos de Quillayes -->
      <div class="hero-slideshow" id="heroSlideshow">
        <div class="hero-slide active" style={`background-image: url(${u('/images/ama_quillayes_facade.jpg')});`}></div>
        <div class="hero-slide" style={`background-image: url(${u('/images/ama_interior_living.jpg')});`}></div>
        <div class="hero-slide" style={`background-image: url(${u('/images/ama_amenity_rooftop.jpg')});`}></div>
      </div>

      <div class="hero-overlay-gradient"></div>

      <div class="container hero-banner-content">
        <div class="hero-text-row">
          <!-- Columna Izquierda: Títulos Display de Gran Escala y Botones -->
          <div class="hero-headline-col">
            <h1 class="hero-title-aurvix">
              ESPACIOS DE VANGUARDIA<br />
              PARA VIVIR® E INSPIRAR
            </h1>
            <p class="hero-sub-aurvix">
              Departamentos en La Florida de 1 y 2 dormitorios, con terrazas a lo ancho del departamento y financiamiento de hasta 60 cuotas.
            </p>

            <!-- Botones de Acción del Hero -->
            <div class="hero-actions-row">
              <button 
                type="button" 
                class="btn-hero-primary"
                onclick="window.openCotizadorModal && window.openCotizadorModal()"
              >
                <span>Cotizar Online</span>
                <span class="btn-arrow">↗</span>
              </button>
              <a href={u('/proyectos/ama-quillayes')} class="btn-hero-secondary">
                <span>Ver AMA Quillayes</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Indicadores discretos del Slideshow (SS) -->
      <div class="hero-slide-dots" id="heroSlideDots" aria-label="Controles del slideshow">
        <button type="button" class="slide-dot active" data-slide="0" aria-label="Foto 1: Fachada"></button>
        <button type="button" class="slide-dot" data-slide="1" aria-label="Foto 2: Living y Terraza"></button>
        <button type="button" class="slide-dot" data-slide="2" aria-label="Foto 3: Rooftop y Piscina"></button>
      </div>
    </div>
  </section>

  <!-- 2. BARRA DE BÚSQUEDA Y FILTRADO FLOTANTE (Oculta temporalmente hasta tener más proyectos en cartera) -->
  <!--
  <div class="container filter-container-wrap">
    <HeroFilterBar />
  </div>
  -->

  <!-- 3. SECCIÓN EDITORIAL "SOBRE AMA" (Split Layout idéntico a Aurvix) -->
  <section class="section about-split-section">
    <div class="container">
      <div class="about-grid">
        <!-- Foto en proporción elegante con radio de 24px -->
        <div class="about-img-wrap">
          <img 
            src={u('/images/aurvix_space_living.jpg')} 
            alt="Arquitectura y diseño interior AMA" 
            class="about-split-img"
          />
        </div>

        <!-- Texto Editorial de Gran Escala -->
        <div class="about-content">
          <h2 class="about-heading">
            Conectamos a las personas con su hogar ideal a través de un estándar contemporáneo — ayudándote a invertir o vivir con total certeza y respaldo.
          </h2>
          <a href={u('/nosotros')} class="btn-aurvix-dark">
            <span>More About Us</span>
            <span class="arrow">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. ESPACIOS REMOVIDOS DEL HOME (Bento grid, métricas y categorías de tipologías) -->

  <!-- 6. PROYECTOS DESTACADOS -->
  <section class="section projects-aurvix-section" id="proyectos-activos">
    <div class="container">
      <div class="section-header-split">
        <div>
          <h2 class="section-title aurvix-projects-title">Construidos con propósito, diseñados para la vida moderna</h2>
        </div>
        <a href={u('/proyectos/ama-quillayes')} class="btn-aurvix-dark">
          <span>Ver proyecto AMA Quillayes</span>
          <span class="arrow">↗</span>
        </a>
      </div>

      <div class="featured-projects-grid">
        <CardProject
          title="AMA Quillayes"
          slug="ama-quillayes"
          location="Av. Vicuña Mackenna 11.600 / Metro Los Quillayes / La Florida"
          priceFrom="2.540 UF"
          typology="1 y 2 dormitorios"
          status="En Verde"
          dorms="1 y 2 Dormitorios"
          baths="1 y 2 Baños"
          surface="34 a 66 m²"
          delivery="Entrega Estimada: Diciembre 2028"
          priceSubtitle="Pie en hasta 60 cuotas"
          image="/images/ama_quillayes_facade.jpg"
        />

        <!-- Segundo proyecto (AMA La Florida II): oculto hasta su lanzamiento.
             Para mostrarlo, eliminar el atributo `hidden`. -->
        <div class="next-project-card" hidden>
          <div class="next-project-tags">
            <span class="next-tag-dark">Próximo Lanzamiento</span>
            <span class="next-tag-coral">Preventa 2026</span>
          </div>
          <h3 class="next-project-title">AMA La Florida II</h3>
          <p class="next-project-desc">
            Nuevo desarrollo residencial con concepto de eficiencia energética, terraza rooftop panorámica, piscina lounge y departamentos tipo estudio y 2 dormitorios.
          </p>
          <ul class="next-project-specs">
            <li><span>Comuna:</span><strong>La Florida, Santiago</strong></li>
            <li><span>Estado:</span><strong>Inscripción en Blanco</strong></li>
            <li><span>Beneficio:</span><strong class="coral">Lista Cero Preventa</strong></li>
          </ul>
          <a href={u('/contacto')} class="next-project-btn">Inscribirme en Preventa Exclusiva ↗</a>
        </div>
      </div>
    </div>
  </section>


  <!-- 8. SERVICIOS Y PROPUESTA DE VALOR (Idéntico a what_we_offer_cards_1789940642828.png) -->
  <BentoOfferings />



  <!-- 11. CINTA DE ALIANZAS BANCARIAS Y RESPALDO -->
  <TrustTicker />


  <!-- 13. JOURNAL / BLOG -->
  <JournalCards />

  <!-- Script Slideshow Hero (SS) -->
  <script>
    const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
    const dots = document.querySelectorAll<HTMLElement>('.slide-dot');
    let currentSlide = 0;
    let slideTimer: ReturnType<typeof setInterval> | null = null;

    function goToSlide(index: number) {
      if (!slides.length) return;
      slides[currentSlide]?.classList.remove('active');
      dots[currentSlide]?.classList.remove('active');
      currentSlide = (index + slides.length) % slides.length;
      slides[currentSlide]?.classList.add('active');
      dots[currentSlide]?.classList.add('active');
    }

    function startSlideshow() {
      stopSlideshow();
      slideTimer = setInterval(() => {
        goToSlide(currentSlide + 1);
      }, 5500);
    }

    function stopSlideshow() {
      if (slideTimer) clearInterval(slideTimer);
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        const targetIndex = parseInt((e.currentTarget as HTMLElement).getAttribute('data-slide') || '0', 10);
        goToSlide(targetIndex);
        startSlideshow();
      });
    });

    if (slides.length > 1) {
      startSlideshow();
    }
  </script>
</BaseLayout>
