---
import BaseLayout from '../layouts/BaseLayout.astro';
import ModernCTA from '../components/features/ModernCTA.astro';
import { u } from '../utils/url';
import '../styles/home.css';
import '../styles/inner-pages.css';

const warranties = [
  {
    kicker: 'Desde Recepción Municipal',
    big: '10 Años',
    title: 'Garantía Estructural',
    desc: 'Cubre fallas o defectos que comprometan la estructura soportante del edificio conforme a la Ley General de Urbanismo y Construcciones (Ley N° 20.016).',
    checks: ['Fundaciones y cimientos', 'Muros estructurales y pilares de hormigón', 'Losas, vigas y techumbres principales']
  },
  {
    kicker: 'Desde Recepción Municipal',
    big: '5 Años',
    title: 'Elementos Constructivos e Instalaciones',
    desc: 'Respalda el correcto funcionamiento de las redes matrices e instalaciones constructivas interiores y comunitarias del edificio.',
    checks: ['Redes de agua potable y alcantarillado', 'Canalizaciones eléctricas y corrientes débiles', 'Ductos de extracción e impermeabilizaciones']
  },
  {
    kicker: 'Desde Inscripción en CBR',
    big: '3 Años',
    title: 'Terminaciones y Acabados',
    desc: 'Protege los elementos de acabado superficial e interior de tu departamento desde su inscripción en el Conservador de Bienes Raíces.',
    checks: ['Puertas, quincallería y ventanas termopanel', 'Muebles de cocina, cubiertas y griferías', 'Revestimientos cerámicos, pisos y pintura']
  }
];

const faqs = [
  {
    q: '¿Cómo ingreso un requerimiento de postventa?',
    a: 'Puedes completarlo directamente en el formulario en línea de esta página o escribir a postventa@amainmobiliaria.cl indicando tu RUT, proyecto, número de unidad y una breve descripción del caso.'
  },
  {
    q: '¿Cuáles son los plazos legales de garantía en Chile?',
    a: 'De acuerdo a la Ley N° 20.016: 3 años para terminaciones desde la inscripción en el Conservador de Bienes Raíces, 5 años para instalaciones y elementos constructivos, y 10 años para la estructura soportante desde la recepción municipal definitiva.'
  },
  {
    q: '¿Cuánto tiempo tarda la visita técnica tras enviar mi solicitud?',
    a: 'Nuestro equipo de postventa toma contacto en un plazo máximo de 48 horas hábiles para coordinar la visita de inspección técnica en el horario que más te acomode.'
  },
  {
    q: '¿Qué situaciones quedan excluidas de la garantía?',
    a: 'El desgaste natural por uso habitual, intervenciones o remodelaciones ejecutadas por terceros no autorizados, falta de mantención preventiva indicada en el Manual del Propietario o daños fortuitos.'
  },
  {
    q: '¿Qué hacer ante una urgencia fuera de horario hábil?',
    a: 'En caso de filtración mayor o corte general de suministro, comunícate de inmediato con la conserjería de la comunidad para activar el protocolo de emergencia con la administración y el equipo de turno de AMA.'
  }
];
---

<BaseLayout 
  title="Servicio de Postventa y Garantías | AMA Inmobiliaria"
  description="Servicio técnico y garantías post-entrega para propietarios de AMA Inmobiliaria. Ingresa tu requerimiento de soporte o consulta los plazos de garantía legal."
>
  <!-- 1. HERO CINEMATOGRÁFICO -->
  <section class="aurvix-hero ip-hero">
    <div class="hero-card-banner">
      <div class="hero-slideshow">
        <div class="hero-slide active" style={`background-image: url(${u('/images/ama_piloto_cocina_quillayes.jpg')});`}></div>
      </div>

      <div class="hero-overlay-gradient"></div>

      <div class="container hero-banner-content">
        <div class="hero-text-row">
          <div class="hero-headline-col">
            <h1 class="hero-title-aurvix">
              RESPALDO TÉCNICO Y<br />
              GARANTÍA DE POSTVENTA
            </h1>
            <p class="hero-sub-aurvix">
              Nuestra relación no termina con la entrega de llaves. Te acompañamos con un equipo técnico propio, protocolos claros y cumplimiento riguroso de garantías.
            </p>

            <div class="hero-actions-row">
              <a href="#formulario-postventa" class="btn-hero-primary">
                <span>Ingresar Requerimiento</span>
                <span class="btn-arrow">↗</span>
              </a>
              <a href="#garantias-legales" class="btn-hero-secondary">
                <span>Ver Plazos de Garantía</span>
              </a>
            </div>
          </div>
        </div>

        <div class="ip-glass-bar">
          <div class="ip-glass-chip">
            <span class="ip-glass-val">10 Años</span>
            <span class="ip-glass-txt">Garantía estructural</span>
          </div>
          <div class="ip-glass-div"></div>
          <div class="ip-glass-chip">
            <span class="ip-glass-val">5 Años</span>
            <span class="ip-glass-txt">Instalaciones y redes</span>
          </div>
          <div class="ip-glass-div"></div>
          <div class="ip-glass-chip">
            <span class="ip-glass-val">3 Años</span>
            <span class="ip-glass-txt">Terminaciones</span>
          </div>
          <div class="ip-glass-div"></div>
          <div class="ip-glass-chip">
            <span class="ip-glass-val">48 Horas</span>
            <span class="ip-glass-txt">Tiempo de contacto</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. GARANTÍAS LEGALES (FILAS EDITORIALES) -->
  <section class="ip-section" id="garantias-legales">
    <div class="container">
      <div class="ip-head is-left">
        <h2 class="ip-title">Plazos y cobertura de garantía legal</h2>
        <p class="ip-desc">
          Protegemos tu patrimonio bajo el marco estricto de la Ley General de Urbanismo y Construcciones (Ley N° 20.016).
        </p>
      </div>

      <div class="ip-rows">
        {warranties.map((w) => (
          <div class="ip-row">
            <div class="ip-row-meta">
              <span class="ip-row-label">{w.kicker}</span>
              <span class="ip-row-big">{w.big}</span>
            </div>
            <div>
              <h3 class="ip-row-title">{w.title}</h3>
              <p class="ip-row-text">{w.desc}</p>
              <ul class="ip-row-checks">
                {w.checks.map((ch) => (
                  <li>{ch}</li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. INGRESO DE SOLICITUD Y CANALES DE ATENCIÓN (UNIFIED SPLIT CARD) -->
  <section class="ip-section is-canvas" id="formulario-postventa">
    <div class="container">
      <div class="ip-head">
        <h2 class="ip-title">Ingresa tu solicitud de postventa</h2>
        <p class="ip-desc">
          Registra los datos de tu departamento para coordinar la visita de diagnóstico con un supervisor técnico de AMA.
        </p>
      </div>

      <div class="ip-split is-even is-top">
        <!-- Columna Izquierda: Protocolo y Canales Directos -->
        <div class="ip-split-info">
          <div>
            <span class="ip-kicker">Atención al Propietario</span>
            <h3 class="ip-card-title">Acompañamiento técnico directo y transparente</h3>
            <p class="ip-card-text">
              Cada solicitud recibe un número de ticket único para hacer seguimiento desde el diagnóstico inicial hasta el cierre conforme de los trabajos en tu unidad.
            </p>

            <div class="ip-specs is-single" style="margin-top: 2rem;">
              <div class="ip-spec">
                <div class="ip-spec-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
                <div class="ip-spec-info">
                  <span class="ip-spec-label">Tiempo de respuesta inicial</span>
                  <strong class="ip-spec-val">Máximo 48 horas hábiles para agendar inspección</strong>
                </div>
              </div>

              <div class="ip-spec">
                <div class="ip-spec-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </div>
                <div class="ip-spec-info">
                  <span class="ip-spec-label">Correo oficial de soporte</span>
                  <strong class="ip-spec-val"><a href="mailto:postventa@amainmobiliaria.cl">postventa@amainmobiliaria.cl</a></strong>
                </div>
              </div>

              <div class="ip-spec">
                <div class="ip-spec-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </div>
                <div class="ip-spec-info">
                  <span class="ip-spec-label">Central de propietarios (Lun–Vie 09:00 a 18:00)</span>
                  <strong class="ip-spec-val"><a href="tel:+56987654321">+56 9 8765 4321</a></strong>
                </div>
              </div>

              <div class="ip-spec">
                <div class="ip-spec-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                </div>
                <div class="ip-spec-info">
                  <span class="ip-spec-label">Cierre de requerimiento</span>
                  <strong class="ip-spec-val">Firma de acta de conformidad del propietario</strong>
                </div>
              </div>
            </div>
          </div>

          <div class="ip-card-footer">
            <div>
              <span class="ip-footer-label">Atención de urgencias</span>
              <div class="ip-footer-value" style="font-size: 1.15rem;">Coordinación directa con Conserjería 24/7</div>
            </div>
          </div>
        </div>

        <!-- Columna Derecha: Formulario de Requerimiento -->
        <div>
          <form class="ip-form" id="postventa-form">
            <div class="ip-form-row">
              <div class="ip-field">
                <label class="ip-label" for="pv-nombre">Nombre y Apellido *</label>
                <input type="text" id="pv-nombre" required placeholder="Ej: Camila Soto" class="ip-input" />
              </div>
              <div class="ip-field">
                <label class="ip-label" for="pv-rut">RUT del Propietario *</label>
                <input type="text" id="pv-rut" required placeholder="Ej: 12.345.678-9" class="ip-input" />
              </div>
            </div>

            <div class="ip-form-row">
              <div class="ip-field">
                <label class="ip-label" for="pv-email">Correo Electrónico *</label>
                <input type="email" id="pv-email" required placeholder="tu@correo.cl" class="ip-input" />
              </div>
              <div class="ip-field">
                <label class="ip-label" for="pv-telefono">Teléfono de Contacto *</label>
                <input type="tel" id="pv-telefono" required placeholder="+56 9 1234 5678" class="ip-input" />
              </div>
            </div>

            <div class="ip-form-row">
              <div class="ip-field">
                <label class="ip-label" for="pv-proyecto">Proyecto *</label>
                <select id="pv-proyecto" class="ip-select" required>
                  <option value="AMA Quillayes">Edificio AMA Quillayes</option>
                  <option value="Otro proyecto AMA">Otro desarrollo entregado por AMA</option>
                </select>
              </div>
              <div class="ip-field">
                <label class="ip-label" for="pv-depto">N° de Unidad / Bodega *</label>
                <input type="text" id="pv-depto" required placeholder="Ej: Depto 504 - Bodega 12" class="ip-input" />
              </div>
            </div>

            <div class="ip-field">
              <label class="ip-label" for="pv-tipo">Categoría Técnica *</label>
              <select id="pv-tipo" class="ip-select" required>
                <option value="Terminaciones">Terminaciones (Pintura, guardapolvos, sellos)</option>
                <option value="Gasfitería">Gasfitería y Sanitario (Grifería, desagüe, sifón)</option>
                <option value="Electricidad">Electricidad (Enchufes, tablero, luminaria)</option>
                <option value="Cerrajería y Ventanas">Cerrajería, Puertas o Ventanas Termopanel</option>
                <option value="Equipamiento Cocina">Horno, Encimera o Campana</option>
                <option value="Otro">Otro requerimiento técnico</option>
              </select>
            </div>

            <div class="ip-field">
              <label class="ip-label" for="pv-desc">Descripción del Requerimiento *</label>
              <textarea
                id="pv-desc"
                rows="4"
                required
                placeholder="Indica el recinto (living, baño principal, terraza) y detalla la observación..."
                class="ip-textarea"
              ></textarea>
            </div>

            <div class="ip-actions" style="margin-top: 0.5rem;">
              <button type="submit" class="btn-aurvix-dark">
                <span>Enviar Solicitud a Postventa</span>
                <span class="arrow">↗</span>
              </button>
            </div>

            <div id="pv-success" class="ip-success">
              <strong>Solicitud N° PV-2026-084 registrada exitosamente.</strong> Hemos enviado un comprobante a tu correo y un supervisor técnico te contactará dentro de las próximas 48 horas hábiles.
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. PREGUNTAS FRECUENTES DE POSTVENTA -->
  <section class="ip-section">
    <div class="container">
      <div class="ip-head">
        <h2 class="ip-title">Preguntas frecuentes de postventa</h2>
        <p class="ip-desc">
          Todo lo que necesitas saber sobre coberturas, mantención preventiva y visitas técnicas.
        </p>
      </div>

      <div class="ip-faq">
        {faqs.map((f, i) => (
          <details class="ip-faq-item" open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. BANNER CTA -->
  <ModernCTA />
</BaseLayout>

<script>
  const pvForm = document.getElementById('postventa-form') as HTMLFormElement | null;
  const pvSuccess = document.getElementById('pv-success');

  if (pvForm && pvSuccess) {
    pvForm.addEventListener('submit', (e) => {
      e.preventDefault();
      pvSuccess.classList.add('is-visible');
      pvForm.reset();
      pvSuccess.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  }
</script>
