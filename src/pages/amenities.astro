---
import BaseLayout from '../layouts/BaseLayout.astro';
import PatternDrops from '../components/brand/PatternDrops.astro';

const standards = [
  {
    title: 'Aislación Térmica & Termopanel',
    category: 'Eficiencia y Confort',
    desc: 'Ventanas de PVC con doble vidriado hermético (termopanel) y muros perimetrales con aislante EIFS de alta densidad. Menor gasto en calefacción y máxima aislación del ruido exterior.'
  },
  {
    title: 'Cubiertas de Cuarzo & Cocinas Full Equipadas',
    category: 'Terminaciones Nobles',
    desc: 'Superficies no porosas, antibacterianas y de alta resistencia a manchas. Encimera vitrocerámica, horno empotrado y campana retráctil de acero inoxidable.'
  },
  {
    title: 'Pisos Fotolaminados SPC Waterproof',
    category: 'Durabilidad',
    desc: 'Pisos de polímero de piedra (SPC) 100% resistentes al agua y al alto tráfico, que no se deforman ni requieren vitrificados costosos.'
  },
  {
    title: 'Eficiencia en Gastos Comunes',
    category: 'Sustentabilidad',
    desc: 'Equipamiento de bajo consumo hídrico y eléctrico: iluminación LED en todos los espacios comunes con sensores de presencia y bombas de agua de velocidad variable.'
  }
];

const amenityConcepts = [
  {
    icon: '💼',
    name: 'Coworking Profesional',
    desc: 'Salas de trabajo con conectividad dedicada de alta velocidad, mobiliario ergonómico y cabinas acústicas para llamadas.'
  },
  {
    icon: '🏊',
    name: 'Piscina & Rooftop Panorámico',
    desc: 'Espacios de relajación en las alturas, diseñados para aprovechar el sol y la vista limpia a la cordillera.'
  },
  {
    icon: '🥩',
    name: 'Quinchos & Salas Gourmet',
    desc: 'Equipados con parrillas de nivel profesional y vajilla completa para reuniones sociales sin invadir tu departamento.'
  },
  {
    icon: '🐾',
    name: 'Pet Spa & Espacio Canino',
    desc: 'Entendemos que las mascotas son parte de tu familia. Áreas de juego seguro y tinas de lavado especializadas.'
  },
  {
    icon: '🚴',
    name: 'Movilidad Sustentable',
    desc: 'Bicicleteros amplios bajo techo con estación de inflado y herramientas para mantención básica.'
  },
  {
    icon: '📦',
    name: 'E-Commerce Smart Lockers',
    desc: 'Casilleros inteligentes para recibir paquetes y compras por internet con total seguridad las 24 horas.'
  }
];
---

<BaseLayout 
  title="Amenities y Estándar de Calidad | AMA Inmobiliaria"
  description="Descubre el estándar constructivo y la filosofía de diseño de AMA Inmobiliaria. Terminaciones premium, eficiencia energética y espacios comunes inteligentes."
>
  <section class="page-hero section-petrol">
    <PatternDrops color="#1AA6B7" opacity={0.06} />
    <div class="container relative-z text-center">
      <span class="badge badge-cyan">Filosofía Constructiva</span>
      <h1 class="page-title">Estándar de Calidad & Espacios Comunes</h1>
      <p class="page-subtitle">
        En <strong>AMA Inmobiliaria</strong> los amenities no son adornos de folleto; son una verdadera extensión de tu hogar diseñada para enriquecer tu calidad de vida.
      </p>
    </div>
  </section>

  <!-- FILOSOFÍA DE AMENITIES -->
  <section class="section section-cream">
    <div class="container">
      <div class="intro-box">
        <div class="intro-content">
          <span class="badge badge-petrol">El Concepto</span>
          <h2 class="intro-title">Espacios que generan comunidad y valor patrimonial</h2>
          <p class="intro-text">
            Cada metro cuadrado común de un proyecto AMA se concibe con dos objetivos innegociables: <strong>alta frecuencia de uso</strong> y <strong>bajo costo de mantención</strong>. De esta manera, garantizamos que los espacios sigan luciendo como el primer día sin disparar el cobro del gasto común.
          </p>
        </div>
        <div class="intro-highlight">
          <div class="stat-highlight">
            <strong>100%</strong>
            <span>Amenities operativos desde el día de entrega</span>
          </div>
        </div>
      </div>

      <div class="concepts-grid">
        {amenityConcepts.map((c) => (
          <div class="concept-card card">
            <span class="concept-icon">{c.icon}</span>
            <h3 class="concept-name">{c.name}</h3>
            <p class="concept-desc">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ESTÁNDAR CONSTRUCTIVO -->
  <section class="section section-white">
    <div class="container">
      <div class="section-header text-center">
        <span class="badge badge-cyan">Ingeniería & Terminaciones</span>
        <h2 class="section-title">El Estándar Constructivo AMA</h2>
        <p class="section-desc">Detalles técnicos que marcan la diferencia entre una construcción común y un hogar duradero.</p>
      </div>

      <div class="standards-grid">
        {standards.map((s) => (
          <div class="standard-card card">
            <span class="s-category">{s.category}</span>
            <h3 class="s-title">{s.title}</h3>
            <p class="s-desc">{s.desc}</p>
          </div>
        ))}
      </div>

      <div class="amenity-cta-wrap text-center">
        <p class="cta-lead">
          ¿Quieres ver estos amenities y terminaciones en un proyecto concreto?
        </p>
        <div class="cta-btns">
          <a href="/proyectos/ama-quillayes" class="btn btn-cyan">
            Ver Amenities en AMA Quillayes
          </a>
          <button 
            type="button" 
            class="btn btn-outline"
            onclick="window.openCotizadorModal && window.openCotizadorModal()"
          >
            Simular Financiamiento
          </button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    position: relative;
    padding: 5.5rem 0 5rem;
  }

  .relative-z {
    position: relative;
    z-index: 2;
  }

  .page-title {
    color: var(--color-cream);
    margin: 0.8rem 0;
  }

  .page-subtitle {
    max-width: 720px;
    margin: 0 auto;
    color: var(--text-on-dark-muted);
    font-size: 1.15rem;
  }

  .intro-box {
    background: #FFFFFF;
    border-radius: var(--radius-xl);
    padding: 3rem;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
    align-items: center;
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-sm);
    margin-bottom: 3.5rem;
  }

  .intro-title {
    margin: 0.6rem 0 1rem;
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
  }

  .intro-text {
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .intro-highlight {
    background: var(--color-cream);
    border-radius: var(--radius-lg);
    padding: 2.5rem 2rem;
    text-align: center;
    border: 1.5px dashed var(--border-medium);
  }

  .stat-highlight strong {
    font-size: 3.2rem;
    font-weight: var(--font-weight-heavy);
    color: var(--color-cyan);
    display: block;
    line-height: 1;
  }

  .stat-highlight span {
    font-size: 0.95rem;
    color: var(--color-petrol);
    font-weight: var(--font-weight-semibold);
    margin-top: 0.5rem;
    display: block;
  }

  .concepts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .concept-card {
    padding: 2.2rem;
    transition: transform var(--transition-fast);
  }

  .concept-icon {
    font-size: 2.2rem;
    display: block;
    margin-bottom: 0.75rem;
  }

  .concept-name {
    font-size: 1.25rem;
    color: var(--color-petrol);
    margin-bottom: 0.6rem;
  }

  .concept-desc {
    font-size: 0.92rem;
    line-height: 1.55;
  }

  /* STANDARDS */
  .standards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .standard-card {
    padding: 2.5rem;
    border-left: 4px solid var(--color-cyan);
  }

  .s-category {
    font-size: 0.8rem;
    color: var(--color-cyan);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .s-title {
    font-size: 1.35rem;
    color: var(--color-petrol);
    margin: 0.4rem 0 0.85rem;
  }

  .s-desc {
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .amenity-cta-wrap {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border-medium);
  }

  .cta-lead {
    font-size: 1.2rem;
    color: var(--color-petrol);
    font-weight: var(--font-weight-semibold);
    margin-bottom: 1.5rem;
  }

  .cta-btns {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 992px) {
    .intro-box {
      grid-template-columns: 1fr;
    }
    .concepts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .standards-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .concepts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
