---
import BaseLayout from '../layouts/BaseLayout.astro';
import ModernCTA from '../components/features/ModernCTA.astro';
import { u } from '../utils/url';
import '../styles/home.css';
import '../styles/inner-pages.css';

const campaigns = [
  {
    id: 'bono-pie',
    tabLabel: 'Bono Pie 10%',
    kicker: 'Beneficio Comercial Directo',
    title: 'Bono Pie de hasta un 10%',
    desc: 'Bonificamos hasta un 10% del valor total del departamento para que lo presentes como parte de tu pie bancario, reduciendo al mínimo tu desembolso inicial y facilitando la aprobación hipotecaria.',
    image: u('/images/ama_quillayes_facade.jpg'),
    highlightLabel: 'Ahorro directo estimado',
    highlightValue: 'Hasta 400 UF',
    specs: [
      { label: 'Cobertura', val: 'Hasta 10% del valor UF' },
      { label: 'Proyecto activo', val: 'Edificio AMA Quillayes' },
      { label: 'Tipologías', val: 'Unidades 1D y 2D seleccionadas' },
      { label: 'Combinable con', val: 'Pago de pie en cuotas' }
    ],
    checks: ['Descuento directo en promesa', 'Menor exigencia de liquidez inicial', 'Aplica para vivienda e inversión']
  },
  {
    id: 'cuotas-pie',
    tabLabel: 'Pie en hasta 60 Cuotas',
    kicker: 'Flexibilidad Financiera',
    title: 'Tu pie en hasta 60 cuotas sin interés',
    desc: 'Fracciona el pago del pie durante el período de construcción y más allá de la entrega, con cuotas mensuales fijas y sin recargos financieros para ordenar tu flujo de caja con tranquilidad.',
    image: u('/images/ama_interior_living.jpg'),
    highlightLabel: 'Cuota mensual referencial',
    highlightValue: 'Desde $250.000 / mes',
    specs: [
      { label: 'Plazo máximo', val: 'Hasta 60 cuotas mensuales' },
      { label: 'Tasa de interés', val: '0% interés directo' },
      { label: 'Medios de pago', val: 'PAC, transferencia o tarjeta' },
      { label: 'Respaldo legal', val: 'Póliza de venta en verde' }
    ],
    checks: ['Sin evaluación bancaria para el pie', 'Cuotas adaptadas a tu capacidad mensual', '100% respaldado por póliza de garantía']
  },
  {
    id: 'garantia-arriendo',
    tabLabel: 'Garantía de Arriendo',
    kicker: 'Especial Inversionistas',
    title: 'Garantía de arriendo por 12 meses',
    desc: 'Aseguramos el flujo mensual de tu inversión durante el primer año desde la recepción del departamento, incluyendo búsqueda de arrendatario calificado y administración profesional.',
    image: u('/images/ama_amenity_rooftop.jpg'),
    highlightLabel: 'Flujo garantizado',
    highlightValue: '12 meses continuos',
    specs: [
      { label: 'Duración', val: '1 año desde la entrega' },
      { label: 'Administración', val: 'Gestión integral incluida' },
      { label: 'Unidades elegibles', val: 'Modelos 1D+1B y 2D+1B' },
      { label: 'Vacancia', val: 'Riesgo cero el primer año' }
    ],
    checks: ['El dividendo se cubre desde el primer mes', 'Selección rigurosa de arrendatario', 'Administración delegada sin estrés']
  },
  {
    id: 'cesion-promesa',
    tabLabel: 'Cesión a Costo $0',
    kicker: 'Liquidez Patrimonial',
    title: 'Cesión de promesa sin costo ni comisión',
    desc: 'Si compras en etapa temprana para capturar la plusvalía de construcción y decides transferir tu promesa a un tercero antes de escriturar, no cobramos multas ni gastos administrativos.',
    image: u('/images/ama_piloto_cocina_quillayes.jpg'),
    highlightLabel: 'Comisión por cesión',
    highlightValue: '$0 Costo Administrativo',
    specs: [
      { label: 'Costo de traspaso', val: '100% liberado ($0)' },
      { label: 'Ventana de solicitud', val: 'Hasta 60 días pre-recepción' },
      { label: 'Plusvalía capturada', val: '100% para el promitente' },
      { label: 'Gestión legal', val: 'Acompañamiento notarial AMA' }
    ],
    checks: ['Salida flexible antes de escriturar', 'Captura la plusvalía de venta en verde', 'Trámite ágil con nuestro equipo legal']
  }
];
---

<BaseLayout 
  title="Ofertas y Beneficios Comerciales | AMA Inmobiliaria"
  description="Conoce los beneficios comerciales vigentes en AMA Quillayes: Bono Pie 10%, pago de pie en hasta 60 cuotas sin interés, garantía de arriendo y cesión a costo $0."
>
  <!-- 1. HERO CINEMATOGRÁFICO UNIFICADO -->
  <section class="aurvix-hero ip-hero">
    <div class="hero-card-banner">
      <div class="hero-slideshow">
        <div class="hero-slide active" style={`background-image: url(${u('/images/ama_quillayes_facade.jpg')});`}></div>
      </div>

      <div class="hero-overlay-gradient"></div>

      <div class="container hero-banner-content">
        <div class="hero-text-row">
          <div class="hero-headline-col">
            <h1 class="hero-title-aurvix">
              BENEFICIOS REALES PARA<br />
              DECIDIR CON CALMA
            </h1>
            <p class="hero-sub-aurvix">
              Estructuramos condiciones comerciales claras y combinables en <strong>AMA Quillayes</strong> para que dar el paso a tu nuevo hogar o inversión sea liviano, transparente y seguro.
            </p>

            <div class="hero-actions-row">
              <button 
                type="button" 
                class="btn-hero-primary"
                onclick="window.openCotizadorModal && window.openCotizadorModal()"
              >
                <span>Simular con Beneficios</span>
                <span class="btn-arrow">↗</span>
              </button>
              <a href="#campanas-vigentes" class="btn-hero-secondary">
                <span>Explorar Campañas</span>
              </a>
            </div>
          </div>
        </div>

        <div class="ip-glass-bar">
          <div class="ip-glass-chip">
            <span class="ip-glass-val">10%</span>
            <span class="ip-glass-txt">Bono Pie Comercial</span>
          </div>
          <div class="ip-glass-div"></div>
          <div class="ip-glass-chip">
            <span class="ip-glass-val">60 Cuotas</span>
            <span class="ip-glass-txt">Pago de pie sin interés</span>
          </div>
          <div class="ip-glass-div"></div>
          <div class="ip-glass-chip">
            <span class="ip-glass-val">12 Meses</span>
            <span class="ip-glass-txt">Arriendo garantizado</span>
          </div>
          <div class="ip-glass-div"></div>
          <div class="ip-glass-chip">
            <span class="ip-glass-val">Costo $0</span>
            <span class="ip-glass-txt">Cesión de promesa</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. EXPLORADOR DE CAMPAÑAS (SPLIT CARD + PILL TABS) -->
  <section class="ip-section is-canvas" id="campanas-vigentes">
    <div class="container">
      <div class="ip-head">
        <h2 class="ip-title">Campañas vigentes en AMA Quillayes</h2>
        <p class="ip-desc">
          Selecciona cada beneficio para conocer en detalle cómo se aplica a tu compra o estrategia de inversión.
        </p>
      </div>

      <!-- Selector Pill idéntico a Tipologías -->
      <div class="ip-tabs-bar">
        <div class="ip-tabs-pill" role="tablist" aria-label="Campañas vigentes">
          {campaigns.map((c, idx) => (
            <button
              type="button"
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
              class={`ip-tab-btn ${idx === 0 ? 'active' : ''}`}
              data-campaign-idx={idx}
            >
              {c.tabLabel}
            </button>
          ))}
        </div>
      </div>

      <!-- Tarjeta Split Unificada -->
      <div class="ip-split">
        <div class="ip-split-media">
          <img
            id="camp-img"
            src={campaigns[0].image}
            alt={campaigns[0].title}
          />
        </div>

        <div class="ip-split-info">
          <div>
            <span class="ip-kicker" id="camp-kicker">{campaigns[0].kicker}</span>
            <h3 class="ip-card-title" id="camp-title">{campaigns[0].title}</h3>
            <p class="ip-card-text" id="camp-desc">{campaigns[0].desc}</p>

            <!-- Specs abiertos con íconos SVG limpios (sin cajas anidadas) -->
            <div class="ip-specs">
              <div class="ip-spec">
                <div class="ip-spec-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
                <div class="ip-spec-info">
                  <span class="ip-spec-label" id="camp-spec-label-0">{campaigns[0].specs[0].label}</span>
                  <strong class="ip-spec-val" id="camp-spec-val-0">{campaigns[0].specs[0].val}</strong>
                </div>
              </div>

              <div class="ip-spec">
                <div class="ip-spec-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-4"/></svg>
                </div>
                <div class="ip-spec-info">
                  <span class="ip-spec-label" id="camp-spec-label-1">{campaigns[0].specs[1].label}</span>
                  <strong class="ip-spec-val" id="camp-spec-val-1">{campaigns[0].specs[1].val}</strong>
                </div>
              </div>

              <div class="ip-spec">
                <div class="ip-spec-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
                </div>
                <div class="ip-spec-info">
                  <span class="ip-spec-label" id="camp-spec-label-2">{campaigns[0].specs[2].label}</span>
                  <strong class="ip-spec-val" id="camp-spec-val-2">{campaigns[0].specs[2].val}</strong>
                </div>
              </div>

              <div class="ip-spec">
                <div class="ip-spec-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                </div>
                <div class="ip-spec-info">
                  <span class="ip-spec-label" id="camp-spec-label-3">{campaigns[0].specs[3].label}</span>
                  <strong class="ip-spec-val" id="camp-spec-val-3">{campaigns[0].specs[3].val}</strong>
                </div>
              </div>
            </div>
          </div>

          <div class="ip-card-footer">
            <div>
              <span class="ip-footer-label" id="camp-hl-label">{campaigns[0].highlightLabel}</span>
              <div class="ip-footer-value" id="camp-hl-val">{campaigns[0].highlightValue}</div>
            </div>

            <div class="ip-actions">
              <button
                type="button"
                class="btn-aurvix-dark"
                onclick="window.openCotizadorModal && window.openCotizadorModal()"
              >
                <span>Aplicar este Beneficio</span>
                <span class="arrow">↗</span>
              </button>
              <a href={u('/proyectos/ama-quillayes')} class="ip-btn-ghost">
                <span>Ver Proyecto</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. RESUMEN COMPARATIVO DE CONDICIONES (FILAS EDITORIALES) -->
  <section class="ip-section">
    <div class="container">
      <div class="ip-head is-left">
        <h2 class="ip-title">Todas las facilidades de un vistazo</h2>
        <p class="ip-desc">
          Nuestros asesores financieros analizan tu perfil para combinar estas herramientas y lograr el dividendo y flujo más conveniente.
        </p>
      </div>

      <div class="ip-rows">
        {campaigns.map((c) => (
          <div class="ip-row">
            <div class="ip-row-meta">
              <span class="ip-row-label">{c.kicker}</span>
              <span class="ip-row-big">{c.highlightValue}</span>
            </div>
            <div>
              <h3 class="ip-row-title">{c.title}</h3>
              <p class="ip-row-text">{c.desc}</p>
              <ul class="ip-row-checks">
                {c.checks.map((ch) => (
                  <li>{ch}</li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. BANNER CTA INSTITUCIONAL -->
  <ModernCTA />
</BaseLayout>

<script define:vars={{ campaigns }}>
  const tabBtns = document.querySelectorAll('[data-campaign-idx]');
  const imgEl = document.getElementById('camp-img');
  const kickerEl = document.getElementById('camp-kicker');
  const titleEl = document.getElementById('camp-title');
  const descEl = document.getElementById('camp-desc');
  const hlLabelEl = document.getElementById('camp-hl-label');
  const hlValEl = document.getElementById('camp-hl-val');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = Number(btn.getAttribute('data-campaign-idx'));
      const data = campaigns[idx];
      if (!data) return;

      tabBtns.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      if (imgEl) {
        imgEl.classList.add('fade');
        setTimeout(() => {
          imgEl.src = data.image;
          imgEl.alt = data.title;
          imgEl.classList.remove('fade');
        }, 160);
      }

      if (kickerEl) kickerEl.textContent = data.kicker;
      if (titleEl) titleEl.textContent = data.title;
      if (descEl) descEl.textContent = data.desc;
      if (hlLabelEl) hlLabelEl.textContent = data.highlightLabel;
      if (hlValEl) hlValEl.textContent = data.highlightValue;

      data.specs.forEach((s, i) => {
        const lEl = document.getElementById(`camp-spec-label-${i}`);
        const vEl = document.getElementById(`camp-spec-val-${i}`);
        if (lEl) lEl.textContent = s.label;
        if (vEl) vEl.textContent = s.val;
      });
    });
  });
</script>
