---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQAccordion from '../components/features/FAQAccordion.astro';
import ModernCTA from '../components/features/ModernCTA.astro';
import { u } from '../utils/url';
import '../styles/home.css';
import '../styles/inner-pages.css';
---

<BaseLayout 
  title="Contacto y Sala de Ventas | AMA Inmobiliaria"
  description="Ponte en contacto con nuestro equipo comercial o visita la sala de ventas de AMA Quillayes en Av. Vicuña Mackenna 11.600, La Florida."
>
  <!-- 1. HERO CINEMATOGRÁFICO -->
  <section class="aurvix-hero ip-hero">
    <div class="hero-card-banner">
      <div class="hero-slideshow">
        <div class="hero-slide active" style={`background-image: url(${u('/images/ama_acceso_nocturno.jpg')});`}></div>
      </div>

      <div class="hero-overlay-gradient"></div>

      <div class="container hero-banner-content">
        <div class="hero-text-row">
          <div class="hero-headline-col">
            <h1 class="hero-title-aurvix">
              CONVERSEMOS SOBRE<br />
              TU PRÓXIMO HOGAR
            </h1>
            <p class="hero-sub-aurvix">
              ¿Tienes dudas sobre financiamiento, tipologías disponibles o condiciones de inversión en <strong>AMA Quillayes</strong>? Nuestro equipo comercial te asesora sin compromiso.
            </p>

            <div class="hero-actions-row">
              <a href="#canales-contacto" class="btn-hero-primary">
                <span>Enviar Consulta</span>
                <span class="btn-arrow">↗</span>
              </a>
              <a
                href="https://wa.me/56987654321?text=Hola,%20quisiera%20recibir%20información%20sobre%20AMA%20Quillayes"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-hero-secondary"
              >
                <span>Chatear por WhatsApp</span>
              </a>
            </div>
          </div>
        </div>

        <div class="ip-glass-bar">
          <div class="ip-glass-chip">
            <span class="ip-glass-val">La Florida</span>
            <span class="ip-glass-txt">Av. Vicuña Mackenna 11.600</span>
          </div>
          <div class="ip-glass-div"></div>
          <div class="ip-glass-chip">
            <span class="ip-glass-val">Lun–Dom</span>
            <span class="ip-glass-txt">10:30 a 19:00 hrs continuado</span>
          </div>
          <div class="ip-glass-div"></div>
          <div class="ip-glass-chip">
            <span class="ip-glass-val">Metro L4</span>
            <span class="ip-glass-txt">A pasos de Estación Los Quillayes</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. TARJETA UNIFICADA DE CONTACTO Y SALA DE VENTAS -->
  <section class="ip-section is-canvas" id="canales-contacto">
    <div class="container">
      <div class="ip-head">
        <h2 class="ip-title">Atención directa y sala de ventas</h2>
        <p class="ip-desc">
          Escríbenos o agenda tu visita presencial a nuestro piloto y sala de ventas en La Florida.
        </p>
      </div>

      <div class="ip-split is-even is-top">
        <!-- Columna Izquierda: Canales Oficiales + Mapa -->
        <div class="ip-split-info">
          <div>
            <span class="ip-kicker">Canales Oficiales AMA</span>
            <h3 class="ip-card-title">Sala de Ventas AMA Quillayes</h3>
            <p class="ip-card-text">
              Visítanos a pasos del Metro Los Quillayes o comunícate directamente con nuestros ejecutivos financieros e inmobiliarios.
            </p>

            <div class="ip-specs">
              <div class="ip-spec">
                <div class="ip-spec-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </div>
                <div class="ip-spec-info">
                  <span class="ip-spec-label">Ubicación Sala de Ventas</span>
                  <strong class="ip-spec-val">Av. Vicuña Mackenna 11.600, La Florida</strong>
                </div>
              </div>

              <div class="ip-spec">
                <div class="ip-spec-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
                <div class="ip-spec-info">
                  <span class="ip-spec-label">Horario continuado</span>
                  <strong class="ip-spec-val">Lunes a Domingo · 10:30 a 19:00 hrs</strong>
                </div>
              </div>

              <div class="ip-spec">
                <div class="ip-spec-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </div>
                <div class="ip-spec-info">
                  <span class="ip-spec-label">Correo Comercial</span>
                  <strong class="ip-spec-val"><a href="mailto:contacto@amainmobiliaria.cl">contacto@amainmobiliaria.cl</a></strong>
                </div>
              </div>

              <div class="ip-spec">
                <div class="ip-spec-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </div>
                <div class="ip-spec-info">
                  <span class="ip-spec-label">Teléfono y WhatsApp</span>
                  <strong class="ip-spec-val"><a href="tel:+56987654321">+56 9 8765 4321</a></strong>
                </div>
              </div>
            </div>

            <div class="ip-map-frame">
              <iframe
                title="Mapa ubicación AMA Quillayes en Av. Vicuña Mackenna 11600, La Florida"
                src="https://www.google.com/maps?q=Av.+Vicu%C3%B1a+Mackenna+11600,+La+Florida,+Santiago,+Chile&output=embed"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </div>

          <div class="ip-card-footer" style="margin-top: 1.5rem;">
            <div>
              <span class="ip-footer-label">Atención en línea</span>
              <div class="ip-footer-value" style="font-size: 1.2rem;">Respuesta en menos de 2 horas</div>
            </div>

            <div class="ip-actions">
              <a
                href="https://wa.me/56987654321?text=Hola,%20quisiera%20hacer%20una%20consulta%20a%20AMA%20Inmobiliaria"
                target="_blank"
                rel="noopener noreferrer"
                class="ip-btn-ghost"
              >
                <span>Abrir WhatsApp</span>
                <span>↗</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Columna Derecha: Formulario General -->
        <div>
          <span class="ip-kicker">Formulario de Contacto</span>
          <h3 class="ip-card-title">Envíanos un mensaje</h3>
          <p class="ip-card-text">
            Completa tus datos y un ejecutivo especialista te contactará a la brevedad.
          </p>

          <form id="contact-form-element" class="ip-form">
            <div class="ip-field">
              <label class="ip-label" for="c-name">Nombre y Apellido *</label>
              <input type="text" id="c-name" required placeholder="Ej: Ignacio Morales" class="ip-input" />
            </div>

            <div class="ip-form-row">
              <div class="ip-field">
                <label class="ip-label" for="c-email">Correo Electrónico *</label>
                <input type="email" id="c-email" required placeholder="tu@correo.cl" class="ip-input" />
              </div>
              <div class="ip-field">
                <label class="ip-label" for="c-phone">Teléfono Móvil *</label>
                <input type="tel" id="c-phone" required placeholder="+56 9 9876 5432" class="ip-input" />
              </div>
            </div>

            <div class="ip-field">
              <label class="ip-label" for="c-subject">Motivo de Consulta *</label>
              <select id="c-subject" class="ip-select" required>
                <option value="Cotizar departamento AMA Quillayes">Cotizar departamento en AMA Quillayes</option>
                <option value="Consultar facilidades de pago de pie">Consultar facilidades de pago de pie (60 cuotas)</option>
                <option value="Asesoría para inversionistas">Asesoría para inversionistas (rentabilidad)</option>
                <option value="Agendar visita a Sala de Ventas">Agendar visita a Sala de Ventas</option>
                <option value="Postventa y Garantías">Postventa y Garantías</option>
                <option value="Otra consulta">Otra consulta general</option>
              </select>
            </div>

            <div class="ip-field">
              <label class="ip-label" for="c-message">Tu Mensaje o Consulta *</label>
              <textarea
                id="c-message"
                rows="4"
                required
                placeholder="Cuéntanos qué tipología buscas o en qué podemos ayudarte..."
                class="ip-textarea"
              ></textarea>
            </div>

            <div class="ip-actions" style="margin-top: 0.5rem;">
              <button type="submit" class="btn-aurvix-dark">
                <span>Enviar Mensaje</span>
                <span class="arrow">↗</span>
              </button>
              <button
                type="button"
                class="ip-btn-ghost"
                onclick="window.openCotizadorModal && window.openCotizadorModal()"
              >
                <span>Abrir Cotizador Online</span>
              </button>
            </div>

            <div id="c-success" class="ip-success">
              <strong>¡Mensaje recibido!</strong> Un ejecutivo comercial de AMA Inmobiliaria se comunicará contigo dentro de las próximas 2 horas hábiles.
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. PREGUNTAS FRECUENTES -->
  <FAQAccordion />

  <!-- 4. BANNER CTA -->
  <ModernCTA />
</BaseLayout>

<script>
  const cForm = document.getElementById('contact-form-element') as HTMLFormElement | null;
  const cSuccess = document.getElementById('c-success');

  if (cForm && cSuccess) {
    cForm.addEventListener('submit', (e) => {
      e.preventDefault();
      cSuccess.classList.add('is-visible');
      cForm.reset();
    });
  }
</script>
