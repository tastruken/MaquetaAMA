---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQAccordion from '../components/features/FAQAccordion.astro';
import ModernCTA from '../components/features/ModernCTA.astro';
import { u } from '../utils/url';
import '../styles/home.css';
import '../styles/inner-pages.css';

const purchaseStages = [
  {
    tabLabel: 'Simulación y Elección',
    phase: 'Etapa Inicial',
    milestone: 'Cotización Formal',
    title: 'Selección de tipología y simulación financiera',
    desc: 'Explora los modelos de 1, 2 y 3 dormitorios en AMA Quillayes y simula junto a un ejecutivo tu plan de pie y dividendo proyectado con total transparencia.',
    image: u('/images/ama_interior_living.jpg'),
    footerLabel: 'Tiempo estimado',
    footerVal: 'Inmediato · 100% Online o Sala',
    specs: [
      { label: 'Modalidad', val: 'Online o Sala de Ventas' },
      { label: 'Entregable', val: 'Cotización formal en UF' },
      { label: 'Pre-evaluación', val: 'Sin costo ni compromiso' },
      { label: 'Unidades', val: '1D, 2D y 3D disponibles' }
    ],
    details: [
      'Asesoría personalizada en sala de ventas o videollamada',
      'Cotización formal con valores en UF y campañas vigentes',
      'Orientación crediticia preliminar según tu perfil'
    ]
  },
  {
    tabLabel: 'Reserva y Promesa',
    phase: 'Compromiso Legal',
    milestone: 'Póliza de Garantía',
    title: 'Reserva de unidad y firma de Promesa de Compraventa',
    desc: 'Congela el valor y las condiciones comerciales de tu departamento mediante la reserva y posterior firma de Promesa, respaldada al 100% por póliza de seguro de venta en verde.',
    image: u('/images/ama_quillayes_facade.jpg'),
    footerLabel: 'Protección legal',
    footerVal: 'Póliza Ley Venta en Verde',
    specs: [
      { label: 'Respaldo', val: 'Póliza de seguro 100%' },
      { label: 'Firma', val: 'Electrónica avanzada o notaría' },
      { label: 'Precio', val: 'Congelado en UF en promesa' },
      { label: 'Flexibilidad', val: 'Cesión a costo $0' }
    ],
    details: [
      'Póliza de garantía por la totalidad de los abonos del pie',
      'Condiciones comerciales y Bono Pie pactados por contrato',
      'Opción de cesión de promesa sin costo para inversionistas'
    ]
  },
  {
    tabLabel: 'Pago del Pie',
    phase: 'Período de Obra',
    milestone: 'Hasta 60 Cuotas',
    title: 'Abono del pie en cuotas mensuales sin interés',
    desc: 'Durante el desarrollo de la obra, pagas tu pie de manera programada en hasta 60 cuotas sin interés, complementado con el Bono Pie comercial del 10%.',
    image: u('/images/ama_piloto_cocina_quillayes.jpg'),
    footerLabel: 'Financiamiento directo',
    footerVal: 'Hasta 60 cuotas · 0% interés',
    specs: [
      { label: 'Plazo', val: 'Hasta 60 cuotas mensuales' },
      { label: 'Interés', val: '0% recargo financiero' },
      { label: 'Medios de pago', val: 'PAC, tarjeta o transferencia' },
      { label: 'Seguimiento', val: 'Reportes de avance de obra' }
    ],
    details: [
      'Pago automático con tarjeta, PAC o transferencia mensual',
      'Información periódica del estado de avance constructivo',
      'Sin intereses ni comisiones de administración'
    ]
  },
  {
    tabLabel: 'Crédito Hipotecario',
    phase: 'Gestión Bancaria',
    milestone: 'Multi-Banco',
    title: 'Tramitación y aprobación de tu crédito hipotecario',
    desc: 'Previo a la recepción final del edificio, nuestro equipo gestiona tu evaluación simultánea con las principales instituciones financieras para asegurar la mejor tasa y plazo.',
    image: u('/images/ama_amenity_rooftop.jpg'),
    footerLabel: 'Inicio de gestión',
    footerVal: '4 a 6 meses pre-entrega',
    specs: [
      { label: 'Cobertura', val: 'Bancos y mutuarias en convenio' },
      { label: 'Tasación', val: 'Coordinada por AMA' },
      { label: 'Estudio títulos', val: 'Carpeta legal lista' },
      { label: 'Acompañamiento', val: 'Ejecutivo financiero dedicado' }
    ],
    details: [
      'Presentación simultánea ante múltiples bancos en convenio',
      'Coordinación integral de tasación y antecedentes legales',
      'Comparativa transparente de dividendo final y CAE'
    ]
  },
  {
    tabLabel: 'Escritura y Entrega',
    phase: 'Recepción Final',
    milestone: 'Entrega de Llaves',
    title: 'Escrituración, recepción técnica y entrega de llaves',
    desc: 'Firmada la escritura en notaría e inscrita la propiedad, realizamos junto a ti la inspección técnica detallada de tu departamento y la entrega oficial de llaves.',
    image: u('/images/ama_acceso_nocturno.jpg'),
    footerLabel: 'Respaldo continuo',
    footerVal: 'Garantías Ley N° 20.016',
    specs: [
      { label: 'Inspección', val: 'Recorrido técnico guiado' },
      { label: 'Documentación', val: 'Manual del propietario' },
      { label: 'Postventa', val: 'Canal digital activo' },
      { label: 'Garantías', val: '3, 5 y 10 años legales' }
    ],
    details: [
      'Acta de recepción técnica punto por punto en terreno',
      'Entrega de manual de uso, mantención y garantías',
      'Activación inmediata del acompañamiento de Postventa AMA'
    ]
  }
];
---

<BaseLayout 
  title="Proceso de Compra | Cómo Comprar tu Departamento | AMA Inmobiliaria"
  description="Conoce cada etapa para comprar tu departamento en AMA Quillayes con total claridad: simulación, promesa con póliza, pie en 60 cuotas y entrega."
>
  <!-- 1. HERO CINEMATOGRÁFICO -->
  <section class="aurvix-hero ip-hero">
    <div class="hero-card-banner">
      <div class="hero-slideshow">
        <div class="hero-slide active" style={`background-image: url(${u('/images/ama_interior_living.jpg')});`}></div>
      </div>

      <div class="hero-overlay-gradient"></div>

      <div class="container hero-banner-content">
        <div class="hero-text-row">
          <div class="hero-headline-col">
            <h1 class="hero-title-aurvix">
              TU CAMINO HACIA TU<br />
              NUEVO DEPARTAMENTO
            </h1>
            <p class="hero-sub-aurvix">
              Te acompañamos con total claridad desde tu primera simulación en línea hasta el día en que recibes las llaves de tu hogar en <strong>AMA Quillayes</strong>.
            </p>

            <div class="hero-actions-row">
              <button 
                type="button" 
                class="btn-hero-primary"
                onclick="window.openCotizadorModal && window.openCotizadorModal()"
              >
                <span>Iniciar Simulación</span>
                <span class="btn-arrow">↗</span>
              </button>
              <a href="#etapas-compra" class="btn-hero-secondary">
                <span>Conocer las Etapas</span>
              </a>
            </div>
          </div>
        </div>

        <div class="ip-glass-bar">
          <div class="ip-glass-chip">
            <span class="ip-glass-val">100%</span>
            <span class="ip-glass-txt">Póliza de garantía</span>
          </div>
          <div class="ip-glass-div"></div>
          <div class="ip-glass-chip">
            <span class="ip-glass-val">Hasta 60</span>
            <span class="ip-glass-txt">Cuotas para el pie</span>
          </div>
          <div class="ip-glass-div"></div>
          <div class="ip-glass-chip">
            <span class="ip-glass-val">Multi-Banco</span>
            <span class="ip-glass-txt">Gestión hipotecaria</span>
          </div>
          <div class="ip-glass-div"></div>
          <div class="ip-glass-chip">
            <span class="ip-glass-val">Diciembre 2028</span>
            <span class="ip-glass-txt">Entrega estimada Quillayes</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. RECORRIDO INTERACTIVO POR ETAPA (SPLIT CARD + PILL TABS) -->
  <section class="ip-section is-canvas" id="etapas-compra">
    <div class="container">
      <div class="ip-head">
        <h2 class="ip-title">Un proceso claro en cada etapa</h2>
        <p class="ip-desc">
          Explora cada fase de tu compra sin letra chica ni trámites complejos.
        </p>
      </div>

      <div class="ip-tabs-bar">
        <div class="ip-tabs-pill" role="tablist" aria-label="Etapas del proceso de compra">
          {purchaseStages.map((s, idx) => (
            <button
              type="button"
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
              class={`ip-tab-btn ${idx === 0 ? 'active' : ''}`}
              data-stage-tab={idx}
            >
              {s.tabLabel}
            </button>
          ))}
        </div>
      </div>

      <div class="ip-split">
        <div class="ip-split-media">
          <img
            id="stage-img"
            src={purchaseStages[0].image}
            alt={purchaseStages[0].title}
          />
        </div>

        <div class="ip-split-info">
          <div>
            <span class="ip-kicker" id="stage-kicker">{purchaseStages[0].phase}</span>
            <h3 class="ip-card-title" id="stage-title">{purchaseStages[0].title}</h3>
            <p class="ip-card-text" id="stage-desc">{purchaseStages[0].desc}</p>

            <div class="ip-specs">
              <div class="ip-spec">
                <div class="ip-spec-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </div>
                <div class="ip-spec-info">
                  <span class="ip-spec-label" id="stage-spec-label-0">{purchaseStages[0].specs[0].label}</span>
                  <strong class="ip-spec-val" id="stage-spec-val-0">{purchaseStages[0].specs[0].val}</strong>
                </div>
              </div>

              <div class="ip-spec">
                <div class="ip-spec-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                </div>
                <div class="ip-spec-info">
                  <span class="ip-spec-label" id="stage-spec-label-1">{purchaseStages[0].specs[1].label}</span>
                  <strong class="ip-spec-val" id="stage-spec-val-1">{purchaseStages[0].specs[1].val}</strong>
                </div>
              </div>

              <div class="ip-spec">
                <div class="ip-spec-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                </div>
                <div class="ip-spec-info">
                  <span class="ip-spec-label" id="stage-spec-label-2">{purchaseStages[0].specs[2].label}</span>
                  <strong class="ip-spec-val" id="stage-spec-val-2">{purchaseStages[0].specs[2].val}</strong>
                </div>
              </div>

              <div class="ip-spec">
                <div class="ip-spec-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
                <div class="ip-spec-info">
                  <span class="ip-spec-label" id="stage-spec-label-3">{purchaseStages[0].specs[3].label}</span>
                  <strong class="ip-spec-val" id="stage-spec-val-3">{purchaseStages[0].specs[3].val}</strong>
                </div>
              </div>
            </div>
          </div>

          <div class="ip-card-footer">
            <div>
              <span class="ip-footer-label" id="stage-footer-label">{purchaseStages[0].footerLabel}</span>
              <div class="ip-footer-value" id="stage-footer-val">{purchaseStages[0].footerVal}</div>
            </div>

            <div class="ip-actions">
              <button
                type="button"
                class="btn-aurvix-dark"
                onclick="window.openCotizadorModal && window.openCotizadorModal()"
              >
                <span>Cotizar mi Unidad</span>
                <span class="arrow">↗</span>
              </button>
              <a href={u('/contacto')} class="ip-btn-ghost">
                <span>Hablar con un Asesor</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. GUÍA EDITORIAL COMPLETA (FILAS LIMPIAS SIN NÚMEROS GIGANTES) -->
  <section class="ip-section">
    <div class="container">
      <div class="ip-head is-left">
        <h2 class="ip-title">Detalle completo de punta a punta</h2>
        <p class="ip-desc">
          Cada hito cuenta con respaldo documental y un equipo especialista que gestiona los trámites junto a ti.
        </p>
      </div>

      <div class="ip-rows">
        {purchaseStages.map((s) => (
          <div class="ip-row">
            <div class="ip-row-meta">
              <span class="ip-row-label">{s.phase}</span>
              <span class="ip-row-big">{s.milestone}</span>
            </div>
            <div>
              <h3 class="ip-row-title">{s.title}</h3>
              <p class="ip-row-text">{s.desc}</p>
              <ul class="ip-row-checks">
                {s.details.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. PREGUNTAS FRECUENTES -->
  <FAQAccordion />

  <!-- 5. BANNER CTA -->
  <ModernCTA />
</BaseLayout>

<script define:vars={{ purchaseStages }}>
  const stageTabs = document.querySelectorAll('[data-stage-tab]');
  const imgEl = document.getElementById('stage-img');
  const kickerEl = document.getElementById('stage-kicker');
  const titleEl = document.getElementById('stage-title');
  const descEl = document.getElementById('stage-desc');
  const fLabelEl = document.getElementById('stage-footer-label');
  const fValEl = document.getElementById('stage-footer-val');

  stageTabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = Number(btn.getAttribute('data-stage-tab'));
      const stage = purchaseStages[idx];
      if (!stage) return;

      stageTabs.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      if (imgEl) {
        imgEl.classList.add('fade');
        setTimeout(() => {
          imgEl.src = stage.image;
          imgEl.alt = stage.title;
          imgEl.classList.remove('fade');
        }, 160);
      }

      if (kickerEl) kickerEl.textContent = stage.phase;
      if (titleEl) titleEl.textContent = stage.title;
      if (descEl) descEl.textContent = stage.desc;
      if (fLabelEl) fLabelEl.textContent = stage.footerLabel;
      if (fValEl) fValEl.textContent = stage.footerVal;

      stage.specs.forEach((sp, i) => {
        const lEl = document.getElementById(`stage-spec-label-${i}`);
        const vEl = document.getElementById(`stage-spec-val-${i}`);
        if (lEl) lEl.textContent = sp.label;
        if (vEl) vEl.textContent = sp.val;
      });
    });
  });
</script>
