---
import BaseLayout from '../layouts/BaseLayout.astro';
import PatternLoops from '../components/brand/PatternLoops.astro';
import Cotizador from '../components/features/Cotizador.astro';
import ModernCTA from '../components/features/ModernCTA.astro';
import { u } from '../utils/url';

const investorBenefits = [
  {
    icon: '📈',
    title: 'Alta Rentabilidad & Demanda',
    desc: 'Departamentos a pasos del Metro Los Quillayes en La Florida, una de las comunas con mayor velocidad de arriendo y menor tasa de vacancia en el Gran Santiago.'
  },
  {
    icon: '💎',
    title: 'Bono Pie del 10%',
    desc: 'Bonificación comercial directa para que completes tu pie bancario con un desembolso inicial significativamente menor, maximizando tu apalancamiento financiero.'
  },
  {
    icon: '🗓️',
    title: 'Hasta 60 Cuotas de Pie',
    desc: 'Paga tu pie en cuotas mensuales sin interés durante la etapa de desarrollo y edificación en blanco, optimizando tu flujo de caja mensual.'
  },
  {
    icon: '🛡️',
    title: 'Garantía de Arriendo por 1 Año',
    desc: 'Contamos con convenios y administración profesional para asegurar el arriendo de tu departamento desde el primer mes de recepción del proyecto.'
  },
  {
    icon: '🔄',
    title: 'Cesión de Promesa a Costo $0',
    desc: 'Si decides transferir tus derechos de promesa a un tercero antes de la escrituración final, no aplicamos multas ni comisiones administrativas.'
  },
  {
    icon: '🤝',
    title: 'Asesoría Bancaria y Tributaria',
    desc: 'Gestión integral de tu crédito hipotecario con los principales bancos del país y orientación para aprovechar beneficios del DFL2 y deducción de intereses.'
  }
];

const investorTypologies = [
  {
    title: 'Modelo 1D + 1B (Desde 34 m²)',
    badge: 'Mayor Velocidad de Arriendo',
    price: 'Desde 2.390 UF',
    capRate: '6.8% a 7.4% estimado',
    features: ['Cocina americana equipada', 'Balcón con vista despejada', 'Bajos gastos comunes']
  },
  {
    title: 'Modelo 2D + 1B (Desde 46 m²)',
    badge: 'Excelente Perfil de Arrendatarios',
    price: 'Desde 3.190 UF',
    capRate: '6.4% a 7.0% estimado',
    features: ['Dormitorio secundario home office', 'Espacio para lavadora', 'Alta retención de inquilinos']
  },
  {
    title: 'Modelo 2D + 2B Mariposa (Desde 58 m²)',
    badge: 'Máxima Privacidad / Roommates',
    price: 'Desde 3.750 UF',
    capRate: '6.2% a 6.8% estimado',
    features: ['Dos suites independientes', 'Ideal para profesionales jóvenes', 'Plusvalía superior']
  }
];
---

<BaseLayout 
  title="Inversión Inmobiliaria | Rentabilidad y Plusvalía con AMA Inmobiliaria"
  description="Multiplica tu patrimonio invirtiendo en departamentos nuevos en La Florida. Bono Pie 10%, cuotas sin interés y garantía de arriendo en Metro Los Quillayes."
>
  <!-- HERO INVERSIONISTAS -->
  <section class="investor-hero">
    <div class="investor-hero-bg" style={`background-image: url(${u('/images/ama_quillayes_facade.jpg')});`}>
      <div class="investor-overlay"></div>
    </div>
    <div class="container investor-hero-content">
      <h1 class="investor-title">
        Multiplica tu patrimonio con inversión residencial inteligente
      </h1>
      <p class="investor-desc">
        Aprovecha la venta en blanco en Edificio AMA Quillayes: alta plusvalía a pasos del Metro, Bono Pie del 10%, financiamiento en hasta 60 cuotas y respaldo de arriendo.
      </p>
      <div class="hero-btns-row">
        <button 
          type="button" 
          class="btn btn-white"
          onclick="window.openCotizadorModal && window.openCotizadorModal()"
        >
          <span>Simular Rentabilidad y Dividendo</span>
          <span class="arrow">↗</span>
        </button>
        <a href={u('/contacto')} class="btn btn-outline-white">
          <span>Hablar con un Asesor de Inversión</span>
        </a>
      </div>
    </div>
  </section>

  <!-- MÉTRICAS CLAVE PARA INVERSIONISTAS -->
  <section class="investor-metrics-strip">
    <div class="container">
      <div class="metrics-grid">
        <div class="metric-item">
          <strong>10%</strong>
          <span>Bono Pie Comercial Directo</span>
        </div>
        <div class="metric-item">
          <strong>Hasta 60</strong>
          <span>Cuotas sin interés en blanco</span>
        </div>
        <div class="metric-item">
          <strong>1 Cuadra</strong>
          <span>De estación Metro Los Quillayes</span>
        </div>
        <div class="metric-item">
          <strong>12 Meses</strong>
          <span>Garantía de arriendo asegurado</span>
        </div>
      </div>
    </div>
  </section>

  <!-- PILARES DE VALOR -->
  <section class="section section-cream">
    <div class="container">
      <div class="section-header text-center">
        <h2 class="section-title">Por qué invertir con AMA Inmobiliaria</h2>
        <p class="section-desc">
          Estructuramos cada proyecto para que tu inversión sea segura, rentable y predecible desde el primer momento.
        </p>
      </div>

      <div class="benefits-grid">
        {investorBenefits.map((b) => (
          <div class="benefit-card">
            <div class="benefit-icon">{b.icon}</div>
            <h3 class="benefit-title">{b.title}</h3>
            <p class="benefit-desc">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TIPOLOGÍAS RECOMENDADAS PARA RENTA -->
  <section class="section section-white">
    <div class="container">
      <div class="section-header text-center">
        <h2 class="section-title">Tipologías con mayor retorno de inversión</h2>
        <p class="section-desc">
          Diseñadas específicamente para la demanda de arriendo contemporánea: distribución abierta, luz natural y terminaciones duraderas.
        </p>
      </div>

      <div class="typology-grid">
        {investorTypologies.map((t) => (
          <div class="typology-card">
            <div class="typology-badge">{t.badge}</div>
            <h3 class="typology-title">{t.title}</h3>
            <div class="typology-price">{t.price}</div>
            <div class="typology-cap">
              <span>Retorno anual proyectado:</span>
              <strong>{t.capRate}</strong>
            </div>
            <ul class="typology-features">
              {t.features.map((f) => (
                <li>✓ {f}</li>
              ))}
            </ul>
            <button 
              type="button" 
              class="btn btn-petrol btn-block"
              onclick="window.openCotizadorModal && window.openCotizadorModal()"
            >
              Cotizar esta Tipología ↗
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COTIZADOR Y SIMULADOR DE INVERSIÓN -->
  <section class="section section-white" id="simulador-inversion">
    <div class="container">
      <div class="section-header text-center">
        <span class="badge badge-coral">Financiamiento Inversionista</span>
        <h2 class="section-title">Simula tu Inversión en AMA Quillayes</h2>
        <p class="section-desc">
          Calcula tu dividendo, pie en hasta 60 cuotas sin interés y proyecta el flujo de tu departamento.
        </p>
      </div>

      <div class="cotizador-wrap">
        <Cotizador idPrefix="investor-calc" />
      </div>
    </div>
  </section>

  <!-- BANNER CTA -->
  <ModernCTA />
</BaseLayout>

<style>
  .investor-hero {
    position: relative;
    margin-top: -5rem;
    padding: 12rem 0 6.5rem;
    min-height: 580px;
    display: flex;
    align-items: center;
    color: #FFFFFF;
    overflow: hidden;
  }

  .investor-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 30%;
    z-index: 1;
  }

  .investor-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.94) 0%, rgba(15, 23, 42, 0.65) 60%, rgba(15, 23, 42, 0.35) 100%);
  }

  .investor-hero-content {
    position: relative;
    z-index: 2;
    max-width: 820px;
  }

  .pill-tag-cyan {
    display: inline-block;
    padding: 0.4rem 1.1rem;
    background: rgba(26, 166, 183, 0.25);
    border: 1px solid rgba(26, 166, 183, 0.6);
    color: #A5F3FC;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .investor-title {
    font-size: clamp(2.2rem, 4.4vw, 3.8rem);
    font-weight: 800;
    line-height: 1.1;
    color: #FFFFFF;
    margin: 0 0 1.5rem;
    letter-spacing: -0.03em;
  }

  .investor-desc {
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.9);
    margin: 0 0 2.2rem;
    max-width: 720px;
  }

  .hero-btns-row {
    display: flex;
    gap: 1.1rem;
    flex-wrap: wrap;
  }

  .btn-white {
    background: #FFFFFF;
    color: #0F172A !important;
    font-weight: 700;
    padding: 0.85rem 1.85rem;
    border-radius: 9999px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 8px 24px rgba(0,0,0,0.2);
    border: none;
    cursor: pointer;
  }

  .btn-white:hover {
    background: #F8FAFC;
    transform: translateY(-2px);
  }

  .btn-outline-white {
    background: rgba(255, 255, 255, 0.15);
    color: #FFFFFF !important;
    font-weight: 600;
    padding: 0.85rem 1.85rem;
    border-radius: 9999px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(10px);
  }

  .btn-outline-white:hover {
    background: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  .investor-metrics-strip {
    background: #0F172A;
    color: #FFFFFF;
    padding: 3rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    text-align: center;
  }

  .metric-item strong {
    display: block;
    font-size: clamp(2rem, 3.2vw, 2.8rem);
    font-weight: 800;
    color: var(--color-cyan, #1AA6B7);
    line-height: 1;
    margin-bottom: 0.4rem;
  }

  .metric-item span {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.8);
    font-weight: 500;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3.5rem;
  }

  .benefit-card {
    background: #FFFFFF;
    border-radius: 20px;
    padding: 2.2rem;
    border: 1px solid rgba(0, 0, 0, 0.06);
    box-shadow: 0 10px 24px -6px rgba(0, 0, 0, 0.04);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .benefit-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.08);
  }

  .benefit-icon {
    font-size: 2.2rem;
    margin-bottom: 1.2rem;
  }

  .benefit-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0F172A;
    margin: 0 0 0.8rem;
  }

  .benefit-desc {
    font-size: 0.95rem;
    color: #4B5563;
    line-height: 1.6;
    margin: 0;
  }

  .typology-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    margin-top: 3.5rem;
  }

  .typology-card {
    background: #F8FAFC;
    border-radius: 24px;
    padding: 2.5rem 2rem;
    border: 1px solid rgba(0, 0, 0, 0.06);
    display: flex;
    flex-direction: column;
    transition: all 0.25s ease;
  }

  .typology-card:hover {
    background: #FFFFFF;
    box-shadow: 0 20px 40px -12px rgba(15, 23, 42, 0.12);
    border-color: var(--color-cyan, #1AA6B7);
    transform: translateY(-4px);
  }

  .typology-badge {
    align-self: flex-start;
    padding: 0.35rem 0.85rem;
    background: rgba(26, 166, 183, 0.12);
    color: var(--color-petrol, #0B2545);
    font-size: 0.78rem;
    font-weight: 700;
    border-radius: 9999px;
    margin-bottom: 1.2rem;
  }

  .typology-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: #0F172A;
    margin: 0 0 0.8rem;
  }

  .typology-price {
    font-size: 1.65rem;
    font-weight: 800;
    color: var(--color-cyan, #1AA6B7);
    margin-bottom: 0.8rem;
  }

  .typology-cap {
    background: rgba(0, 0, 0, 0.03);
    padding: 0.75rem 1rem;
    border-radius: 12px;
    font-size: 0.86rem;
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .typology-cap strong {
    color: #059669;
  }

  .typology-features {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .typology-features li {
    font-size: 0.9rem;
    color: #4B5563;
  }

  @media (max-width: 1024px) {
    .metrics-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
    .benefits-grid, .typology-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
