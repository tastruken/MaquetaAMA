---
// src/pages/nosotros.astro
// Diseño 100% unificado con la estética de Inicio (Template Aurvix / Framer Real Estate)

import BaseLayout from '../layouts/BaseLayout.astro';
import ModernCTA from '../components/features/ModernCTA.astro';
import { u } from '../utils/url';
import '../styles/home.css';
import '../styles/nosotros.css';

// Estructura Societaria oficial
const partners = [
  {
    name: 'Grupo VAIN',
    badge: '30+ Años de Trayectoria',
    summary: 'Grupo con más de 30 años de experiencia en el sector inmobiliario y más de 22.000 viviendas construidas, consolidando una amplia trayectoria en el desarrollo habitacional.'
  },
  {
    name: 'Grupo San José',
    badge: 'Top 100 Mundial Deloitte',
    summary: 'Constructora multinacional con más de 50 años de trayectoria y 15 años de presencia en Chile. Cuenta con operaciones en más de 10 países y se posiciona entre las 100 constructoras más grandes del mundo.'
  },
  {
    name: 'Polux Inmobiliaria SpA',
    badge: 'Gestión Patrimonial',
    summary: 'Equipo especializado en administración patrimonial y desarrollo inmobiliario, cuyos socios cuentan con experiencia en la comercialización de más de 2.000 unidades.'
  }
];

// Pilares de Marca AMA
const pillars = [
  {
    num: '01',
    title: 'Cada metro cuadrado con propósito',
    desc: 'Diseñamos sin metros perdidos ni pasillos innecesarios. Cada rincón tiene un sentido para optimizar la habitabilidad, luz natural y almacenaje inteligente.',
    icon: 'home'
  },
  {
    num: '02',
    title: 'Ubicaciones conectadas a lo esencial',
    desc: 'Emplazamientos estratégicos a pasos del Metro, ciclovías, comercio, centros de salud y colegios consolidados para facilitar tu día a día.',
    icon: 'globe'
  },
  {
    num: '03',
    title: 'Estética clara, cercana y sin excesos',
    desc: 'Arquitectura serena y acabados nobles de fácil mantención que cuidan los gastos comunes y envejecen con elegancia a través de las décadas.',
    icon: 'shield'
  },
  {
    num: '04',
    title: 'Decisiones que encajan sin pesar',
    desc: 'Facilitamos el acceso al departamento propio con pago de pie en hasta 60 cuotas, asesoría bancaria integral y transparencia total.',
    icon: 'card'
  }
];

---

<BaseLayout 
  title="Nosotros | Donde Todo Encaja | AMA Inmobiliaria"
  description="Conoce la filosofía, propósito y respaldo de Inmobiliaria AMA Quillayes SpA. La alianza de Grupo SANJOSE, Holding Ernesto Valle e ITLS, y Polux Inmobiliaria."
>
  <!-- 1. HERO LUMINOSO CINEMATOGRÁFICO (Idéntico a Inicio) -->
  <section class="aurvix-hero">
    <div class="hero-card-banner">
      <!-- Fondo arquitectónico cinematográfico -->
      <div class="hero-slideshow">
        <div class="hero-slide active" style={`background-image: url(${u('/images/ama_interior_living.jpg')});`}></div>
      </div>

      <div class="hero-overlay-gradient"></div>

      <div class="container hero-banner-content">
        <div class="hero-text-row">
          <div class="hero-headline-col">


            <h1 class="hero-title-aurvix">
              LO ESENCIAL ESTÁ<br />
              EN EL CENTRO
            </h1>

            <p class="hero-sub-aurvix">
              <em>AMA nace de una idea simple y honesta: hacer más fácil el que tengas tu propio departamento.</em>
            </p>

            <!-- Acciones Principales -->
            <div class="hero-actions-row">
              <button 
                type="button" 
                class="btn-hero-primary"
                onclick="window.openCotizadorModal && window.openCotizadorModal()"
              >
                <span>Cotizar Proyecto Activo</span>
                <span class="btn-arrow">↗</span>
              </button>
              <a href="#estructura-societaria" class="btn-hero-secondary">
                <span>Ver Respaldo Societario</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. SECCIÓN EDITORIAL: QUIÉNES SOMOS (Split Layout idéntico a Sobre AMA en Inicio) -->
  <section class="section about-split-section">
    <div class="container">
      <div class="about-grid">
        <!-- Foto en proporción elegante con radio de 24px y hover zoom -->
        <div class="about-img-wrap">
          <img 
            src={u('/images/ama_piloto_cocina_quillayes.jpg')} 
            alt="Diseño y arquitectura de departamentos AMA" 
            class="about-split-img"
            loading="lazy"
          />
        </div>

        <!-- Texto Editorial de Gran Escala -->
        <div class="about-content">
          <h2 class="about-heading">
            Creamos lugares que se sienten propios, más allá de los metros cuadrados.
          </h2>
          <p class="about-paragraph">
            <strong>AMA</strong> nace con el propósito de facilitar el acceso al departamento propio para personas que avanzan con esfuerzo y buscan <em>independencia, seguridad y estabilidad</em> para sus familias o proyectos personales.
          </p>
          <p class="about-paragraph">
            Apostamos por una estética clara, cercana, sin excesos ni sorpresas, con un sello propio que respeta el entorno. Una marca orientada a ofrecer <strong>espacios que se sienten, diseños que acompañan sin complicar y decisiones que encajan sin pesar</strong>.
          </p>
          <div class="about-actions-row">
            <a href="#pilares-marca" class="btn-aurvix-dark">
              <span>Nuestros Pilares</span>
              <span class="arrow">↗</span>
            </a>
            <span class="eslogan-highlight">"Donde todo encaja"</span>
          </div>
        </div>
      </div>

      <!-- 4 MÉTRICAS MINIMALISTAS AURVIX (Idénticas al template maestro) -->
      <div class="aurvix-metrics-row">
        <div class="aurvix-metric">
          <span class="metric-num">+27K</span>
          <span class="metric-lbl">Viviendas desarrolladas por nuestros socios</span>
        </div>
        <div class="aurvix-metric">
          <span class="metric-num">+2M</span>
          <span class="metric-lbl">Metros cuadrados construidos con altos estándares</span>
        </div>
        <div class="aurvix-metric">
          <span class="metric-num">50+</span>
          <span class="metric-lbl">Años de trayectoria internacional de Grupo SANJOSE</span>
        </div>
        <div class="aurvix-metric">
          <span class="metric-num">Top 100</span>
          <span class="metric-lbl">Constructoras del mundo (Deloitte Powers of Construction)</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. ESTRUCTURA SOCIETARIA (Tarjetas en una fila horizontal estilo Aurvix) -->
  <section class="section aurvix-corporate-section" id="estructura-societaria">
    <div class="container">
      <div class="section-header-split corporate-header-full">
        <div>
          <h2 class="aurvix-projects-title">Estructura Societaria de Inmobiliaria AMA Quillayes SpA</h2>
        </div>
        <p class="corporate-header-desc">
          Tres socios estratégicos combinan solvencia técnica, constructiva y de gestión de inversiones para brindar máxima solidez a cada propietario.
        </p>
      </div>

      <div class="corporate-bento-list">
        {partners.map((p) => (
          <div class="corp-bento-row">
            <!-- Branding y Logo ampliado -->
            <div class="corp-brand-col">
              <div class="corp-logo-mockup">
                <div class="logo-mark">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                  </svg>
                </div>
                <span class="logo-name">LOGO</span>
              </div>
              <span class="corp-pill-tag">{p.badge}</span>
            </div>

            <!-- Identidad y Resumen del Socio -->
            <div class="corp-info-col">
              <h3 class="corp-title">{p.name}</h3>
              <p class="corp-summary">{p.summary}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. PILARES DE PROYECTO (Tarjetas Minimalistas estilo BentoOfferings) -->
  <section class="section aurvix-pillars-section" id="pilares-marca">
    <div class="container">
      <div class="section-header-centered">
        <h2 class="section-title aurvix-title">Los 4 Atributos Esenciales de AMA</h2>
        <p class="section-desc">
          Criterios de vanguardia que rigen la habitabilidad, eficiencia y confort de cada departamento.
        </p>
      </div>

      <div class="pillars-four-grid">
        {pillars.map((item) => (
          <div class="pillar-clean-card">
            <div class="pillar-header-row">
              <span class="pillar-num-badge">{item.num}</span>
              <div class="pillar-icon-box">
                {item.icon === 'home' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1AA6B7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/>
                    <path d="M9 21V12h6v9"/>
                  </svg>
                )}
                {item.icon === 'globe' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1AA6B7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="2" y1="12" x2="22" y2="12"/>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                  </svg>
                )}
                {item.icon === 'shield' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1AA6B7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  </svg>
                )}
                {item.icon === 'card' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1AA6B7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="5" width="20" height="14" rx="3"/>
                    <line x1="2" y1="10" x2="22" y2="10"/>
                  </svg>
                )}
              </div>
            </div>
            <h3 class="pillar-clean-title">{item.title}</h3>
            <p class="pillar-clean-desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. PROYECTO INSIGNIA: EDIFICIO AMA QUILLAYES -->
  <section class="section aurvix-showcase-section" id="ama-quillayes">
    <div class="container">
      <div class="section-header-split">
        <div>
          <h2 class="aurvix-projects-title">Edificio AMA Quillayes — La Florida</h2>
        </div>
        <a href={u('/proyectos/ama-quillayes')} class="btn-aurvix-dark">
          <span>Ver Ficha Completa</span>
          <span class="arrow">↗</span>
        </a>
      </div>

      <!-- Tarjeta Maestra del Proyecto estilo Aurvix Featured -->
      <div class="project-master-card">
        <div class="pmc-media-col">
          <img 
            src={u('/images/ama_quillayes_facade.jpg')} 
            alt="Fachada Edificio AMA Quillayes" 
            class="pmc-img"
            loading="lazy"
          />
          <div class="pmc-pills-overlay">
            <span class="pill-tag-white">2 Torres Residenciales</span>
            <span class="pill-tag-white">299 Departamentos</span>
            <span class="pill-tag-white">1 y 2 Dormitorios</span>
          </div>
        </div>

        <div class="pmc-info-col">
          <!-- Ubicación y Entorno -->
          <div class="pmc-location-box">
            <div class="pmc-loc-icon">📍</div>
            <div class="pmc-loc-details">
              <strong>Av. Vicuña Mackenna 11.600, La Florida</strong>
              <p>A 450 m de Metro Elisa Correa y 650 m de Metro Los Quillayes (Línea 4).</p>
            </div>
          </div>

          <p class="pmc-description">
            Ubicado en un polo residencial consolidado con acceso inmediato a comercio y servicios esenciales: Jumbo, Easy, Mall Vivo Los Toros, colegios, CESFAM Maffioletti, UC Christus, Hospital Dr. Sótero del Río y el futuro nuevo Hospital Sótero del Río.
          </p>

          <!-- Amenities estilo Aurvix Tags -->
          <div class="pmc-amenities-wrap">
            <span class="pmc-amenities-label">Equipamiento Comunitario:</span>
            <div class="pmc-amenities-tags">
              <span class="aurvix-chip">🏊 Piscina</span>
              <span class="aurvix-chip">🥩 Quinchos Rooftop</span>
              <span class="aurvix-chip">💪 Gimnasio Equipado</span>
              <span class="aurvix-chip">💻 Espacio Cowork</span>
              <span class="aurvix-chip">🍷 Salón Gourmet</span>
              <span class="aurvix-chip">🚲 Bicicletero</span>
              <span class="aurvix-chip">🧺 Lavandería</span>
            </div>
          </div>

          <!-- Botones de Acción -->
          <div class="pmc-actions-row">
            <button 
              type="button" 
              class="btn-aurvix-dark"
              onclick="window.openCotizadorModal && window.openCotizadorModal()"
            >
              <span>Cotizar en AMA Quillayes</span>
              <span class="arrow">↗</span>
            </button>
            <a href={u('/proyectos/ama-quillayes')} class="btn-clean-link">
              Ver tipologías y planos →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. CTA BANNER DE ALTA CONVERSIÓN (Idéntico a Inicio) -->
  <ModernCTA 
    badge="Donde Todo Encaja"
    title="Descubre tu nuevo hogar con el respaldo que mereces"
    subtitle="Simula tu crédito hipotecario, conoce los departamentos de 1 y 2 dormitorios y agenda una asesoría personalizada sin costo en La Florida."
    primaryBtnText="Cotizar Online"
  />
</BaseLayout>
