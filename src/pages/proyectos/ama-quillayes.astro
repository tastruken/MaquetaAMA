---

<BaseLayout 
  title="Edificio AMA Quillayes | Departamentos en La Florida"
  description="Departamentos de 1, 2 y 3 dormitorios a pasos de Metro Quillayes en La Florida. Paga tu pie en 36 cuotas sin interés y obtén Bono Pie del 10%."
>
  <!-- 1. HERO COMPLETO CINEMATOGRÁFICO EDGE-TO-EDGE -->
  <section class="aurvix-hero">
    <div class="hero-card-banner">
      <!-- Slideshow de fondo en alta resolución -->
      <div class="hero-slideshow" id="quillayesHeroSlideshow">
        <div class="hero-slide active" style={`background-image: url(${u('/images/ama_quillayes_facade.jpg')});`}></div>
        <div class="hero-slide" style={`background-image: url(${u('/images/ama_interior_living.jpg')});`}></div>
        <div class="hero-slide" style={`background-image: url(${u('/images/ama_amenity_rooftop.jpg')});`}></div>
      </div>

      <div class="hero-overlay-gradient"></div>

      <div class="container hero-banner-content">
        <div class="hero-text-row hero-split-layout">
          <div class="hero-headline-col">
            <h1 class="hero-title-aurvix">
              QUILLAYES<br />
              DONDE CADA M² ESTÁ PENSADO EN TI
            </h1>

            <p class="hero-sub-aurvix">
              Deptos de 1 y 2 Dorms. en La Florida.<br />
              <em>Financiamiento de hasta 60 cuotas.</em>
            </p>

            <!-- Botones de Acción del Hero -->
            <div class="hero-actions-row">
              <button 
                type="button" 
                class="btn-hero-primary"
                onclick="window.openCotizadorModal && window.openCotizadorModal()"
              >
                <span>Cotizar Online</span>
                <span class="btn-arrow">↗</span>
              </button>
              <a href="#amenities" class="btn-hero-secondary">
                <span>AMA tus Espacios Comunes</span>
              </a>
              <a href="#tipologias" class="btn-hero-secondary">
                <span>Plantas y Financiamiento</span>
              </a>
            </div>
          </div>

          <!-- Tarjeta Derecha de Información Clave (Estilo AMA) -->
          <aside class="hero-key-info-card" aria-label="Información clave del proyecto">
            <p class="hkc-header">
              Accede a la <strong>información clave</strong><br />
              con uno de nuestros ejecutivos
            </p>

            <div class="hkc-pills-grid">
              <div class="hkc-pill">
                <span class="hkc-pill-label">Precios</span>
                <strong class="hkc-pill-val">Desde 2.540 UF</strong>
              </div>

              <div class="hkc-pill">
                <span class="hkc-pill-label">Tipologías</span>
                <strong class="hkc-pill-val">1 y 2 Dorms</strong>
              </div>

              <div class="hkc-pill">
                <span class="hkc-pill-label">Superficie</span>
                <strong class="hkc-pill-val">34 a 60 m²</strong>
              </div>

              <div class="hkc-pill">
                <span class="hkc-pill-label">Ubicación</span>
                <strong class="hkc-pill-val">Metro Quillayes (6 min)</strong>
              </div>

              <div class="hkc-pill hkc-pill-full">
                <span class="hkc-pill-label">Entrega Estimada</span>
                <strong class="hkc-pill-val">2do Semestre 2028 · Venta en Verde</strong>
              </div>
            </div>

            <button
              type="button"
              class="hkc-cta-btn"
              onclick="window.openCotizadorModal && window.openCotizadorModal()"
            >
              COTIZAR PROYECTO
            </button>

            <a
              href="#cotizador-quillayes"
              class="hkc-brochure-link"
              onclick="window.openCotizadorModal && window.openCotizadorModal(); return false;"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              <span>Descargar Brochure Oficial (PDF)</span>
            </a>
          </aside>
        </div>
      </div>

      <!-- Indicadores del Slideshow -->
      <div class="hero-slide-dots" id="quillayesHeroDots" aria-label="Controles del slideshow">
        <button type="button" class="slide-dot active" data-slide="0" aria-label="Fachada Exterior"></button>
        <button type="button" class="slide-dot" data-slide="1" aria-label="Living y Terraza"></button>
        <button type="button" class="slide-dot" data-slide="2" aria-label="Rooftop y Piscina"></button>
      </div>
    </div>
  </section>

  <!-- BARRA DE MÉTRICAS QUE COMPLETA EL HERO -->
  <div class="hero-metrics-bar">
    <div class="container">
      <div class="hero-metrics-grid">
        <div class="h-metric-item">
          <strong class="h-metric-num">+10</strong>
          <span class="h-metric-label">Espacios Comunes</span>
        </div>
        <div class="h-metric-item">
          <strong class="h-metric-num">60</strong>
          <span class="h-metric-label">Cuotas sin interés para pago de pie</span>
        </div>
        <div class="h-metric-item">
          <strong class="h-metric-num">$180.000</strong>
          <span class="h-metric-label">Valor cuota desde</span>
        </div>
      </div>
    </div>
  </div>

  <!-- SECCIÓN DE GALERÍA Y DETALLES DEL PROYECTO (BAJADA TRAS EL HERO) -->
  {/* OCULTAR SECCION: Comentada temporalmente por solicitud hasta definir reemplazo por Quillayes AMA TU BARRIO
  <section class="project-hero-section section-white" id="galeria-proyecto">
    <div class="container">
      <div class="project-header-info">

        <h2 class="project-main-title">Edificio AMA Quillayes — Galería y Espacios</h2>
        <p class="project-tagline">
          Ubicado en Av. Vicuña Mackenna 11.600, a pasos del Metro Quillayes.
        </p>
      </div>

      <div class="project-gallery-grid">
        <div class="gallery-main-img">
          <img 
            src={u('/images/ama_quillayes_facade.jpg')} 
            alt="Fachada Edificio AMA Quillayes en La Florida"
          />
        </div>
        <div class="gallery-side-imgs">
          <div class="side-img-item">
            <img 
              src={u('/images/ama_interior_living.jpg')} 
              alt="Living comedor departamento piloto"
            />
          </div>
          <div class="side-img-item">
            <img 
              src={u('/images/ama_amenity_rooftop.jpg')} 
              alt="Piscina y terraza en azotea"
            />
          </div>
        </div>
      </div>

      <!-- BANNER DE ESPECIFICACIONES CON ALTO CONTRASTE (DEBAJO DE LAS IMÁGENES) -->
      <div class="specs-hero-bar" id="specs-banner">
        <div class="spec-pill">
          <span class="p-label">Precios</span>
          <strong class="p-val">Desde 2.540 UF</strong>
        </div>
        <div class="spec-pill">
          <span class="p-label">Tipologías</span>
          <strong class="p-val">1 y 2 Dorms</strong>
        </div>
        <div class="spec-pill">
          <span class="p-label">Superficie</span>
          <strong class="p-val">34 a 60 mt2</strong>
        </div>
        <div class="spec-pill">
          <span class="p-label">Ubicación</span>
          <strong class="p-val">Metro Quillayes (6 min)</strong>
        </div>
        <div class="spec-pill highlight-pill">
          <span class="p-label">Entrega Estimada</span>
          <strong class="p-val">2do Semestre 2028</strong>
        </div>
      </div>
    </div>
  </section>
  */}

  <!-- TIPOLOGÍAS Y DISTRIBUCIONES (CUADRO UNIFICADO CON FILTRO Y MOCKUP DE PLANO) -->
  <section class="section section-cream" id="tipologias">
    <div class="container">
      <div class="section-header text-center">
        <h2 class="section-title">Encuentra la distribución ideal</h2>
        <p class="section-desc">Diseñados para quienes buscan funcionalidad, comodidad y una mejor calidad de vida.</p>
      </div>

      <!-- Barra de Pestañas / Filtro de Modelos -->
      <div class="tu-tabs-bar" role="tablist" aria-label="Seleccionar modelo de departamento">
        <div class="tu-tabs-pill">
          {typologies.map((t, index) => (
            <button
              type="button"
              role="tab"
              class={`tu-tab-btn ${index === 0 ? 'active' : ''}`}
              data-tu-index={index}
              aria-selected={index === 0 ? 'true' : 'false'}
            >
              {t.name}
            </button>
          ))}
        </div>
      </div>

      <!-- Cuadro Único Unificado (Plano Mockup + Información del Modelo) -->
      <div class="tu-unified-card">
        <!-- Columna Izquierda: Foto Simple de Mockup del Plano -->
        <div class="tu-media-col">
          <div class="tu-img-wrap">
            <img
              id="tu-display-img"
              src={typologies[0].planImage}
              alt={`Plano arquitectónico ${typologies[0].name}`}
              class="tu-plan-img"
            />
          </div>
        </div>

        <!-- Columna Derecha: Información del Modelo Seleccionado -->
        <div class="tu-info-col">
          <div class="tu-info-top">
            <h3 class="tu-title" id="tu-item-title">{typologies[0].name}</h3>
            <p class="tu-desc" id="tu-item-desc">{typologies[0].desc}</p>

            <!-- Ficha Iconográfica del Modelo -->
            <div class="tu-specs-grid">
              <div class="tu-spec-box">
                <div class="tu-spec-icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 4v16"/>
                    <path d="M2 8h18a2 2 0 0 1 2 2v10"/>
                    <path d="M2 17h20"/>
                    <path d="M6 8v9"/>
                  </svg>
                </div>
                <div class="tu-spec-info">
                  <span class="tu-spec-label">Habitaciones</span>
                  <strong class="tu-spec-val" id="tu-spec-beds">{typologies[0].bedrooms}</strong>
                </div>
              </div>

              <div class="tu-spec-box">
                <div class="tu-spec-icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 6 6.5 3.5a1.5 1.5 0 0 0-1-.5C4.683 3 4 3.683 4 4.5V17a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5"/>
                    <line x1="10" x2="8" y1="5" y2="7"/>
                    <line x1="2" x2="22" y1="12" y2="12"/>
                    <line x1="7" x2="7" y1="19" y2="21"/>
                    <line x1="17" x2="17" y1="19" y2="21"/>
                  </svg>
                </div>
                <div class="tu-spec-info">
                  <span class="tu-spec-label">Baños</span>
                  <strong class="tu-spec-val" id="tu-spec-baths">{typologies[0].bathrooms}</strong>
                </div>
              </div>

              <div class="tu-spec-box">
                <div class="tu-spec-icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 3H3v18h18V3z"/>
                    <path d="M9 3v18"/>
                    <path d="M3 9h6"/>
                    <path d="M15 3v6h6"/>
                  </svg>
                </div>
                <div class="tu-spec-info">
                  <span class="tu-spec-label">Superficie Total</span>
                  <strong class="tu-spec-val" id="tu-item-surface">{typologies[0].surface}</strong>
                </div>
              </div>

              <div class="tu-spec-box">
                <div class="tu-spec-icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="4"/>
                    <path d="M12 2v2"/>
                    <path d="M12 20v2"/>
                    <path d="m4.93 4.93 1.41 1.41"/>
                    <path d="m17.66 17.66 1.41 1.41"/>
                    <path d="M2 12h2"/>
                    <path d="M20 12h2"/>
                    <path d="m6.34 17.66-1.41 1.41"/>
                    <path d="m19.07 4.93-1.41 1.41"/>
                  </svg>
                </div>
                <div class="tu-spec-info">
                  <span class="tu-spec-label">Exterior</span>
                  <strong class="tu-spec-val" id="tu-spec-terrace">{typologies[0].terrace}</strong>
                </div>
              </div>
            </div>
          </div>

          <div class="tu-footer">
            <div class="tu-price">
              <span class="tu-price-label">Valor referencial</span>
              <strong class="tu-price-val" id="tu-item-price">{typologies[0].price}</strong>
            </div>

            <button
              type="button"
              class="btn btn-cyan tu-cotizar-btn"
              onclick="window.openCotizadorModal && window.openCotizadorModal()"
            >
              <span>Cotizar Modelo</span>
              <span class="tu-arrow">↗</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- COTIZADOR EN VIVO PARA ESTE PROYECTO (LUEGO DE PLANTAS) -->
  <section class="section section-white" id="cotizador-quillayes">
    <div class="container">
      <div class="section-header text-center">
        <h2 class="section-title">Simula tu dividendo en Quillayes de AMA INMOBILIARIA.</h2>
        <p class="section-desc">
          <em>Calcula el valor de tu pie en hasta 60 cuotas y la cuota mensual de tu crédito hipotecario</em>
        </p>
      </div>

      <div class="cotizador-wrap">
        <Cotizador idPrefix="quillayes-page-calc" showHeader={false} />
      </div>
    </div>
  </section>

  <!-- AMENITIES ESPECÍFICOS DEL PROYECTO (CON FOTOGRAFÍAS REALES) -->
  <section class="section section-petrol" id="amenities">
    <PatternLoops color="#1AA6B7" opacity={0.05} />
    <div class="container relative-z">
      <div class="section-header">
        <h2 class="section-title text-cream">Espacios Comunes para tu día a día</h2>
        <p class="section-desc text-muted-cream">
          <em>AMA tu día a día con áreas diseñadas para el descanso, la actividad y la vida en comunidad</em>
        </p>
      </div>

      <!-- 4 Tarjetas Fotográficas Principales -->
      <div class="amenities-photo-grid">
        {featuredAmenities.map((item) => (
          <article class="amenity-photo-card">
            <img src={u(item.image)} alt={item.name} loading="lazy" class="amenity-photo-img" />
            <div class="amenity-photo-overlay">
              <h3 class="amenity-photo-title">{item.name}</h3>
              {/* <p class="amenity-photo-sub">{item.subtitle}</p> */}
            </div>
          </article>
        ))}
      </div>

      <!-- Barra Inferior Unificada de Equipamiento Complementario -->
      <div class="amenities-extra-bar">
        {extraAmenities.map((item) => (
          <div class="extra-bar-col">
            <span class="extra-bar-icon" aria-hidden="true">
              {item.icon === 'grill' && (
