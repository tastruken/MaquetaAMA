---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cotizador from '../../components/features/Cotizador.astro';
import SpacesShowcase from '../../components/features/SpacesShowcase.astro';
import PurchaseProcess from '../../components/features/PurchaseProcess.astro';
import ModernCTA from '../../components/features/ModernCTA.astro';
import PatternLoops from '../../components/brand/PatternLoops.astro';
import { u } from '../../utils/url';
import '../../styles/home.css';

const typologies = [
  {
    name: 'Modelo 1D + 1B',
    surface: '34,5 a 38,2 m²',
    desc: 'Distribución abierta, cocina americana con cubierta de cuarzo y balcón continuo con vista despejada.',
    price: 'Desde 2.540 UF',
    tags: ['Ideal Inversionista', 'Renta Alta']
  },
  {
    name: 'Modelo 2D + 1B',
    surface: '46,0 a 52,4 m²',
    desc: 'Dormitorio principal amplio, segundo dormitorio para oficina o visita, clóset mural y conexión para lavadora.',
    price: 'Desde 3.190 UF',
    tags: ['Primera Vivienda']
  },
  {
    name: 'Modelo 2D + 2B Mariposa',
    surface: '58,0 a 64,8 m²',
    desc: 'Estilo mariposa: 2 suites independientes a cada costado del living central, otorgando máxima privacidad.',
    price: 'Desde 3.750 UF',
    tags: ['Más Vendido', 'Máxima Privacidad']
  },
  {
    name: 'Modelo 3D + 2B Familiar',
    surface: '70,5 a 76,2 m²',
    desc: 'Espacios generosos para familias, suite con walk-in clóset, logia y amplia terraza para compartir.',
    price: 'Desde 4.490 UF',
    tags: ['Familiar', 'Terraza Amplia']
  }
];

const amenities = [
  { name: 'Piscina', desc: 'Ubicada en la azotea con vista panorámica a la Cordillera de Los Andes.' },
  { name: 'Salón Cowork', desc: 'Espacio de trabajo colaborativo equipado con fibra óptica y salas de reuniones.' },
  { name: 'Salón Gourmet', desc: 'Cocina de chef y comedor equipado para celebraciones privadas y eventos.' },
  { name: 'Gimnasio', desc: 'Zona cardio, peso libre y espacio para entrenamiento funcional con luz natural.' },
  { name: 'Zona Pet', desc: 'Espacio exclusivo dedicado al paseo, cuidado y recreación de tus mascotas.' },
  { name: 'Quinchos', desc: 'Parrillas tipo gourmet con áreas de estar y pérgolas con vista despejada.' },
  { name: 'Áreas Verdes', desc: 'Jardines sustentables con paisajismo nativo de bajo consumo hídrico y descanso.' },
  { name: 'Sala Ecommerce', desc: 'Casilleros inteligentes y recepción segura de encomiendas las 24 horas.' },
  { name: 'Lavandería', desc: 'Central de lavado y secado eficiente de alta capacidad para residentes.' },
  { name: 'Bicicleteros', desc: 'Estacionamientos protegidos para bicicletas y estación de mantención básica.' }
];

const locationPoints = [
  {
    icon: 'metro',
    category: 'Metro L4',
    name: 'Metro Los Quillayes (Línea 4)',
    time: '6 min a pie',
    distance: '450 metros caminando directo',
    highlight: true
  },
  {
    icon: 'car',
    category: 'Vías Rápidas',
    name: 'Autopista Vespucio Sur Express',
    time: '5 min en auto',
    distance: 'Conexión a todo Santiago'
  },
  {
    icon: 'mall',
    category: 'Comercio',
    name: 'Mallplaza Vespucio & Florida Center',
    time: '8 min en Metro / auto',
    distance: 'Retail, cines, gastronomía y servicios'
  },
  {
    icon: 'hospital',
    category: 'Salud',
    name: 'Hospital La Florida & Clínica Bupa',
    time: '7 min en auto',
    distance: 'Centro de urgencias y salud integral'
  },
  {
    icon: 'education',
    category: 'Educación',
    name: 'Duoc UC & Colegios del sector',
    time: '9 min en auto',
    distance: 'Educación superior y escolar'
  },
  {
    icon: 'nature',
    category: 'Naturaleza',
    name: 'Parque Panul & Quebrada de Macul',
    time: '15 min en auto',
    distance: 'Trekking, ciclovías y aire puro cordillerano'
  }
];

const galleryImages = [
  {
    id: 'gal-1',
    src: '/images/ama_quillayes_facade.jpg',
    category: 'fachada',
    categoryLabel: 'Fachada',
    title: 'Fachada Principal Av. Vicuña Mackenna',
    desc: 'Arquitectura contemporánea de vanguardia con amplias terrazas y orientación privilegiada para luz natural.'
  },
  {
    id: 'gal-2',
    src: '/images/ama_piloto_cocina_quillayes.jpg',
    category: 'interiores',
    categoryLabel: 'Interiores',
    title: 'Cocina Americana y Living con Vista Cordillera',
    desc: 'Cubierta de cuarzo blanco, mesón isla desayunador, piso gres porcelánico y ventanales con vista a los Andes.'
  },
  {
    id: 'gal-3',
    src: '/images/ama_quinchos_rooftop_quillayes.jpg',
    category: 'amenities',
    categoryLabel: 'Espacios Comunes',
    title: 'Quinchos Gourmet en Rooftop',
    desc: 'Parrillas tipo gourmet de acero inoxidable, pérgola con iluminación cálida y vista panorámica al atardecer.'
  },
  {
    id: 'gal-4',
    src: '/images/ama_amenity_rooftop.jpg',
    category: 'amenities',
    categoryLabel: 'Espacios Comunes',
    title: 'Piscina Panorámica en Azotea',
    desc: 'Refrescante piscina en la cubierta superior con vista en 360° a toda la cuenca de Santiago.'
  },
  {
    id: 'gal-5',
    src: '/images/ama_interior_living.jpg',
    category: 'interiores',
    categoryLabel: 'Interiores',
    title: 'Living Comedor y Balcón Corrido',
    desc: 'Espacio diáfano con conexión directa a terraza para disfrutar del aire libre en cualquier momento.'
  },
  {
    id: 'gal-6',
    src: '/images/ama_dormitorio_suite_quillayes.jpg',
    category: 'interiores',
    categoryLabel: 'Interiores',
    title: 'Dormitorio Principal en Suite',
    desc: 'Gran luminosidad, walk-in clóset integrado y baño en suite con vista panorámica a la Cordillera.'
  },
  {
    id: 'gal-7',
    src: '/images/ama_gimnasio_quillayes.jpg',
    category: 'amenities',
    categoryLabel: 'Espacios Comunes',
    title: 'Gimnasio Equipado con Luz Natural',
    desc: 'Zona de cardio y pesas con ventanales de piso a cielo y vista panorámica a la Cordillera de Los Andes.'
  },
  {
    id: 'gal-8',
    src: '/images/ama_acceso_nocturno.jpg',
    category: 'fachada',
    categoryLabel: 'Fachada',
    title: 'Iluminación Nocturna y Accesos Controlados',
    desc: 'Seguridad 24/7 con hall de acceso de doble altura y control peatonal y vehicular de última tecnología.'
  }
];
---

<BaseLayout 
  title="Edificio AMA Quillayes | Departamentos en La Florida"
  description="Departamentos de 1, 2 y 3 dormitorios a pasos de Metro Quillayes en La Florida. Paga tu pie en 36 cuotas sin interés y obtén Bono Pie del 10%."
>
  <!-- 1. HERO COMPLETO CINEMATOGRÁFICO EDGE-TO-EDGE -->
  <section class="aurvix-hero">
    <div class="hero-card-banner">
      <!-- Slideshow de fondo en alta resolución -->
      <div class="hero-slideshow" id="quillayesHeroSlideshow">
        <div class="hero-slide active" style={`background-image: url(${u('/images/ama_quillayes_facade.jpg')});`}></div>
        <div class="hero-slide" style={`background-image: url(${u('/images/ama_interior_living.jpg')});`}></div>
        <div class="hero-slide" style={`background-image: url(${u('/images/ama_amenity_rooftop.jpg')});`}></div>
      </div>

      <div class="hero-overlay-gradient"></div>

      <div class="container hero-banner-content">
        <div class="hero-text-row">
          <div class="hero-headline-col">


            <h1 class="hero-title-aurvix">
              EDIFICIO AMA QUILLAYES®<br />
              DONDE TODO ENCAJA
            </h1>

            <p class="hero-sub-aurvix">
              Departamentos en La Florida de 1 y 2 dormitorios con terrazas continuas a lo ancho, arquitectura de vanguardia y financiamiento de hasta 60 cuotas, a pasos de la estación Metro Quillayes.
            </p>

            <!-- Botones de Acción del Hero -->
            <div class="hero-actions-row">
              <button 
                type="button" 
                class="btn-hero-primary"
                onclick="window.openCotizadorModal && window.openCotizadorModal()"
              >
                <span>Cotizar Online</span>
                <span class="btn-arrow">↗</span>
              </button>
              <a href="#galeria-proyecto" class="btn-hero-secondary">
                <span>Ver Galería y Espacios</span>
              </a>
              <a href="#cotizador-quillayes" class="btn-hero-secondary">
                <span>Simular Financiamiento</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Barra Frosted Glass de Especificaciones Clave del Proyecto -->
        <div class="hero-specs-glass-bar">
          <div class="glass-spec-item">
            <span class="glass-spec-label">Precios</span>
            <strong class="glass-spec-val">Desde 2.540 UF</strong>
          </div>
          <div class="glass-div"></div>
          <div class="glass-spec-item">
            <span class="glass-spec-label">Tipologías</span>
            <strong class="glass-spec-val">1 y 2 Dorms</strong>
          </div>
          <div class="glass-div"></div>
          <div class="glass-spec-item">
            <span class="glass-spec-label">Superficie</span>
            <strong class="glass-spec-val">34 a 60 m²</strong>
          </div>
          <div class="glass-div"></div>
          <div class="glass-spec-item">
            <span class="glass-spec-label">Ubicación</span>
            <strong class="glass-spec-val">Metro Quillayes (6 min)</strong>
          </div>
          <div class="glass-div"></div>
          <div class="glass-spec-item highlight">
            <span class="glass-spec-label">Entrega Estimada</span>
            <strong class="glass-spec-val">2do Semestre 2028</strong>
          </div>
        </div>
      </div>

      <!-- Indicadores del Slideshow -->
      <div class="hero-slide-dots" id="quillayesHeroDots" aria-label="Controles del slideshow">
        <button type="button" class="slide-dot active" data-slide="0" aria-label="Fachada Exterior"></button>
        <button type="button" class="slide-dot" data-slide="1" aria-label="Living y Terraza"></button>
        <button type="button" class="slide-dot" data-slide="2" aria-label="Rooftop y Piscina"></button>
      </div>
    </div>
  </section>

  <!-- BREADCRUMBS & TOP BAR (SECCIÓN BAJADA TRAS EL HERO) -->
  <div class="top-nav-bar">
    <div class="container breadcrumbs-container">
      <nav aria-label="Migas de pan" class="breadcrumbs">
        <a href={u('/')}>Inicio</a>
        <span class="sep">/</span>
        <a href={u('/proyectos')}>Proyectos</a>
        <span class="sep">/</span>
        <span class="current">AMA Quillayes</span>
      </nav>
      <div class="top-status">
        <span class="badge badge-cyan">Venta en Verde</span>
        <span class="badge badge-coral">Pie en hasta 60 cuotas</span>
      </div>
    </div>
  </div>

  <!-- SECCIÓN DE GALERÍA Y DETALLES DEL PROYECTO (BAJADA TRAS EL HERO) -->
  <section class="project-hero-section section-white" id="galeria-proyecto">
    <div class="container">
      <div class="project-header-info">

        <h2 class="project-main-title">Edificio AMA Quillayes — Galería y Espacios</h2>
        <p class="project-tagline">
          Ubicado en Av. Vicuña Mackenna 11.600, a pasos del Metro Quillayes.
        </p>
      </div>

      <!-- BANNER FIJO DE ESPECIFICACIONES CON ALTO CONTRASTE (VISIBLE SIN SCROLL) -->
      <div class="specs-hero-bar" id="specs-banner">
        <div class="spec-pill">
          <span class="p-label">Precios</span>
          <strong class="p-val">Desde 2.540 UF</strong>
        </div>
        <div class="spec-pill">
          <span class="p-label">Tipologías</span>
          <strong class="p-val">1 y 2 Dorms</strong>
        </div>
        <div class="spec-pill">
          <span class="p-label">Superficie</span>
          <strong class="p-val">34 a 60 mt2</strong>
        </div>
        <div class="spec-pill">
          <span class="p-label">Ubicación</span>
          <strong class="p-val">Metro Quillayes (6 min)</strong>
        </div>
        <div class="spec-pill highlight-pill">
          <span class="p-label">Entrega Estimada</span>
          <strong class="p-val">2do Semestre 2028</strong>
        </div>
      </div>

      <div class="project-gallery-grid">
        <div class="gallery-main-img">
          <img 
            src={u('/images/ama_quillayes_facade.jpg')} 
            alt="Fachada Edificio AMA Quillayes en La Florida"
          />
          <span class="img-caption">Fachada Exterior</span>
        </div>
        <div class="gallery-side-imgs">
          <div class="side-img-item">
            <img 
              src={u('/images/ama_interior_living.jpg')} 
              alt="Living comedor departamento piloto"
            />
            <span class="img-caption">Terrazas a lo Ancho</span>
          </div>
          <div class="side-img-item">
            <img 
              src={u('/images/ama_amenity_rooftop.jpg')} 
              alt="Piscina y terraza en azotea"
            />
            <span class="img-caption">Espacios comunes para tu día a día</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HIGHLIGHTS TÉCNICOS -->
  <section class="section section-cream">
    <div class="container">
      <!-- 4 MÉTRICAS DE RESPALDO Y TRAYECTORIA AMA QUILLAYES -->
      <div class="quillayes-metrics-row">
        <div class="q-metric-item">
          <strong class="q-metric-num">+12</strong>
          <span class="q-metric-label">Años de Trayectoria</span>
        </div>
        <div class="q-metric-item">
          <strong class="q-metric-num">+1.850</strong>
          <span class="q-metric-label">Familias en su Hogar</span>
        </div>
        <div class="q-metric-item">
          <strong class="q-metric-num">60</strong>
          <span class="q-metric-label">Cuotas Pie sin Interés</span>
        </div>
        <div class="q-metric-item">
          <strong class="q-metric-num">4.9</strong>
          <span class="q-metric-label">Calificación Promedio</span>
        </div>
      </div>

      <!-- TIPOLOGÍAS -->
      <div class="section-header" style="margin-top: 3.5rem;">

        <h2 class="section-title">Encuentra la distribución ideal</h2>
        <p class="section-desc">Diseños optimizados al milímetro para otorgar máxima amplitud y confort térmico.</p>
      </div>

      <div class="typologies-grid">
        {typologies.map((t) => (
          <div class="typology-card card">
            <div class="t-header">
              <div class="t-tags">
                {t.tags.map((tag) => (
                  <span class="badge badge-cyan">{tag}</span>
                ))}
              </div>
              <h3 class="t-title">{t.name}</h3>
              <span class="t-surface">Superficie: <strong>{t.surface}</strong></span>
            </div>
            <p class="t-desc">{t.desc}</p>
            <div class="t-footer">
              <div class="t-price">
                <span class="t-price-label">Valor referencial</span>
                <strong class="t-price-val">{t.price}</strong>
              </div>
              <button 
                type="button" 
                class="btn btn-cyan btn-sm"
                onclick="window.openCotizadorModal && window.openCotizadorModal()"
              >
                Cotizar Modelo
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COTIZADOR EN VIVO PARA ESTE PROYECTO (LUEGO DE PLANTAS) -->
  <section class="section section-white" id="cotizador-quillayes">
    <div class="container">
      <div class="section-header text-center">

        <h2 class="section-title">Simula tu dividendo en AMA Quillayes</h2>
        <p class="section-desc">Calcula el pie en hasta 60 cuotas y la cuota mensual de tu crédito hipotecario.</p>
      </div>

      <div class="cotizador-wrap">
        <Cotizador idPrefix="quillayes-page-calc" />
      </div>
    </div>
  </section>

  <!-- AMENITIES ESPECÍFICOS DEL PROYECTO (LUEGO DE PLANTAS Y COTIZADOR) -->
  <section class="section section-petrol" id="amenities">
    <PatternLoops color="#1AA6B7" opacity={0.05} />
    <div class="container relative-z">
      <div class="section-header text-center">

        <h2 class="section-title text-cream">Amenities pensados para tu día a día</h2>
        <p class="section-desc text-muted-cream">
          Instalaciones de primer nivel administradas con eficiencia para mantener bajos los gastos comunes.
        </p>
      </div>

      <div class="amenities-grid">
        {amenities.map((a) => (
          <div class="amenity-item card card-dark">
            <h4 class="amenity-name">{a.name}</h4>
            <p class="amenity-desc">{a.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ESPACIOS Y TERMINACIONES INTERACTIVO (Showcase por Tabs) -->
  <SpacesShowcase />

  <!-- PROCESO DE COMPRA EN 4 PASOS -->
  <PurchaseProcess />

  <!-- UBICACIÓN DEL PROYECTO (ESTILO CLARO, BENTO Y SOFISTICADO) -->
  <section class="section section-location-canvas" id="ubicacion">
    <div class="container">
      <div class="section-header text-center">

        <h2 class="section-title">Ubicación Estratégica en La Florida</h2>
        <p class="section-desc">
          Av. Vicuña Mackenna 11.600, a pasos de la estación Metro Los Quillayes (L4) y con conectividad inmediata a autopistas, servicios y comercio.
        </p>
      </div>

      <div class="location-bento-grid">
        <!-- Columna Izquierda: Master Card de Dirección y Servicios Cercanos -->
        <div class="location-content-col">
          <!-- Tarjeta Bento: Dirección y Acciones -->
          <div class="location-bento-card address-bento">
            <div class="address-bento-top">
              <div class="address-icon-badge" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div class="address-meta-info">
                <span class="address-kicker">Sala de Ventas & Piloto en Terreno</span>
                <h3 class="address-main-title">Av. Vicuña Mackenna 11.600</h3>
                <p class="address-sub-text">La Florida, Santiago · A 6 min a pie de Metro Los Quillayes</p>
              </div>
            </div>

            <div class="address-actions-bar">
              <a 
                href="https://maps.google.com/?q=Av.+Vicu%C3%B1a+Mackenna+11600,+La+Florida,+Regi%C3%B3n+Metropolitana" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn-address-primary"
              >
                <span>Cómo Llegar en Maps</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>
              <button 
                type="button" 
                class="btn-address-secondary copy-address-btn" 
                id="copy-address-trigger"
                title="Copiar dirección al portapapeles"
              >
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span id="copy-text">Copiar Dirección</span>
              </button>
            </div>
          </div>

          <!-- Tarjeta Bento: Servicios y Puntos Cercanos -->
          <div class="location-bento-card services-bento">
            <div class="services-bento-header">
              <h4 class="services-bento-title">Servicios Esenciales y Conectividad</h4>
              <span class="services-bento-sub">Tiempos reales de traslado caminando y en vehículo</span>
            </div>

            <div class="services-cards-grid">
              {locationPoints.map((pt) => (
                <div class={`service-item-tile ${pt.highlight ? 'tile-highlight' : ''}`}>
                  <div class="service-tile-top">
                    <div class="service-cat-wrap">
                      <span class="service-icon-pill" aria-hidden="true">
                        {pt.icon === 'metro' && (
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="16" rx="2"></rect><path d="M4 11h16"></path><path d="M12 3v8"></path><path d="m8 19-2 3"></path><path d="m16 19 2 3"></path><circle cx="8" cy="15" r="1"></circle><circle cx="16" cy="15" r="1"></circle></svg>
                        )}
                        {pt.icon === 'car' && (
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"></path><circle cx="7" cy="17" r="2"></circle><path d="M9 17h6"></path><circle cx="17" cy="17" r="2"></circle></svg>
                        )}
                        {pt.icon === 'mall' && (
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path><path d="M3 6h18"></path><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                        )}
                        {pt.icon === 'hospital' && (
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>
                        )}
                        {pt.icon === 'education' && (
