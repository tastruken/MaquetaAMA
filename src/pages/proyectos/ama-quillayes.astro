    background: rgba(0, 28, 40, 0.9);
  }

  /* ========================================================
     LIGHTBOX MODAL (ARQUITECTÓNICO, MINIMALISTA & FINO)
     ======================================================== */
  .gallery-lightbox {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    flex-direction: column;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery-lightbox.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(2, 14, 20, 0.94);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
  }

  .lightbox-stage {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    padding: 1.5rem 2.5rem;
    box-sizing: border-box;
    animation: fadeInStage 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes fadeInStage {
    from { opacity: 0; transform: scale(0.985); }
    to { opacity: 1; transform: scale(1); }
  }

  /* Barra superior minimalista: solo botón de cierre a la derecha */
  .lightbox-topbar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 100%;
    max-width: 1720px;
    margin: 0 auto;
    padding-bottom: 0.25rem;
    flex-shrink: 0;
  }

  .lightbox-close-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.8);
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .lightbox-close-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.3);
    color: #FFFFFF;
    transform: scale(1.06);
  }

  /* Zona central con la fotografía y flechas flotantes en carriles dedicados (Cero Superposición) */
  .lightbox-main {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 1;
    width: 100%;
    max-width: 1720px;
    margin: 0 auto;
    padding: 0.5rem 1.5rem 1.5rem 1.5rem;
    gap: 2rem;
    min-height: 0;
    box-sizing: border-box;
  }

  .lightbox-frame {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
