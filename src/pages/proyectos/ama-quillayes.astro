  .location-map-col {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .architectural-map-card {
    position: relative;
    background: #FFFFFF;
    border-radius: var(--radius-bento, 20px);
    overflow: hidden;
    border: 1px solid rgba(15, 23, 42, 0.08);
    box-shadow: 0 12px 36px rgba(0, 34, 48, 0.06);
    flex: 1;
    min-height: 540px;
    height: 100%;
  }

  .map-floating-pin-card {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    z-index: 2;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(0, 0, 0, 0.08);
