  /* ========================================================
     POSTERIOR GALERÍA DE IMÁGENES AL FINAL (4 COLUMNAS - WIDE)
     ======================================================== */
  .gallery-wide-container {
    max-width: 1560px;
    width: 95%;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .gallery-full-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.35rem;
    margin-top: 1.5rem;
  }

  .gallery-item-card {
    background: #FFFFFF;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    box-shadow: 0 10px 24px -8px rgba(15, 23, 42, 0.1);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s ease, box-shadow 0.4s ease;
    display: block;
    aspect-ratio: 16 / 11;
  }

  .gallery-item-card:hover {
    transform: translateY(-5px);
    border-color: rgba(26, 166, 183, 0.55);
    box-shadow: 0 20px 40px -12px rgba(15, 23, 42, 0.18);
  }

  .gal-img-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #F1F5F9;
  }

  .gal-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery-item-card:hover .gal-photo {
    transform: scale(1.05);
  }

  .gal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 18, 25, 0.4);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .gallery-item-card:hover .gal-overlay {
    opacity: 1;
  }

  .gal-zoom-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.15rem;
    border-radius: 999px;
    background: rgba(0, 24, 34, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #FFFFFF;
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transform: translateY(6px);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  .gallery-item-card:hover .gal-zoom-pill {
    transform: translateY(0);
    border-color: rgba(123, 224, 236, 0.7);
    color: #7BE0EC;
    background: rgba(0, 28, 40, 0.9);
  }

  /* ========================================================
     LIGHTBOX MODAL (ARQUITECTÓNICO, MINIMALISTA & FINO)
     ======================================================== */
  .gallery-lightbox {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    flex-direction: column;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery-lightbox.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(2, 14, 20, 0.94);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
  }

  .lightbox-stage {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    padding: 1.5rem 2.5rem;
    box-sizing: border-box;
    animation: fadeInStage 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes fadeInStage {
    from { opacity: 0; transform: scale(0.985); }
    to { opacity: 1; transform: scale(1); }
  }

  /* Barra superior minimalista: solo botón de cierre a la derecha */
  .lightbox-topbar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 100%;
    max-width: 1720px;
    margin: 0 auto;
    padding-bottom: 0.25rem;
    flex-shrink: 0;
  }

  .lightbox-close-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.8);
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .lightbox-close-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.3);
    color: #FFFFFF;
    transform: scale(1.06);
  }

  /* Zona central con la fotografía y flechas flotantes en carriles dedicados (Cero Superposición) */
  .lightbox-main {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 1;
    width: 100%;
    max-width: 1720px;
    margin: 0 auto;
    padding: 0.5rem 1.5rem 1.5rem 1.5rem;
    gap: 2rem;
    min-height: 0;
    box-sizing: border-box;
  }

  .lightbox-frame {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    min-width: 0;
    height: 100%;
    max-height: 82vh;
  }

  .lightbox-img {
    max-width: 100%;
    max-height: 82vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 32px 85px -20px rgba(0, 0, 0, 0.85), 0 0 0 1px rgba(255, 255, 255, 0.08);
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    display: block;
  }

  .lightbox-nav-btn {
    position: relative;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(0, 24, 34, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: rgba(255, 255, 255, 0.85);
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 10;
  }

  .lightbox-nav-btn:hover {
    background: rgba(26, 166, 183, 0.28);
    border-color: rgba(123, 224, 236, 0.7);
    color: #FFFFFF;
    transform: scale(1.1);
    box-shadow: 0 0 20px rgba(26, 166, 183, 0.35);
  }

  .lightbox-nav-btn:active {
    transform: scale(0.96);
  }

  /* Indicador numérico minimalista abajo de la imagen */
  .lightbox-bottom-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding-top: 0.75rem;
    flex-shrink: 0;
  }

  .lightbox-counter-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem 0.95rem;
    border-radius: 999px;
    background: rgba(0, 24, 34, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
  }

  .lightbox-counter {
    font-size: 0.82rem;
    font-weight: 600;
    color: #7BE0EC;
    letter-spacing: 0.14em;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 768px) {
    .lightbox-stage {
      padding: 1rem 0.75rem;
    }
    .lightbox-main {
      padding: 0.25rem 0.25rem 0.75rem 0.25rem;
      gap: 0.6rem;
    }
    .lightbox-frame {
      max-height: 72vh;
    }
    .lightbox-img {
      max-height: 72vh;
    }
    .lightbox-nav-btn {
      width: 40px;
      height: 40px;
    }
  }

  .gallery-item-card.is-hidden {
    display: none !important;
  }

  @media (max-width: 1200px) {
    .gallery-full-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }

  @media (max-width: 992px) {
    .location-bento-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .architectural-map-card {
      min-height: 420px;
    }
    .architectural-map-iframe {
      min-height: 420px;
    }
    .gallery-wide-container {
      width: 100%;
      padding: 0 1rem;
    }
    .gallery-full-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.15rem;
    }
  }

  @media (max-width: 640px) {
    .services-cards-grid {
      grid-template-columns: 1fr;
    }
    .address-bento,
    .services-bento {
      padding: 1.25rem;
    }
    .address-actions-bar {
      flex-direction: column;
      align-items: stretch;
    }
    .btn-address-primary,
    .btn-address-secondary {
      justify-content: center;
    }
    .gallery-full-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>

<script>
  // Funcionalidad interactiva: Ubicación (Copiar Dirección) y Galería (Lightbox)
  function initPageInteractions() {
    // 1. Copiar Dirección
    const copyBtn = document.getElementById('copy-address-trigger');
    const copyText = document.getElementById('copy-text');
    if (copyBtn && copyText && !copyBtn.dataset.bound) {
      copyBtn.dataset.bound = 'true';
      copyBtn.addEventListener('click', async () => {
        const address = 'Av. Vicuña Mackenna 11.600, La Florida, Región Metropolitana';
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(address);
          } else {
            const textArea = document.createElement('textarea');
            textArea.value = address;
            document.body.appendChild(textArea);
            textArea.select();
            document.execCommand('copy');
            document.body.removeChild(textArea);
          }
          const original = copyText.textContent;
          copyText.textContent = '¡Copiado!';
          copyBtn.classList.add('copied');
          setTimeout(() => {
            copyText.textContent = original;
            copyBtn.classList.remove('copied');
          }, 2200);
        } catch (e) {
          console.error('Error al copiar dirección', e);
        }
      });
    }

    // 2. Lightbox Modal (Minimalista & Elegante)
    const lightbox = document.getElementById('gallery-lightbox');
    const lightboxBackdrop = document.getElementById('lightbox-backdrop');
    const lightboxStage = document.getElementById('lightbox-stage');
    const lightboxClose = document.getElementById('lightbox-close');
    const lightboxPrev = document.getElementById('lightbox-prev');
    const lightboxNext = document.getElementById('lightbox-next');
    const activeImg = document.getElementById('lightbox-active-img') as HTMLImageElement | null;
    const activeCounter = document.getElementById('lightbox-counter');

    const cards = Array.from(document.querySelectorAll('.gallery-item-card')) as HTMLElement[];
    let currentIdx = 0;

    function updateLightbox(idx: number) {
      if (!cards.length || !activeImg) return;
      if (idx < 0) idx = cards.length - 1;
      if (idx >= cards.length) idx = 0;
      currentIdx = idx;

      const card = cards[currentIdx];
      const src = card.getAttribute('data-src') || '';
      const title = card.getAttribute('data-title') || '';

      activeImg.style.opacity = '0';
      activeImg.style.transform = 'scale(0.985)';
      setTimeout(() => {
        activeImg.src = src;
        activeImg.alt = title;
        activeImg.style.opacity = '1';
        activeImg.style.transform = 'scale(1)';
      }, 70);

      if (activeCounter) {
        const padCurrent = String(currentIdx + 1).padStart(2, '0');
        const padTotal = String(cards.length).padStart(2, '0');
        activeCounter.textContent = `${padCurrent} / ${padTotal}`;
      }
    }

    function openLightbox(idx: number) {
      updateLightbox(idx >= 0 ? idx : 0);
      if (lightbox) {
        lightbox.classList.add('is-open');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeLightbox() {
      if (lightbox) {
        lightbox.classList.remove('is-open');
        lightbox.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
    }

    cards.forEach((card, idx) => {
      if (card.dataset.bound) return;
      card.dataset.bound = 'true';
      card.addEventListener('click', () => openLightbox(idx));
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openLightbox(idx);
        }
      });
    });

    if (lightboxClose && !(lightboxClose as HTMLElement).dataset.bound) {
      (lightboxClose as HTMLElement).dataset.bound = 'true';
      lightboxClose.addEventListener('click', closeLightbox);
    }
    if (lightboxBackdrop && !(lightboxBackdrop as HTMLElement).dataset.bound) {
      (lightboxBackdrop as HTMLElement).dataset.bound = 'true';
      lightboxBackdrop.addEventListener('click', closeLightbox);
    }
    if (lightboxStage && !(lightboxStage as HTMLElement).dataset.bound) {
      (lightboxStage as HTMLElement).dataset.bound = 'true';
      lightboxStage.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target === lightboxStage || target.classList.contains('lightbox-main') || target.classList.contains('lightbox-frame')) {
          closeLightbox();
        }
      });
    }
    if (activeImg && !activeImg.dataset.bound) {
      activeImg.dataset.bound = 'true';
      activeImg.addEventListener('click', (e) => e.stopPropagation());
    }
    if (lightboxPrev && !(lightboxPrev as HTMLElement).dataset.bound) {
      (lightboxPrev as HTMLElement).dataset.bound = 'true';
      lightboxPrev.addEventListener('click', (e) => {
        e.stopPropagation();
        updateLightbox(currentIdx - 1);
      });
    }
    if (lightboxNext && !(lightboxNext as HTMLElement).dataset.bound) {
      (lightboxNext as HTMLElement).dataset.bound = 'true';
      lightboxNext.addEventListener('click', (e) => {
        e.stopPropagation();
        updateLightbox(currentIdx + 1);
      });
    }

    document.addEventListener('keydown', (e) => {
      if (!lightbox || !lightbox.classList.contains('is-open')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') updateLightbox(currentIdx - 1);
      if (e.key === 'ArrowRight') updateLightbox(currentIdx + 1);
    });

    // 3. Slideshow Hero Quillayes (Edge-to-Edge)
    const heroSlides = document.querySelectorAll<HTMLElement>('#quillayesHeroSlideshow .hero-slide');
    const heroDots = document.querySelectorAll<HTMLElement>('#quillayesHeroDots .slide-dot');
    let currentHeroSlide = 0;
    let heroTimer: ReturnType<typeof setInterval> | null = null;

    function goToHeroSlide(index: number) {
      if (!heroSlides.length) return;
      heroSlides[currentHeroSlide]?.classList.remove('active');
      heroDots[currentHeroSlide]?.classList.remove('active');
      currentHeroSlide = (index + heroSlides.length) % heroSlides.length;
      heroSlides[currentHeroSlide]?.classList.add('active');
      heroDots[currentHeroSlide]?.classList.add('active');
    }

    function startHeroSlideshow() {
      if (heroTimer) clearInterval(heroTimer);
      heroTimer = setInterval(() => {
        goToHeroSlide(currentHeroSlide + 1);
      }, 5500);
    }

    heroDots.forEach((dot) => {
      if (dot.dataset.bound) return;
      dot.dataset.bound = 'true';
      dot.addEventListener('click', (e) => {
        const targetIndex = parseInt((e.currentTarget as HTMLElement).getAttribute('data-slide') || '0', 10);
        goToHeroSlide(targetIndex);
        startHeroSlideshow();
      });
    });

    if (heroSlides.length > 1) {
      startHeroSlideshow();
    }

    // 4. Selector Unificado de Tipologías (Cuadro Único con Mockup de Plano)
    const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
    const typologiesData = [
      {
        name: 'Modelo 1D + 1B',
        surface: '34,5 a 38,2 m²',
        bedrooms: '1 Dormitorio',
        bathrooms: '1 Baño',
        terrace: 'Terraza continua',
        desc: 'Distribución optimizada, con cocina integrada a living comedor, y terraza continua a lo ancho del departamento.',
        price: 'Desde 2.540 UF',
        tags: ['Ideal Inversionista', 'Renta Alta'],
        planImage: `${baseUrl}/images/plano_mockup_1d1b.jpg`
      },
      /*
      {
        name: 'Modelo 2D + 1B',
        surface: '46,0 a 52,4 m²',
        bedrooms: '2 Dormitorios',
        bathrooms: '1 Baño Completo',
        terrace: 'Terraza Integrada',
        desc: 'Dormitorio principal amplio, segundo dormitorio para oficina o visita, clóset mural y conexión para lavadora.',
        price: 'Desde 3.190 UF',
        tags: ['Primera Vivienda'],
        planImage: `${baseUrl}/images/plano_mockup_2d1b.jpg`
      },
      */
      {
        name: 'Modelo 2D + 2B Mariposa',
        surface: '58,0 a 64,8 m²',
        bedrooms: '2 Suites Indep.',
        bathrooms: '2 Baños',
        terrace: 'Terraza continua',
        desc: 'Depto estilo mariposa ideal para inversionistas, con cocina integrada a living comedor, y dos habitaciones con privacidad, conectadas por terraza continua a lo ancho del departamento.',
        price: 'Desde 3.750 UF',
        tags: ['Más Vendido', 'Máxima Privacidad'],
        planImage: `${baseUrl}/images/plano_mockup_2d2b.jpg`
      }
      /*
      ,
      {
        name: 'Modelo 3D + 2B Familiar',
        surface: '70,5 a 76,2 m²',
        bedrooms: '3 Dormitorios',
        bathrooms: '2 Baños (1 Suite)',
        terrace: 'Amplia Terraza',
        desc: 'Espacios generosos para familias, suite con walk-in clóset, logia y amplia terraza para compartir.',
        price: 'Desde 4.490 UF',
        tags: ['Familiar', 'Terraza Amplia'],
        planImage: `${baseUrl}/images/plano_mockup_3d2b.jpg`
      }
      */
    ];

    const tuTabs = document.querySelectorAll<HTMLElement>('.tu-tab-btn');
    const tuImg = document.getElementById('tu-display-img') as HTMLImageElement | null;
    const tuTitle = document.getElementById('tu-item-title');
    const tuSurface = document.getElementById('tu-item-surface');
    const tuBeds = document.getElementById('tu-spec-beds');
    const tuBaths = document.getElementById('tu-spec-baths');
    const tuTerrace = document.getElementById('tu-spec-terrace');
    const tuDesc = document.getElementById('tu-item-desc');
    const tuPrice = document.getElementById('tu-item-price');

    tuTabs.forEach((tab) => {
      if (tab.dataset.bound) return;
      tab.dataset.bound = 'true';
      tab.addEventListener('click', () => {
        const index = parseInt(tab.getAttribute('data-tu-index') || '0', 10);
        const item = typologiesData[index];
        if (!item || !tuImg) return;

        tuTabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        tuImg.classList.add('fade');
        setTimeout(() => {
          tuImg.src = item.planImage;
          tuImg.alt = `Plano arquitectónico ${item.name}`;
          tuImg.classList.remove('fade');

          if (tuTitle) tuTitle.textContent = item.name;
          if (tuSurface) tuSurface.textContent = item.surface;
          if (tuBeds) tuBeds.textContent = item.bedrooms;
          if (tuBaths) tuBaths.textContent = item.bathrooms;
          if (tuTerrace) tuTerrace.textContent = item.terrace;
          if (tuDesc) tuDesc.textContent = item.desc;
          if (tuPrice) tuPrice.textContent = item.price;
        }, 160);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPageInteractions);
  } else {
    initPageInteractions();
  }
  document.addEventListener('astro:page-load', initPageInteractions);
</script>
