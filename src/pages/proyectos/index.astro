---
import { u } from '../../utils/url';

// Redirección inmediata al proyecto principal y único AMA Quillayes
return Astro.redirect(u('/proyectos/ama-quillayes'), 302);
---

<!DOCTYPE html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${u('/proyectos/ama-quillayes')}`} />
    <link rel="canonical" href={u('/proyectos/ama-quillayes')} />
    <script is:inline define:vars={{ targetUrl: u('/proyectos/ama-quillayes') }}>
      window.location.replace(targetUrl);
    </script>
    <title>Redirigiendo a AMA Quillayes | AMA Inmobiliaria</title>
  </head>
  <body>
    <p>Redirigiendo a <a href={u('/proyectos/ama-quillayes')}>AMA Quillayes</a>...</p>
  </body>
</html>
